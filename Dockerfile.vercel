# Imagem para a Vercel. Difere do Dockerfile comum em dois pontos:
# a Vercel encaminha o trafego do container para a porta 80, e o
# diagnostico do .NET e desligado por nao servir para nada aqui.
#
# O Program.cs le a variavel PORT e reconfigura a escuta.

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY LucasAguiar/LucasAguiar.csproj LucasAguiar/
RUN dotnet restore LucasAguiar/LucasAguiar.csproj

COPY LucasAguiar/ LucasAguiar/
RUN dotnet publish LucasAguiar/LucasAguiar.csproj -c Release --no-restore \
    -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app
COPY --from=build /app/publish ./

ENV PORT=80 DOTNET_EnableDiagnostics=0
EXPOSE 80

ENTRYPOINT ["dotnet", "LucasAguiar.dll"]
