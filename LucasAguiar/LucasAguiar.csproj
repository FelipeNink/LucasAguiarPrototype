<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>


  <ItemGroup>
    <!-- O esquema viaja dentro do assembly para o BancoInicializador
         poder cria-lo na primeira subida, inclusive no container, onde
         so existe o resultado do publish. -->
    <EmbeddedResource Include="Configs\banco_dados.sql" />
  </ItemGroup>
</Project>
