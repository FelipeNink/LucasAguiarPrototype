                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6" />
                            </svg>
                            Vendas
                        </NavLink>
                    </div>
                }

                @if (Pode("agendamentos"))
                {
                    <div class="nav-item">
                        <NavLink class="nav-link" href="agendamentos">
                            <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM16 2v4M8 2v4M3 10h18" />
                            </svg>
                            Agendamentos
                        </NavLink>
                    </div>
                }

                @if (Pode("caixa"))
                {
                    <div class="nav-item">
                        <NavLink class="nav-link" href="caixa">
                            <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
