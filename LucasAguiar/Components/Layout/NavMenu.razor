@* Rodape: quem esta usando o sistema, e as acoes de conta. *@
<div class="rodape-lateral">
    <span class="avatar-usuario" aria-hidden="true">@Iniciais</span>

    <div class="usuario-dados">
        <span class="usuario-nome">@NomeUsuario</span>
        @* Era "Administrador" escrito no HTML, para qualquer um que
           entrasse. Agora vem do acesso: a funcao da pessoa, se ela tiver
           uma, e senao o perfil. *@
        <span class="usuario-papel">@Papel</span>
    </div>

    <div class="acoes-conta">
    <a class="botao-conta" href="/conta" aria-label="Configurações da conta" title="Minha conta">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
            <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5v.2a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1h.2a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" />
        </svg>
    </a>

    <button type="button" class="botao-conta"
            aria-label="@(tema == "escuro" ? "Usar tema claro" : "Usar tema escuro")"
            @onclick='() => TrocarTema(tema == "escuro" ? "claro" : "escuro")'>
        @if (tema == "escuro")
        {
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10zM12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
            </svg>
        }
        else
        {
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
        }
    </button>

    <button type="button" class="botao-conta" aria-label="Sair do sistema" @onclick="AbrirConfirmacao">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" />
        </svg>
    </button>
    </div>
</div>

<ConfirmarModal Visivel="mostrarConfirmacao" Titulo="Sair do sistema" TextoConfirmar="Sair"
                OnConfirmar="ConfirmarSaida" OnCancelar="CancelarSaida">
    Tem certeza que deseja sair do sistema?
</ConfirmarModal>

@code {
    private bool mostrarConfirmacao = false;

    private string NomeUsuario => auth.GetUsuarioNome() ?? "Usuário";

    /// <summary>Ate duas iniciais do nome, para o avatar do rodape.</summary>
    private string Iniciais => auth.Iniciais;

    /// <summary>A funcao da pessoa, ou o perfil quando ela nao tem funcao.</summary>
    private string Papel => auth.GetFuncao() ?? Perfil.Rotulo(auth.GetPerfil());

    /// <summary>
    /// Carrega quem esta logado e o que ele pode. Precisa acontecer aqui,
    /// e nao numa propriedade: ler o estado de autenticacao e assincrono,
    /// e dentro do circuito nao existe HttpContext de onde tirar isso na
    /// hora.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await auth.PrepararAsync();
        await permissao.CarregarAsync();

        // Ao entrar, todas as secoes abertas; fechar e escolha de quem usa.
        abertos.UnionWith(Catalogo.Secoes);

        Navigation.LocationChanged += AoNavegar;
    }

    // ---------- grupos recolhiveis ----------

    /// <summary>Secoes abertas. Vive com o circuito: recarregar a pagina volta ao inicio.</summary>
    private readonly HashSet<string> abertos = new();

    private bool Aberto(string grupo) => abertos.Contains(grupo);

    private void Alternar(string grupo)
    {
        if (!abertos.Remove(grupo)) abertos.Add(grupo);
    }

    /// <summary>Secao da pagina aberta, pelas rotas do catalogo.</summary>
    private string? GrupoAtual
    {
        get
        {
            var caminho = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');

            return Catalogo.Telas
                .FirstOrDefault(t => t.Rotas.Any(r => r == "/"
                    ? caminho == "/"
                    : caminho.Equals(r, StringComparison.OrdinalIgnoreCase)
                      || caminho.StartsWith(r + "/", StringComparison.OrdinalIgnoreCase)))
                ?.Secao;
        }
    }

    /// <summary>Indo para outra secao, ela abre; as que estavam abertas continuam.</summary>
    private void AoNavegar(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var grupo = GrupoAtual;
        if (grupo == null || abertos.Contains(grupo)) return;

        abertos.Add(grupo);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Navigation.LocationChanged -= AoNavegar;

    /// <summary>
    /// O item aparece? Esconder o que a pessoa nao pode abrir evita o
    /// menu virar uma lista de portas trancadas -- mas quem protege de
    /// verdade e a guarda da pagina: isto aqui e so cortesia com quem
    /// esta olhando.
    /// </summary>
    private bool Pode(string tela) => permissao.PodeVer(tela);

    /// <summary>A secao so aparece se algum item dela aparecer.</summary>
    private bool AlgumaDe(params string[] telas) => telas.Any(Pode);

    /// <summary>
    /// Tema em exibicao. Comeca em "claro" so para o render estatico do
    /// servidor ter algo; o valor real vem do localStorage assim que o
    /// circuito liga, em OnAfterRenderAsync.
    /// </summary>
    private string tema = "claro";

    protected override async Task OnAfterRenderAsync(bool primeiraVez)
    {
        if (!primeiraVez) return;

        var salvo = await JS.InvokeAsync<string>("tema.ler");
        if (salvo != tema)
        {
            tema = salvo;
            StateHasChanged();
        }
    }

    private async Task TrocarTema(string novo)
    {
        if (novo == tema) return;

        tema = novo;
        await JS.InvokeVoidAsync("tema.aplicar", novo);
    }

    private void AbrirConfirmacao() => mostrarConfirmacao = true;

    private void CancelarSaida() => mostrarConfirmacao = false;

    private void ConfirmarSaida()
    {
        mostrarConfirmacao = false;
        // forceLoad garante uma requisicao HTTP real, onde a sessao pode ser limpa.
        Navigation.NavigateTo("/logout", forceLoad: true);
    }
}
