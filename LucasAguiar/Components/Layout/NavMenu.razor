@* Rodape: quem esta usando o sistema, e as duas acoes de conta. *@
<div class="rodape-lateral">
    <span class="avatar-usuario" aria-hidden="true">@Iniciais</span>

    <div class="usuario-dados">
        <span class="usuario-nome">@NomeUsuario</span>
        <span class="usuario-papel">Administrador</span>
    </div>

    <button type="button" class="botao-conta"
            aria-label="@(tema == "escuro" ? "Usar tema claro" : "Usar tema escuro")"
            @onclick='() => TrocarTema(tema == "escuro" ? "claro" : "escuro")'>
        @if (tema == "escuro")
        {
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10zM12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
            </svg>
        }
        else
        {
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
        }
    </button>

    <button type="button" class="botao-conta" aria-label="Sair do sistema" @onclick="AbrirConfirmacao">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" />
        </svg>
    </button>
</div>

<ConfirmarModal Visivel="mostrarConfirmacao" Titulo="Sair do sistema" TextoConfirmar="Sair"
                OnConfirmar="ConfirmarSaida" OnCancelar="CancelarSaida">
    Tem certeza que deseja sair do sistema?
</ConfirmarModal>

@code {
    private bool mostrarConfirmacao = false;

    private string NomeUsuario => auth.GetUsuarioNome() ?? "Usuário";

    /// <summary>Ate duas iniciais do nome, para o avatar do rodape.</summary>
    private string Iniciais
    {
        get
        {
            var partes = NomeUsuario
                .Split(' ', StringSplitOptions.RemoveEmptyEntries);

            if (partes.Length == 0) return "?";
            if (partes.Length == 1) return partes[0][..1].ToUpperInvariant();

            return (partes[0][..1] + partes[^1][..1]).ToUpperInvariant();
        }
    }

    /// <summary>
    /// Tema em exibicao. Comeca em "claro" so para o render estatico do
    /// servidor ter algo; o valor real vem do localStorage assim que o
    /// circuito liga, em OnAfterRenderAsync.
    /// </summary>
    private string tema = "claro";

    protected override async Task OnAfterRenderAsync(bool primeiraVez)
    {
        if (!primeiraVez) return;

        var salvo = await JS.InvokeAsync<string>("tema.ler");
        if (salvo != tema)
        {
            tema = salvo;
            StateHasChanged();
        }
    }

    private async Task TrocarTema(string novo)
    {
        if (novo == tema) return;

        tema = novo;
        await JS.InvokeVoidAsync("tema.aplicar", novo);
    }

    private void AbrirConfirmacao() => mostrarConfirmacao = true;

    private void CancelarSaida() => mostrarConfirmacao = false;

    private void ConfirmarSaida()
    {
        mostrarConfirmacao = false;
        // forceLoad garante uma requisicao HTTP real, onde a sessao pode ser limpa.
        Navigation.NavigateTo("/logout", forceLoad: true);
    }
}
