                    <span>Operação</span>
                    @if (!Aberto("Operação"))
                    {
                        @if (GrupoAtual == "Operação")
                        {
                            <i class="ponto-atual" title="A página aberta está aqui"></i>
                        }
                    }
                    <svg class="seta" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                </button>
                <div class="grupo-itens"><div class="grupo-conteudo">

                @if (Pode("painel"))
                {
                    <div class="nav-item">
                        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                            <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" />
                            </svg>
                            Painel
                        </NavLink>
                    </div>
                }

                @if (Pode("vendas"))
                {
                    <div class="nav-item">
                        <NavLink class="nav-link" href="vendas">
