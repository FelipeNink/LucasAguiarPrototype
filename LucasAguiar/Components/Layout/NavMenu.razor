@rendermode InteractiveServer
@using LucasAguiar.Configs
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AuthenticationService auth
@inject Autorizacao permissao
@implements IDisposable

<div class="sidebar-header">
    <Marca Variante="Marca.Tipo.Compacta" />
</div>
<input type="checkbox" title="Navigation menu" class="navbar-toggler" />


@* Acao principal do sistema, fixa e fora da area que rola: quem abre o
   sistema quase sempre vem para lancar uma venda. Os dois botoes so
   aparecem para quem pode criar venda e agendamento. *@
@if (permissao.Pode("vendas", Acao.Criar) || permissao.Pode("agendamentos", Acao.Criar))
{
    <div class="area-nova-venda">
        @if (permissao.Pode("vendas", Acao.Criar))
        {
            <NavLink class="botao-nova-venda" href="venda/nova">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" />
                </svg>
                <span>Nova venda</span>
                <kbd>F2</kbd>
            </NavLink>
        }

        @* Segunda acao mais comum. Fundo branco para nao disputar com a venda. *@
        @if (permissao.Pode("agendamentos", Acao.Criar))
        {
            <NavLink class="botao-novo-agendamento" href="agendamento/novo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM16 2v4M8 2v4M3 10h18M12 13v6M9 16h6" />
                </svg>
                <span>Novo agendamento</span>
                <kbd>F3</kbd>
            </NavLink>
        }
    </div>
}


<div class="nav-scrollable">
    <nav class="nav flex-column">

        @if (AlgumaDe("painel", "vendas", "agendamentos", "caixa"))
        {
            <div class="grupo @(Aberto("Operação") ? "aberto" : "")">
                <button type="button" class="grupo-rotulo" aria-expanded="@Aberto("Operação")"
