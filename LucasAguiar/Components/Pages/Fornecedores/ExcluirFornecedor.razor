@page "/fornecedores/{Id:int}/excluir"
@rendermode InteractiveServer

@inject FornecedorDAO fornecedorDAO
@inject NavigationManager Navigation

<TelaExclusao Entidade="fornecedor" Nome="@fornecedor?.NomeFornecedor" Voltar="/fornecedores"
              Encontrado="@(fornecedor != null)" Erro="@erro" OnConfirmar="Excluir" />

@code {
    [Parameter] public int Id { get; set; }

    private Fornecedor? fornecedor;
    private string? erro;

    protected override void OnInitialized()
    {
        try
        {
            fornecedor = fornecedorDAO.BuscarPorId(Id);
            if (fornecedor == null) erro = "Fornecedor não encontrado.";
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }

    private void Excluir()
    {
        try
        {
            fornecedorDAO.Excluir(Id);
            Navigation.NavigateTo("/fornecedores");
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }
}
