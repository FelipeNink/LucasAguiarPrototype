@* Formulario de fornecedor, o mesmo para criar e editar. *@

@using LucasAguiar.Configs
@using LucasAguiar.Models
@inject FornecedorDAO fornecedorDAO
@inject NavigationManager Navigation

<div class="form-pagina">
    <TopoForm Titulo="@(Novo ? "Novo fornecedor" : "Editar fornecedor")" Voltar="/fornecedores" RotuloVoltar="Fornecedores" />

    @if (erro != null)
    {
        <div class="alert alert-danger" role="alert">@erro</div>
    }

    <form @onsubmit="Salvar" novalidate>
        <section class="cartao secao-form">
            <h2>Dados do fornecedor</h2>
            <div class="grade-12">
                <Campo Rotulo="Tipo de pessoa" Colunas="3">
                    <Seletor TItem="Opcao" TValor="string" Itens="OpcoesTipoPessoa"
                             @bind-Valor="Modelo.TipoPessoa" TextoDe="o => o.Rotulo" ValorDe="o => o.Valor" />
                </Campo>
                <Campo Rotulo="@(PessoaFisica ? "Nome" : "Razão social")" Para="frn-nome" Colunas="9" Obrigatorio="true"
                       Erro="@(tentouSalvar && string.IsNullOrWhiteSpace(Modelo.NomeFornecedor) ? "Informe o nome." : null)">
                    <input id="frn-nome" class="form-control" maxlength="200" @bind="Modelo.NomeFornecedor" />
                </Campo>
                <Campo Rotulo="Nome fantasia" Para="frn-fantasia" Colunas="5">
                    <input id="frn-fantasia" class="form-control" maxlength="200" @bind="Modelo.NomeFantasia" />
                </Campo>
                <Campo Rotulo="@(PessoaFisica ? "CPF" : "CNPJ")" Para="frn-doc" Colunas="4" Erro="@ErroDocumento">
                    <input id="frn-doc" class="form-control" inputmode="numeric" data-mascara="cpfcnpj"
                           placeholder="@(PessoaFisica ? "000.000.000-00" : "00.000.000/0000-00")" @bind="Modelo.Documento" />
                </Campo>
                <Campo Rotulo="Situação" Para="frn-ativo" Colunas="3">
                    <div class="form-check form-switch campo-switch">
                        <input id="frn-ativo" class="form-check-input" type="checkbox" role="switch" @bind="Modelo.Ativo" />
                        <label class="form-check-label" for="frn-ativo">@(Modelo.Ativo ? "Ativo" : "Inativo")</label>
                    </div>
                </Campo>
            </div>
        </section>

        <section class="cartao secao-form">
            <h2>Contato</h2>
            <div class="grade-12">
                <Campo Rotulo="Pessoa de contato" Para="frn-contato" Colunas="4">
                    <input id="frn-contato" class="form-control" maxlength="100" @bind="Modelo.Contato" />
                </Campo>
                <Campo Rotulo="Telefone" Para="frn-tel" Colunas="3" Erro="@Documentos.ErroTelefone(Modelo.Telefone)">
                    <input id="frn-tel" class="form-control" inputmode="tel" data-mascara="telefone"
                           placeholder="(69) 99999-9999" @bind="Modelo.Telefone" />
                </Campo>
                <Campo Rotulo="E-mail" Para="frn-email" Colunas="5" Erro="@Documentos.ErroEmail(Modelo.Email)">
                    <input id="frn-email" type="email" class="form-control" maxlength="200"
                           placeholder="contato@fornecedor.com.br" @bind="Modelo.Email" />
                </Campo>
            </div>
        </section>

        <CamposEndereco Modelo="Modelo" Prefixo="frn" />

        <section class="cartao secao-form">
            <h2>Observações</h2>
            <div class="grade-12">
                <Campo Rotulo="O que fornece" Para="frn-tipo" Colunas="12">
                    <textarea id="frn-tipo" class="form-control" rows="2" maxlength="300"
                              placeholder="Ex.: pomadas, lâminas, toalhas" @bind="Modelo.TipoProd"></textarea>
                </Campo>
                <Campo Rotulo="Observações" Para="frn-obs" Colunas="12">
                    <textarea id="frn-obs" class="form-control" rows="3" maxlength="500"
                              placeholder="Ex.: prazo de entrega de 5 dias, pedido mínimo R$ 300" @bind="Modelo.Observacoes"></textarea>
                </Campo>
            </div>
        </section>

        <RodapeForm Cancelar="/fornecedores" Salvando="salvando" />
    </form>
</div>

@code {
    [Parameter, EditorRequired] public Fornecedor Modelo { get; set; } = new();
    [Parameter] public bool Novo { get; set; }

    private string? erro;
    private bool tentouSalvar;
    private bool salvando;

    private static readonly List<Opcao> OpcoesTipoPessoa = new()
    {
        new("PJ", "Jurídica (CNPJ)"),
        new("PF", "Física (CPF)")
    };

    private bool PessoaFisica => Modelo.TipoPessoa == "PF";

    /// <summary>O documento tem de bater com o tipo de pessoa escolhido.</summary>
    private string? ErroDocumento =>
        string.IsNullOrWhiteSpace(Modelo.Documento)
            ? null
            : PessoaFisica ? Documentos.ErroCpf(Modelo.Documento) : Documentos.ErroCnpj(Modelo.Documento);

    private void Salvar()
    {
        tentouSalvar = true;
        erro = null;

        var temErro =
            string.IsNullOrWhiteSpace(Modelo.NomeFornecedor)
            || ErroDocumento != null
            || Documentos.ErroTelefone(Modelo.Telefone) != null
            || Documentos.ErroEmail(Modelo.Email) != null
            || Documentos.ErroCep(Modelo.Cep) != null;

        if (temErro)
        {
            erro = "Confira os campos destacados.";
            return;
        }

        try
        {
            salvando = true;

            Modelo.NomeFornecedor = Modelo.NomeFornecedor!.Trim();
            Modelo.Documento = Vazio(Documentos.FormatarCpfCnpj(Modelo.Documento));
            Modelo.Telefone = Vazio(Documentos.FormatarTelefone(Modelo.Telefone));
            Modelo.Email = Vazio(Modelo.Email);
            Modelo.TipoProd = Vazio(Modelo.TipoProd);
            Modelo.Cep = Vazio(Documentos.FormatarCep(Modelo.Cep));

            if (Novo) fornecedorDAO.Inserir(Modelo);
            else fornecedorDAO.Atualizar(Modelo);

            Navigation.NavigateTo("/fornecedores");
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
        finally
        {
            salvando = false;
        }
    }

    private static string? Vazio(string? texto) =>
        string.IsNullOrWhiteSpace(texto) ? null : texto.Trim();
}
