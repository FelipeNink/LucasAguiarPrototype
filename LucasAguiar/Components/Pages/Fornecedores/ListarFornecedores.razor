@page "/fornecedores"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Politicas.Fornecedores)]

@using LucasAguiar.Configs
@using LucasAguiar.Models
@inject FornecedorDAO fornecedorDAO
@inject NavigationManager Navigation


<AbasGrupo Abas="AbasGrupo.Estoque" />

<h1 class="titulo-listagem">Gestão de Fornecedores</h1>

<div class="barra-acoes barra-listagem">
    <BotaoExportar Href="/relatorio/fornecedores" />
    <NavLink href="/fornecedores/novo" class="btn-novo btn-cadastrar">Cadastrar fornecedor</NavLink>
</div>

@* ---------- filtros ---------- *@
<section class="filtros">
    <div class="campo campo-largo">
        <label>Nome ou CPF/CNPJ</label>
        <input class="form-control" placeholder="Buscar fornecedor" @bind="busca" @bind:event="oninput" />
    </div>
    <div class="campo">
        <label>Situação</label>
        <Seletor TItem="Opcao" TValor="string" Itens="OpcoesSituacao"
                 @bind-Valor="situacao" TextoDe="o => o.Rotulo" ValorDe="o => o.Valor"
                 PontoDe="o => o.Cor" />
    </div>
    <div class="campo-acoes">
        <button type="button" class="btn btn-outline-secondary" @onclick="Limpar">Limpar</button>
    </div>
</section>

<div class="tabela fixa">
    <table class="table table-striped">
    <thead>
        <tr>
            <th>Nome fantasia</th>
            <th class="opcional">Razão social</th>
            <th class="opcional">CPF/CNPJ</th>
            <th>Telefone</th>
            <th class="opcional">Contato</th>
            <th class="opcional">Última compra</th>
            <th class="col-acoes">Ações</th>
        </tr>
    </thead>
    <tbody>
        @if (Filtrados.Any())
        {
            foreach (var fornecedor in Filtrados)
            {
                <tr>
                    <td>
                        @* PF ou PJ sem fantasia: o nome cadastrado faz as vezes. *@
                        @(string.IsNullOrWhiteSpace(fornecedor.NomeFantasia) ? fornecedor.NomeFornecedor : fornecedor.NomeFantasia)
                        @if (!fornecedor.Ativo)
                        {
                            <span class="status cancelada"><i></i>inativo</span>
                        }
                    </td>
                    <td class="opcional">@Valor(fornecedor.NomeFornecedor)</td>
                    <td class="opcional">@Valor(fornecedor.Documento)</td>
                    <td>@Valor(fornecedor.Telefone)</td>
                    <td class="opcional">@Valor(fornecedor.Contato)</td>
                    <td class="opcional"><span class="data">@Valor(fornecedor.UltimaCompra?.ToString("dd/MM/yyyy"))</span></td>
                    <td class="col-acoes">
                        <AcoesLinha OnVisualizar="() => visualizando = fornecedor"
                                    OnEditar="() => Editar(fornecedor)"
                                    OnExcluir="() => excluindo = fornecedor" />
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center text-muted">Nenhum fornecedor encontrado.</td>
            </tr>
        }
    </tbody>
    </table>
</div>

<ConfirmarModal Visivel="@(excluindo != null)" Titulo="Excluir fornecedor" Erro="@erroExclusao"
                OnConfirmar="ConfirmarExclusao" OnCancelar="CancelarExclusao">
    Tem certeza que deseja excluir <strong>@excluindo?.NomeFornecedor</strong>?<br />
    <span class="text-muted">Esta ação não pode ser desfeita.</span>
</ConfirmarModal>

<Janela Visivel="@(visualizando != null)" Titulo="@(visualizando?.NomeFornecedor ?? "Fornecedor")"
        OnFechar="Fechar">
    <ChildContent>
        @if (visualizando != null)
        {
            <dl class="ficha">
                <div><dt>@(visualizando.TipoPessoa == "PF" ? "CPF" : "CNPJ")</dt><dd>@Valor(visualizando.Documento)</dd></div>
                <div><dt>Nome fantasia</dt><dd>@Valor(visualizando.NomeFantasia)</dd></div>
                <div><dt>Contato</dt><dd>@Valor(visualizando.Contato)</dd></div>
                <div><dt>Telefone</dt><dd>@Valor(visualizando.Telefone)</dd></div>
                <div><dt>Email</dt><dd>@Valor(visualizando.Email)</dd></div>
                <div><dt>Situação</dt><dd>@(visualizando.Ativo ? "Ativo" : "Inativo")</dd></div>
                <div class="largo">
                    <dt>Endereço</dt>
                    <dd>@Valor(string.Join(", ", new[] { visualizando.Rua, visualizando.Numero, visualizando.Bairro, visualizando.Cidade, visualizando.Estado }.Where(p => !string.IsNullOrWhiteSpace(p))))</dd>
                </div>
                <div class="largo"><dt>Tipo de produto</dt><dd>@Valor(visualizando.TipoProd)</dd></div>
                <div class="largo"><dt>Observações</dt><dd>@Valor(visualizando.Observacoes)</dd></div>
            </dl>
        }
    </ChildContent>
    <Rodape>
        <button type="button" class="btn btn-outline-secondary" @onclick="Fechar">Fechar</button>
        <button type="button" class="btn btn-primary" @onclick="() => Editar(visualizando!)">Editar</button>
    </Rodape>
</Janela>

@code {
    private Fornecedor? excluindo;
    private string? erroExclusao;

    private void ConfirmarExclusao()
    {
        if (excluindo == null) return;

        try
        {
            fornecedorDAO.Excluir(excluindo.IdFornecedor);
            excluindo = null;
            erroExclusao = null;
            CarregarFornecedores();
        }
        catch (Exception ex)
        {
            erroExclusao = ex.Message;
        }
    }

    private void CancelarExclusao()
    {
        excluindo = null;
        erroExclusao = null;
    }

    private List<Fornecedor> listaFornecedores = new();

    private Fornecedor? visualizando;

    private string busca = "";
    private string situacao = "";

    private List<Fornecedor> Filtrados
    {
        get
        {
            var termo = busca.Trim();
            var digitos = new string(termo.Where(char.IsDigit).ToArray());

            return listaFornecedores
                .Where(f => termo == ""
                            || (f.NomeFornecedor ?? "").Contains(termo, StringComparison.OrdinalIgnoreCase)
                            || (f.NomeFantasia ?? "").Contains(termo, StringComparison.OrdinalIgnoreCase)
                            // Documento pode estar gravado com ou sem pontuacao.
                            || (digitos.Length >= 3
                                && new string((f.Documento ?? "").Where(char.IsDigit).ToArray()).Contains(digitos)))
                .Where(f => situacao == "" || f.Ativo == (situacao == "ATIVO"))
                .ToList();
        }
    }

    private static readonly List<Opcao> OpcoesSituacao = new()
    {
        new("", "Todos"),
        new("ATIVO", "Ativos", "var(--ok)"),
        new("INATIVO", "Inativos", "var(--texto-fraco)")
    };

    private void Limpar()
    {
        busca = "";
        situacao = "";
    }

    private void CarregarFornecedores()
    {
        listaFornecedores = fornecedorDAO.ListarComUltimaCompra();
    }

    protected override void OnInitialized()
    {
        CarregarFornecedores();
    }

    private static string Valor(string? texto) =>
        string.IsNullOrWhiteSpace(texto) ? "—" : texto;

    /// <summary>A edicao e uma pagina propria, com o mesmo formulario do cadastro.</summary>
    private void Editar(Fornecedor f) => Navigation.NavigateTo($"/fornecedores/{f.IdFornecedor}");

    private void Fechar() => visualizando = null;

}
