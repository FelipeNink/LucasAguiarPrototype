@page "/fornecedores"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Politicas.Fornecedores)]

@using LucasAguiar.Configs
@using LucasAguiar.Models
@inject FornecedorDAO fornecedorDAO


<h1>Lista de Fornecedores</h1>

<div class="barra-acoes">
    <NavLink href="/fornecedores/novo" class="btn-novo">Novo Fornecedor</NavLink>
    <a href="/relatorio/fornecedores" class="btn-pdf" data-enhance-nav="false">Relatório PDF</a>
</div>

<div class="tabela fixa">
    <table class="table table-striped">
    <thead>
        <tr>
            <th class="col-id">#</th>
            <th>Nome</th>
            <th class="opcional">Email</th>
            <th>Telefone</th>
            <th class="opcional">Tipo de Produto</th>
            <th class="col-acoes">Ações</th>
        </tr>
    </thead>
    <tbody>
        @if (listaFornecedores != null && listaFornecedores.Any())
        {
            int contador = 1;
            foreach (var fornecedor in listaFornecedores)
            {
                <tr>
                    <td>@contador</td>
                    <td>@fornecedor.NomeFornecedor</td>
                    <td class="opcional">@fornecedor.Email</td>
                    <td>@fornecedor.Telefone</td>
                    <td class="opcional">@fornecedor.TipoProd</td>
                    <td class="col-acoes">
                        <AcoesLinha OnVisualizar="() => visualizando = fornecedor"
                                    OnEditar="() => Editar(fornecedor)"
                                    OnExcluir="() => excluindo = fornecedor" />
                    </td>
                </tr>
                contador++;
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Nenhum fornecedor encontrado.</td>
            </tr>
        }
    </tbody>
    </table>
</div>

<ConfirmarModal Visivel="@(excluindo != null)" Titulo="Excluir fornecedor" Erro="@erroExclusao"
                OnConfirmar="ConfirmarExclusao" OnCancelar="CancelarExclusao">
    Tem certeza que deseja excluir <strong>@excluindo?.NomeFornecedor</strong>?<br />
    <span class="text-muted">Esta ação não pode ser desfeita.</span>
</ConfirmarModal>

<Janela Visivel="@(visualizando != null)" Titulo="@(visualizando?.NomeFornecedor ?? "Fornecedor")"
        OnFechar="Fechar">
    <ChildContent>
        @if (visualizando != null)
        {
            <dl class="ficha">
                <div><dt>Telefone</dt><dd>@Valor(visualizando.Telefone)</dd></div>
                <div><dt>Email</dt><dd>@Valor(visualizando.Email)</dd></div>
                <div class="largo"><dt>Tipo de produto</dt><dd>@Valor(visualizando.TipoProd)</dd></div>
            </dl>
        }
    </ChildContent>
    <Rodape>
        <button type="button" class="btn btn-outline-secondary" @onclick="Fechar">Fechar</button>
        <button type="button" class="btn btn-primary" @onclick="() => Editar(visualizando!)">Editar</button>
    </Rodape>
</Janela>

<Janela Visivel="@(editando != null)" Titulo="Editar fornecedor" Erro="@erroModal" OnFechar="Fechar">
    <ChildContent>
        @if (editando != null)
        {
            <div class="grade-campos">
                <div class="largo">
                    <label class="form-label">Nome</label>
                    <input class="form-control" @bind="editando.NomeFornecedor" />
                </div>
                <div>
                    <label class="form-label">Email</label>
                    <input class="form-control" @bind="editando.Email" />
                </div>
                <div>
                    <label class="form-label">Telefone</label>
                    <input class="form-control" @bind="editando.Telefone" />
                </div>
                <div class="largo">
                    <label class="form-label">Tipo de produto</label>
                    <textarea class="form-control" rows="4" @bind="editando.TipoProd"></textarea>
                </div>
            </div>
        }
    </ChildContent>
    <Rodape>
        <button type="button" class="btn btn-outline-secondary" @onclick="Fechar">Cancelar</button>
        <button type="button" class="btn btn-primary" @onclick="Salvar">Salvar</button>
    </Rodape>
</Janela>

@code {
    private Fornecedor? excluindo;
    private string? erroExclusao;

    private void ConfirmarExclusao()
    {
        if (excluindo == null) return;

        try
        {
            fornecedorDAO.Excluir(excluindo.IdFornecedor);
            excluindo = null;
            erroExclusao = null;
            CarregarFornecedores();
        }
        catch (Exception ex)
        {
            erroExclusao = ex.Message;
        }
    }

    private void CancelarExclusao()
    {
        excluindo = null;
        erroExclusao = null;
    }

    private List<Fornecedor> listaFornecedores = new();

    private Fornecedor? visualizando;
    private Fornecedor? editando;
    private string? erroModal;

    private void CarregarFornecedores()
    {
        listaFornecedores = fornecedorDAO.ListarTodos();
    }

    protected override void OnInitialized()
    {
        CarregarFornecedores();
    }

    private static string Valor(string? texto) =>
        string.IsNullOrWhiteSpace(texto) ? "—" : texto;

    /// <summary>Edita uma copia: cancelar o modal nao pode alterar a linha da tabela.</summary>
    private void Editar(Fornecedor f)
    {
        visualizando = null;
        erroModal = null;
        editando = new Fornecedor
        {
            IdFornecedor = f.IdFornecedor,
            NomeFornecedor = f.NomeFornecedor,
            Email = f.Email,
            Telefone = f.Telefone,
            TipoProd = f.TipoProd
        };
    }

    private void Fechar()
    {
        visualizando = null;
        editando = null;
        erroModal = null;
    }

    private void Salvar()
    {
        if (editando == null) return;

        try
        {
            if (string.IsNullOrWhiteSpace(editando.NomeFornecedor))
                throw new Exception("O campo nome é obrigatório");

            fornecedorDAO.Atualizar(editando);
            Fechar();
            CarregarFornecedores();
        }
        catch (Exception ex)
        {
            erroModal = ex.Message;
        }
    }
}
