@page "/plano"
@rendermode InteractiveServer

@using LucasAguiar.Models
@using LucasAguiar.Configs
@inject PlanoDAO planoDAO


<h1>Lista de plano</h1>

<div class="barra-acoes">
    <NavLink href="/plano/novo" class="btn-novo">Novo plano</NavLink>
    <a href="/relatorio/planos" class="btn-pdf" data-enhance-nav="false">Relatório PDF</a>
</div>

<div class="tabela fixa">
    <table class="table table-striped">
    <thead>
        <tr>
            <th class="col-id">#</th>
            <th>Nome</th>
            <th class="opcional">Descrição</th>
            <th class="opcional">Inclui</th>
            <th>Valor</th>
            <th class="col-acoes quatro"></th>
        </tr>
    </thead>
    <tbody>
        @if (listaPlano != null && listaPlano.Any())
        {
            int contador = 1;
            foreach (var plano in listaPlano)
            {
                <tr>
                    <td>@contador</td>
                    <td>@plano.NomePlano</td>
                    <td class="opcional">@plano.Descricao</td>
                    <td class="opcional">
                        @if (plano.TotalItens > 0)
                        {
                            <span>@plano.TotalItens item(ns)</span>
                        }
                        else
                        {
                            <span class="text-muted">sem itens</span>
                        }
                    </td>
                    <td>@((plano.Valor ?? 0).ToString("C"))</td>
                    <td class="col-acoes">
                        <AcoesLinha OnVisualizar="() => Visualizar(plano)"
                                    OnEditar="() => Editar(plano)"
                                    HrefExcluir="@($"/plano/{plano.IdPlano}/excluir")">
                            <a href="/plano/@plano.IdPlano/componentes" class="btn-acao"
                               title="Componentes" aria-label="Componentes">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 3l9 5-9 5-9-5zM3 13l9 5 9-5" />
                                </svg>
                            </a>
                        </AcoesLinha>
                    </td>
                </tr>
                contador++;
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Nenhum plano encontrado.</td>
            </tr>
        }
    </tbody>
    </table>
</div>

<Janela Visivel="@(visualizando != null)" Titulo="@(visualizando?.NomePlano ?? "Plano")"
        OnFechar="Fechar">
    <ChildContent>
        @if (visualizando != null)
        {
            <dl class="ficha">
                <div><dt>Valor mensal</dt><dd>@((visualizando.Valor ?? 0).ToString("C"))</dd></div>
                <div><dt>Itens</dt><dd>@visualizando.TotalItens</dd></div>
                <div class="largo">
                    <dt>Descrição</dt>
                    <dd>@(string.IsNullOrWhiteSpace(visualizando.Descricao) ? "—" : visualizando.Descricao)</dd>
                </div>
                <div class="largo">
                    <dt>O que inclui</dt>
                    <dd>
                        @if (itensVisualizados.Count == 0)
                        {
                            <span class="text-muted">Nenhum item.</span>
                        }
                        else
                        {
                            @foreach (var item in itensVisualizados)
                            {
                                <div>@item.Quantidade× @item.Descricao <span class="text-muted">(@item.RotuloTipo)</span></div>
                            }
                        }
                    </dd>
                </div>
            </dl>
        }
    </ChildContent>
    <Rodape>
        <button type="button" class="btn btn-outline-secondary" @onclick="Fechar">Fechar</button>
        <a href="/plano/@visualizando?.IdPlano/componentes" class="btn btn-outline-secondary">Componentes</a>
        <button type="button" class="btn btn-primary" @onclick="() => Editar(visualizando!)">Editar</button>
    </Rodape>
</Janela>

<Janela Visivel="@(editando != null)" Titulo="Editar plano" Erro="@erroModal" OnFechar="Fechar">
    <ChildContent>
        @if (editando != null)
        {
            <div class="grade-campos">
                <div class="largo">
                    <label class="form-label">Nome</label>
                    <input class="form-control" @bind="editando.NomePlano" />
                </div>
                <div class="largo">
                    <label class="form-label">Descrição</label>
                    <input class="form-control" @bind="editando.Descricao" />
                </div>
                <div>
                    <label class="form-label">Valor mensal</label>
                    <input type="number" step="0.01" min="0" class="form-control" @bind="editando.Valor" />
                </div>
            </div>
            <p class="text-muted mb-0" style="font-size: 13px;">
                Os itens do plano são alterados em Componentes.
            </p>
        }
    </ChildContent>
    <Rodape>
        <button type="button" class="btn btn-outline-secondary" @onclick="Fechar">Cancelar</button>
        <button type="button" class="btn btn-primary" @onclick="Salvar">Salvar</button>
    </Rodape>
</Janela>

@code {
    private List<Plano> listaPlano = new();

    private Plano? visualizando;
    private List<PlanoItem> itensVisualizados = new();
    private Plano? editando;
    private string? erroModal;

    protected override void OnInitialized()
    {
        listaPlano = planoDAO.ListarTodos();
    }

    private void Visualizar(Plano p)
    {
        editando = null;
        visualizando = p;

        try { itensVisualizados = planoDAO.ListarItens(p.IdPlano); }
        catch { itensVisualizados = new(); }
    }

    /// <summary>Edita uma copia: cancelar o modal nao pode alterar a linha da tabela.</summary>
    private void Editar(Plano p)
    {
        visualizando = null;
        erroModal = null;
        editando = new Plano
        {
            IdPlano = p.IdPlano,
            NomePlano = p.NomePlano,
            Descricao = p.Descricao,
            Valor = p.Valor
        };
    }

    private void Fechar()
    {
        visualizando = null;
        editando = null;
        erroModal = null;
    }

    private void Salvar()
    {
        if (editando == null) return;

        try
        {
            if (string.IsNullOrWhiteSpace(editando.NomePlano))
                throw new Exception("O nome do plano é obrigatório.");

            if (editando.Valor is not > 0)
                throw new Exception("Informe o valor mensal do plano.");

            planoDAO.Atualizar(editando);
            Fechar();
            listaPlano = planoDAO.ListarTodos();
        }
        catch (Exception ex)
        {
            erroModal = ex.Message;
        }
    }
}
