@page "/plano/{Id:int}/excluir"
@rendermode InteractiveServer

@inject PlanoDAO planoDAO
@inject NavigationManager Navigation

<TelaExclusao Entidade="plano" Nome="@plano?.NomePlano" Voltar="/plano"
              Aviso="Os componentes do plano serão excluídos junto."
              Encontrado="@(plano != null)" Erro="@erro" OnConfirmar="Excluir" />

@code {
    [Parameter] public int Id { get; set; }

    private Plano? plano;
    private string? erro;

    protected override void OnInitialized()
    {
        try
        {
            plano = planoDAO.BuscarPorId(Id);
            if (plano == null) erro = "Plano não encontrado.";
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }

    private void Excluir()
    {
        try
        {
            planoDAO.Excluir(Id);
            Navigation.NavigateTo("/plano");
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }
}
