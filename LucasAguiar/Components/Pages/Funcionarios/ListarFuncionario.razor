@page "/funcionario"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Politicas.Funcionarios)]

@using LucasAguiar.Models
@using LucasAguiar.Configs
@inject FuncionarioDAO funcionarioDAO
@inject NavigationManager Navigation


<h1 class="titulo-listagem">Gestão de Funcionários</h1>

<div class="barra-acoes barra-listagem">
    <BotaoExportar Href="/relatorio/funcionarios" />
    <NavLink href="/funcionario/novo" class="btn-novo btn-cadastrar">Cadastrar funcionário</NavLink>
</div>

@* ---------- filtros ---------- *@
<section class="filtros">
    <div class="campo campo-largo">
        <label>Nome ou CPF</label>
        <input class="form-control" placeholder="Buscar funcionário" @bind="busca" @bind:event="oninput" />
    </div>
    <div class="campo-acoes">
        <button type="button" class="btn btn-outline-secondary" @onclick="() => busca = string.Empty">Limpar</button>
    </div>
</section>

<div class="tabela fixa">
    <table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Telefone</th>
            <th class="al-dir">Salário fixo</th>
            <th class="col-acoes">Ações</th>
        </tr>
    </thead>
    <tbody>
        @if (Filtrados.Any())
        {
            foreach (var funcionario in Filtrados)
            {
                <tr>
                    <td>@funcionario.NomeFuncionario</td>
                    <td>@Valor(funcionario.Telefone)</td>
                    <td class="al-dir">@funcionario.SalarioFixo.ToString("C")</td>
                    <td class="col-acoes">
                        <AcoesLinha OnVisualizar="() => visualizando = funcionario"
                                    OnEditar="() => Editar(funcionario)"
                                    OnExcluir="() => excluindo = funcionario" />
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted">Nenhum funcionário encontrado.</td>
            </tr>
        }
    </tbody>
    </table>
</div>

<ConfirmarModal Visivel="@(excluindo != null)" Titulo="Excluir funcionário" Erro="@erroExclusao"
                OnConfirmar="ConfirmarExclusao" OnCancelar="CancelarExclusao">
    Tem certeza que deseja excluir <strong>@excluindo?.NomeFuncionario</strong>?<br />
    <span class="text-muted">Esta ação não pode ser desfeita.</span>
</ConfirmarModal>

<Janela Visivel="@(visualizando != null)" Titulo="@(visualizando?.NomeFuncionario ?? "Funcionário")"
        OnFechar="Fechar">
    <ChildContent>
        @if (visualizando != null)
        {
            <dl class="ficha">
                <div><dt>Telefone</dt><dd>@Valor(visualizando.Telefone)</dd></div>
                <div><dt>Email</dt><dd>@Valor(visualizando.Email)</dd></div>
                <div><dt>CPF</dt><dd>@Valor(visualizando.CPF)</dd></div>
                <div><dt>RG</dt><dd>@Valor(visualizando.RG)</dd></div>
                <div><dt>CTPS</dt><dd>@Valor(visualizando.CTPS)</dd></div>
                <div><dt>Nascimento</dt><dd>@Valor(visualizando.DataNascimento?.ToString("dd/MM/yyyy"))</dd></div>
                <div><dt>Salário fixo</dt><dd>@visualizando.SalarioFixo.ToString("C")</dd></div>
                <div class="largo">
                    <dt>Endereço</dt>
                    <dd>@Valor(string.Join(", ", new[] { visualizando.Rua, visualizando.Numero, visualizando.Bairro, visualizando.Cidade, visualizando.Estado }.Where(p => !string.IsNullOrWhiteSpace(p))))</dd>
                </div>
            </dl>
        }
    </ChildContent>
    <Rodape>
        <button type="button" class="btn btn-outline-secondary" @onclick="Fechar">Fechar</button>
        <button type="button" class="btn btn-primary" @onclick="() => Editar(visualizando!)">Editar</button>
    </Rodape>
</Janela>

@code {
    private Funcionario? excluindo;
    private string? erroExclusao;

    private void ConfirmarExclusao()
    {
        if (excluindo == null) return;

        try
        {
            funcionarioDAO.Excluir(excluindo.IdFuncionario);
            excluindo = null;
            erroExclusao = null;
            listaFuncionarios = funcionarioDAO.ListarTodos();
        }
        catch (Exception ex)
        {
            erroExclusao = ex.Message;
        }
    }

    private void CancelarExclusao()
    {
        excluindo = null;
        erroExclusao = null;
    }

    private List<Funcionario> listaFuncionarios = new();

    private Funcionario? visualizando;

    private string busca = "";

    private List<Funcionario> Filtrados
    {
        get
        {
            var termo = busca.Trim();
            var digitos = new string(termo.Where(char.IsDigit).ToArray());

            return listaFuncionarios
                .Where(f => termo == ""
                            || (f.NomeFuncionario ?? "").Contains(termo, StringComparison.OrdinalIgnoreCase)
                            || (digitos.Length >= 3
                                && new string((f.CPF ?? "").Where(char.IsDigit).ToArray()).Contains(digitos)))
                .ToList();
        }
    }

    protected override void OnInitialized()
    {
        listaFuncionarios = funcionarioDAO.ListarTodos();
    }

    private static string Valor(string? texto) =>
        string.IsNullOrWhiteSpace(texto) ? "—" : texto;

    /// <summary>A edicao e uma pagina propria, com o mesmo formulario do cadastro.</summary>
    private void Editar(Funcionario f) => Navigation.NavigateTo($"/funcionario/{f.IdFuncionario}");

    private void Fechar() => visualizando = null;

}
