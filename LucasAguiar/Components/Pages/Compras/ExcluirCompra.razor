@page "/compra/{Id:int}/excluir"
@rendermode InteractiveServer

@inject CompraDAO compraDAO
@inject NavigationManager Navigation

<TelaExclusao Entidade="compra" Nome="@Descricao" Voltar="/compra"
              Aviso="A entrada no estoque será estornada e a despesa lançada por esta compra será excluída."
              Encontrado="@(compra != null)" Erro="@erro" OnConfirmar="Excluir" />

@code {
    [Parameter] public int Id { get; set; }

    private Compra? compra;
    private string? erro;

    private string? Descricao => compra == null
        ? null
        : $"{compra.ItemCompra} — {compra.ValorCompra:C} em {compra.DataCompra:dd/MM/yyyy}";

    protected override void OnInitialized()
    {
        try
        {
            compra = compraDAO.BuscarPorId(Id);
            if (compra == null) erro = "Compra não encontrada.";
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }

    private void Excluir()
    {
        try
        {
            compraDAO.Excluir(Id);
            Navigation.NavigateTo("/compra");
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }
}
