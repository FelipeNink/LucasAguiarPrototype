@page "/compra"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Politicas.Compras)]

@using LucasAguiar.Configs
@using LucasAguiar.Models
@inject CompraDAO compraDAO
@inject ProdutoDAO produtoDAO
@inject FornecedorDAO fornecedorDAO
@inject FuncionarioDAO funcionarioDAO
@inject NavigationManager Navigation
@inject LucasAguiar.Services.AuthenticationService auth


<h1 class="titulo-listagem">Gestão de Compras</h1>

<div class="barra-acoes barra-listagem">
    <BotaoExportar Href="/relatorio/compras" />
    <BotaoExportar Tipo="BotaoExportar.Formato.Excel" Href="/excel/compras" />
    <NavLink href="/compra/novo" class="btn-novo btn-cadastrar">Cadastrar compra</NavLink>
</div>

@* ---------- filtros ---------- *@
<section class="filtros">
    <div class="campo">
        <label>De</label>
        <input type="date" class="form-control" @bind="de" />
    </div>
    <div class="campo">
        <label>Até</label>
        <input type="date" class="form-control" @bind="ate" />
    </div>
    <div class="campo">
        <label>Fornecedor</label>
        <Seletor TItem="OpcaoId" TValor="int" Itens="OpcoesFiltroFornecedor"
                 @bind-Valor="filtroFornecedor" TextoDe="o => o.Rotulo" ValorDe="o => o.Id" />
    </div>
    <div class="campo">
        <label>Nº da nota</label>
        <input class="form-control" placeholder="Número" @bind="filtroNota" @bind:event="oninput" />
    </div>
    <div class="campo">
        <label>Produto</label>
        <Seletor TItem="OpcaoId" TValor="int" Itens="OpcoesFiltroProduto"
                 @bind-Valor="filtroProduto" TextoDe="o => o.Rotulo" ValorDe="o => o.Id" />
    </div>
    <div class="campo">
        <label>Pagamento</label>
        <Seletor TItem="Opcao" TValor="string" Itens="OpcoesSituacao"
                 @bind-Valor="filtroSituacao" TextoDe="o => o.Rotulo" ValorDe="o => o.Valor"
                 PontoDe="o => o.Cor" />
    </div>
    <div class="campo-acoes">
        <button type="button" class="btn btn-primary" @onclick="CarregarCompras">Filtrar</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="Limpar">Limpar</button>
    </div>
</section>

<div class="atalhos-periodo mb-3">
    <button type="button" @onclick="() => Periodo(0)">Hoje</button>
    <button type="button" @onclick="() => Periodo(7)">Últimos 7 dias</button>
    <button type="button" @onclick="() => Periodo(30)">Últimos 30 dias</button>
    <button type="button" @onclick="PeriodoMes">Este mês</button>
</div>

@* ---------- resumo ---------- *@
<div class="resumo">
    <div class="cartao-resumo">
        <span class="rotulo">Compras</span>
        <strong class="valor">@Filtradas.Count</strong>
    </div>
    <div class="cartao-resumo">
        <span class="rotulo">Total comprado</span>
        <strong class="valor">@Filtradas.Sum(c => c.ValorCompra).ToString("C")</strong>
    </div>
    <div class="cartao-resumo pendente">
        <span class="rotulo">Pendentes de recebimento</span>
        <strong class="valor">@Filtradas.Count(c => !c.Recebida)</strong>
    </div>
</div>

<div class="tabela">
    <table class="table">
    <thead>
        <tr>
            <th>Nº da nota</th>
            <th>Fornecedor</th>
            <th>Item</th>
            <th>Pagamento</th>
            <th class="col-num">Total</th>
            <th>Situação</th>
            <th class="col-acoes">Ações</th>
        </tr>
    </thead>
    <tbody>
        @if (Filtradas.Any())
        {
            @* Agrupado por dia, como em Vendas. *@
            @foreach (var dia in Filtradas.GroupBy(c => c.DataCompra.Date).OrderByDescending(g => g.Key))
            {
                <tr class="grupo-dia">
                    <td colspan="7">
                        <span class="grupo-dia-titulo">@RotuloDoDia(dia.Key)</span>
                        <span class="grupo-dia-resumo">
                            @dia.Count() compra(s) · @dia.Sum(c => c.ValorCompra).ToString("C")
                        </span>
                    </td>
                </tr>

                @foreach (var compra in dia)
                {
                    <tr>
                        <td>@Valor(compra.NumeroNota)</td>
                        <td><span class="nome-cliente">@Valor(compra.NomeFornecedor)</span></td>
                        <td>
                            <span class="descritivo">
                                @Valor(compra.ItemCompra ?? compra.NomeProduto)
                                @if (compra.Quantidade > 1)
                                {
                                    <text> × @compra.Quantidade</text>
                                }
                            </span>
                        </td>
                        <td>
                            <span class="descritivo">
                                @(compra.FormaPagamentoDespesa == null ? "—" : FormaPagamento.Rotulo(compra.FormaPagamentoDespesa))
                            </span>
                        </td>
                        <td class="col-num">@compra.ValorCompra.ToString("C")</td>
                        <td>
                            @if (compra.Pago.HasValue)
                            {
                                <span class="status @(compra.Pago.Value ? "pago" : "pendente")">
                                    <i></i>@(compra.Pago.Value ? "Paga" : "Em aberto")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                            @if (!compra.Recebida)
                            {
                                <span class="status pendente"><i></i>A receber</span>
                            }
                        </td>
                        <td class="col-acoes">
                            <AcoesLinha OnVisualizar="() => Visualizar(compra)"
                                        OnEditar="() => Editar(compra)"
                                        OnExcluir="() => excluindo = compra">
                                @if (!compra.Recebida)
                                {
                                    <button type="button" class="btn-acao" title="Receber mercadoria" aria-label="Receber mercadoria"
                                            @onclick="() => recebendo = compra">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10" />
                                        </svg>
                                    </button>
                                }
                            </AcoesLinha>
                        </td>
                    </tr>
                }
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="vazio">Nenhuma compra encontrada.</td>
            </tr>
        }
    </tbody>
    </table>
</div>

<ConfirmarModal Visivel="@(excluindo != null)" Titulo="Excluir compra" Erro="@erroExclusao"
                OnConfirmar="ConfirmarExclusao" OnCancelar="CancelarExclusao">
    Tem certeza que deseja excluir <strong>@excluindo?.ItemCompra</strong>?<br /><span class="text-muted">O estoque será estornado e a despesa lançada, excluída.</span><br />
    <span class="text-muted">Esta ação não pode ser desfeita.</span>
</ConfirmarModal>

<ConfirmarModal Visivel="@(recebendo != null)" Titulo="Receber mercadoria" Erro="@erroRecebimento"
                OnConfirmar="ConfirmarRecebimento" OnCancelar="CancelarRecebimento">
    Confirmar a chegada de <strong>@recebendo?.ItemCompra</strong>?<br />
    <span class="text-muted">Os produtos da nota entram no estoque com a data de hoje.</span>
</ConfirmarModal>

<Janela Visivel="@(visualizando != null)" Titulo="@($"Compra #{visualizando?.IdCompra}")"
        OnFechar="Fechar">
    <ChildContent>
        @if (visualizando != null)
        {
            <dl class="ficha">
                <div><dt>Data</dt><dd>@visualizando.DataCompra.ToString("dd/MM/yyyy")</dd></div>
                <div><dt>Nota</dt><dd>@Valor(visualizando.NumeroNota)</dd></div>
                <div><dt>Valor total</dt><dd>@visualizando.ValorCompra.ToString("C")</dd></div>
                <div><dt>Frete / desconto</dt><dd>@visualizando.Frete.ToString("C") / @visualizando.Desconto.ToString("C")</dd></div>
                <div><dt>Parcelas</dt><dd>@visualizando.Parcelas@(visualizando.VencimentoPrimeira.HasValue ? $" · 1ª em {visualizando.VencimentoPrimeira:dd/MM/yyyy}" : "")</dd></div>
                <div><dt>Fornecedor</dt><dd>@Valor(visualizando.NomeFornecedor)</dd></div>
                <div class="largo">
                    <dt>Itens</dt>
                    <dd>
                        @foreach (var i in itensVisualizados)
                        {
                            <div>@i.Quantidade× @i.Descricao — @i.CustoUnitario.ToString("C") cada</div>
                        }
                    </dd>
                </div>
                <div>
                    <dt>Recebimento</dt>
                    <dd>@(visualizando.Recebida ? visualizando.DataRecebimento?.ToString("dd/MM/yyyy") ?? "Recebida" : "Aguardando entrega")</dd>
                </div>
                <div class="largo"><dt>Observação</dt><dd>@Valor(visualizando.Observacao)</dd></div>
                <div><dt>Funcionário</dt><dd>@Valor(visualizando.NomeFuncionario)</dd></div>
                <div>
                    <dt>Despesa</dt>
                    <dd>@(visualizando.IdDespesa.HasValue ? $"Lançada (#{visualizando.IdDespesa})" : "—")</dd>
                </div>
            </dl>
        }
    </ChildContent>
    <Rodape>
        <button type="button" class="btn btn-outline-secondary" @onclick="Fechar">Fechar</button>
        <button type="button" class="btn btn-primary" @onclick="() => Editar(visualizando!)">Editar</button>
    </Rodape>
</Janela>

@code {
    private Compra? excluindo;
    private string? erroExclusao;

    private void ConfirmarExclusao()
    {
        if (excluindo == null) return;

        try
        {
            compraDAO.Excluir(excluindo.IdCompra);
            excluindo = null;
            erroExclusao = null;
            CarregarCompras();
        }
        catch (Exception ex)
        {
            erroExclusao = ex.Message;
        }
    }

    private void CancelarExclusao()
    {
        excluindo = null;
        erroExclusao = null;
    }

    private Compra? recebendo;
    private string? erroRecebimento;

    private async Task ConfirmarRecebimento()
    {
        if (recebendo == null) return;

        try
        {
            await auth.PrepararAsync();
            compraDAO.Receber(recebendo.IdCompra, auth.GetUsuarioNome());
            recebendo = null;
            erroRecebimento = null;
            CarregarCompras();
        }
        catch (Exception ex)
        {
            erroRecebimento = ex.Message;
        }
    }

    private void CancelarRecebimento()
    {
        recebendo = null;
        erroRecebimento = null;
    }

    private List<Compra> listaCompras = new();

    private List<Produto> produtos = new();
    private List<Fornecedor> fornecedores = new();
    private List<Funcionario> funcionarios = new();

    private Compra? visualizando;

    private List<OpcaoId> OpcoesProduto =>
        produtos.Select(p => new OpcaoId(p.IdProduto, p.NomeProduto ?? "Sem nome")).ToList();

    private List<OpcaoId> OpcoesFornecedor =>
        fornecedores.Select(f => new OpcaoId(f.IdFornecedor, f.NomeFornecedor ?? "Sem nome")).ToList();

    private List<OpcaoId> OpcoesFuncionario =>
        funcionarios.Select(u => new OpcaoId(u.IdFuncionario, u.NomeFuncionario ?? "Sem nome")).ToList();

    // Filtros. Periodo vai ao banco; o resto filtra em memoria.
    private DateTime? de;
    private DateTime? ate;
    private int filtroFornecedor;
    private int filtroProduto;
    private string filtroSituacao = "";
    private string filtroNota = "";

    private List<Compra> Filtradas =>
        listaCompras
            .Where(c => filtroFornecedor == 0 || c.IdFornecedor == filtroFornecedor)
            .Where(c => string.IsNullOrWhiteSpace(filtroNota)
                        || (c.NumeroNota ?? "").Contains(filtroNota.Trim(), StringComparison.OrdinalIgnoreCase))
            .Where(c => filtroProduto == 0 || c.IdProduto == filtroProduto || c.IdsProdutos.Contains(filtroProduto))
            .Where(c => filtroSituacao == ""
                        || (filtroSituacao == "PAGA" ? c.Pago == true : c.Pago == false))
            .ToList();

    private List<OpcaoId> OpcoesFiltroFornecedor =>
        new List<OpcaoId> { new(0, "Todos") }.Concat(OpcoesFornecedor).ToList();

    private List<OpcaoId> OpcoesFiltroProduto =>
        new List<OpcaoId> { new(0, "Todos") }.Concat(OpcoesProduto).ToList();

    private static readonly List<Opcao> OpcoesSituacao = new()
    {
        new("", "Todos"),
        new("PAGA", "Paga", "var(--ok)"),
        new("ABERTA", "Em aberto", "var(--alerta)")
    };

    protected override void OnInitialized()
    {
        try
        {
            produtos = produtoDAO.ListarTodos();
            fornecedores = fornecedorDAO.ListarTodos();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erro ao carregar os filtros de compras: " + ex.Message);
        }

        CarregarCompras();
    }

    private void Limpar()
    {
        de = ate = null;
        filtroFornecedor = 0;
        filtroProduto = 0;
        filtroSituacao = "";
        filtroNota = "";
        CarregarCompras();
    }

    private void Periodo(int dias)
    {
        ate = DateTime.Today;
        de = DateTime.Today.AddDays(-dias);
        CarregarCompras();
    }

    private void PeriodoMes()
    {
        var hoje = DateTime.Today;
        de = new DateTime(hoje.Year, hoje.Month, 1);
        ate = hoje;
        CarregarCompras();
    }

    /// <summary>"HOJE · QUINTA, 15/10" -- o mesmo rotulo de Vendas.</summary>
    private static string RotuloDoDia(DateTime dia)
    {
        var cultura = new System.Globalization.CultureInfo("pt-BR");
        var semana = cultura.DateTimeFormat.GetDayName(dia.DayOfWeek);
        var corpo = $"{semana}, {dia:dd/MM}".ToUpper(cultura);

        if (dia == DateTime.Today) return $"HOJE · {corpo}";
        if (dia == DateTime.Today.AddDays(-1)) return $"ONTEM · {corpo}";
        return corpo;
    }

    private void CarregarCompras()
    {
        try
        {
            // 'ate' e exclusivo no SQL: soma um dia para incluir o dia escolhido.
            listaCompras = compraDAO.ListarTodos(de, ate?.AddDays(1));
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erro ao carregar compras: " + ex.Message);
        }
    }

    private static string Valor(string? texto) =>
        string.IsNullOrWhiteSpace(texto) ? "—" : texto;

    /// <summary>A edicao e uma pagina propria, com o mesmo formulario do cadastro.</summary>
    private void Editar(Compra c) => Navigation.NavigateTo($"/compra/{c.IdCompra}");

    private void Fechar() => visualizando = null;

    private List<CompraItem> itensVisualizados = new();

    private void Visualizar(Compra compra)
    {
        try
        {
            itensVisualizados = compraDAO.ListarItens(compra.IdCompra);
        }
        catch
        {
            itensVisualizados = new();
        }
        visualizando = compra;
    }

}
