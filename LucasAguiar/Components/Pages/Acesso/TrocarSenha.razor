@page "/trocar-senha"
@rendermode InteractiveServer

@using LucasAguiar.Configs
@using LucasAguiar.Services
@inject UsuarioDAO usuarioDAO
@inject LogDAO logs
@inject AuthenticationService auth
@inject NavigationManager Navigation

<PageTitle>Alterar senha</PageTitle>

<div class="troca-senha">
    <div class="troca-cartao">
        <Marca Variante="Marca.Tipo.Icone" />

        @if (obrigatoria)
        {
            <h1>Defina uma nova senha</h1>
            <p class="troca-explica">
                A senha atual foi definida pelo administrador e vale só para
                esta primeira entrada. Escolha uma senha sua para continuar.
            </p>
        }
        else
        {
            <h1>Alterar senha</h1>
            <p class="troca-explica">
                Ao concluir, as suas sessões abertas em outros dispositivos
                são encerradas.
            </p>
        }

        @if (concluido)
        {
            <div class="troca-ok" role="status">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" />
                </svg>
                Senha alterada.
            </div>

            <a href="/" class="btn-novo" data-enhance-nav="false">Ir para o painel</a>
        }
        else
        {
            <div class="troca-campos">
                <label>
                    Senha atual
                    <span class="campo-senha">
                        <input id="senha-atual" type="password" class="form-control"
                               autocomplete="current-password" @bind="senhaAtual" />
                        <button type="button" class="ver-senha" data-ver-senha="senha-atual"
                                aria-label="Mostrar senha" aria-pressed="false">
                            @Olho
                        </button>
                    </span>
                </label>

                <label>
                    Nova senha
                    <span class="campo-senha">
                        <input id="senha-nova" type="password" class="form-control"
                               autocomplete="new-password" @bind="senhaNova" />
                        <button type="button" class="ver-senha" data-ver-senha="senha-nova"
                                aria-label="Mostrar senha" aria-pressed="false">
                            @Olho
                        </button>
                    </span>
                    <small class="troca-dica">@SegurancaSenha.DicaPolitica</small>
                </label>

                <label>
                    Confirmar a nova senha
                    <span class="campo-senha">
                        <input id="senha-confirma" type="password" class="form-control"
                               autocomplete="new-password" @bind="senhaConfirma" />
                        <button type="button" class="ver-senha" data-ver-senha="senha-confirma"
                                aria-label="Mostrar senha" aria-pressed="false">
                            @Olho
                        </button>
                    </span>
                </label>
            </div>

            @if (!string.IsNullOrEmpty(erro))
            {
                <div class="alert alert-danger" role="alert">@erro</div>
            }

            <div class="troca-botoes">
                @if (!obrigatoria)
                {
                    <a href="/" class="btn btn-outline-secondary">Cancelar</a>
                }

                <button type="button" class="btn btn-primary" disabled="@salvando"
                        @onclick="Salvar">
                    @(salvando ? "Salvando…" : "Salvar senha")
                </button>
            </div>
        }
    </div>
</div>

@code {
    private string? senhaAtual;
    private string? senhaNova;
    private string? senhaConfirma;

    private string? erro;
    private bool salvando;
    private bool concluido;
    private bool obrigatoria;

    protected override async Task OnInitializedAsync()
    {
        await auth.PrepararAsync();
        obrigatoria = auth.PrecisaTrocarSenha();
    }

    private void Salvar()
    {
        erro = null;

        var id = auth.GetUsuarioId();
        if (id == null)
        {
            erro = "Sessão não encontrada. Entre de novo.";
            return;
        }

        if (senhaNova != senhaConfirma)
        {
            erro = "A confirmação não é igual à nova senha.";
            return;
        }

        salvando = true;

        try
        {
            // A politica, a conferencia da senha atual e o encerramento das
            // outras sessoes acontecem juntos, numa transacao, dentro do DAO.
            usuarioDAO.AlterarPropriaSenha(id.Value, senhaAtual, senhaNova, auth.GetToken());

            logs.Registrar(new Evento
            {
                Acao = Acoes.SenhaAlterada,
                Descricao = "Alterou a própria senha; as outras sessões foram encerradas.",
                IdUsuario = id.Value,
                NomeGravado = auth.GetUsuarioNome()
            });

            concluido = true;
            senhaAtual = senhaNova = senhaConfirma = null;
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
        finally
        {
            salvando = false;
        }
    }

    private static readonly RenderFragment Olho = @<text>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="olho-aberto">
            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" />
            <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
        </svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="olho-fechado">
            <path d="M9.9 5.2A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7a18 18 0 0 1-3.2 4.2M6.6 6.6A18 18 0 0 0 2 12s3.6 7 10 7a10.5 10.5 0 0 0 5.4-1.4" />
            <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2M3 3l18 18" />
        </svg>
    </text>;
}
