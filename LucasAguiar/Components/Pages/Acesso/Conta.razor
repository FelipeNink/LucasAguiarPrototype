@page "/conta"
@rendermode InteractiveServer

@using LucasAguiar.Configs
@using LucasAguiar.Models
@using LucasAguiar.Services
@inject SessaoDAO sessaoDAO
@inject EquipeDAO equipeDAO
@inject LogDAO logs
@inject AuthenticationService auth
@inject IJSRuntime JS

@* Sem politica de tela: a propria conta nao e uma tela do catalogo, e
   barrar alguem de ver os proprios dados ou trocar a propria senha nao
   faria sentido. Exige apenas estar logado, pelo _Imports da pasta. *@

<PageTitle>Minha conta</PageTitle>

<h1>Minha conta</h1>

@if (membro == null)
{
    <p class="text-muted">Carregando…</p>
}
else
{
    <div class="grade-conta">
        <section class="cartao bloco-conta identidade">
            <span class="avatar-conta" aria-hidden="true">@membro.Iniciais</span>

            <div>
                <strong>@membro.NomeVisivel</strong>
                <span class="login-conta">@membro.NomeUsr</span>

                <dl class="dados-conta">
                    <div>
                        <dt>Função</dt>
                        <dd>@Texto(membro.NomeFuncao)</dd>
                    </div>
                    <div>
                        <dt>Perfil</dt>
                        <dd>
                            @Perfil.Rotulo(membro.PerfilUsr)
                            @if (membro.RaizUsr)
                            {
                                <span class="etiqueta-raiz">super-administrador</span>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>Último acesso</dt>
                        <dd>@(membro.UltimoLoginUsr?.ToString("dd/MM/yyyy 'às' HH:mm") ?? "—")</dd>
                    </div>
                </dl>
            </div>
        </section>

        <section class="cartao bloco-conta">
            <h2>Senha</h2>
            <p>
                Ao trocar a senha, as suas sessões abertas em outros dispositivos
                são encerradas.
            </p>
            <a href="/trocar-senha" class="btn btn-primary">Alterar senha</a>
        </section>

        <section class="cartao bloco-conta">
            <h2>Aparência</h2>
            <p>A escolha vale neste navegador.</p>

            <div class="escolha-tema" role="group" aria-label="Tema">
                <button type="button" class="@(tema == "claro" ? "ativo" : "")"
                        @onclick='() => TrocarTema("claro")'>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10zM12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
                    </svg>
                    Claro
                </button>
                <button type="button" class="@(tema == "escuro" ? "ativo" : "")"
                        @onclick='() => TrocarTema("escuro")'>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
                    </svg>
                    Escuro
                </button>
            </div>
        </section>

        <section class="cartao bloco-conta sessoes">
            <h2>Meus acessos abertos</h2>
            <p>
                Onde esta conta está entrando agora. Se algum não for seu,
                encerre e troque a senha.
            </p>

            @if (!string.IsNullOrEmpty(erro))
            {
                <div class="alert alert-danger" role="alert">@erro</div>
            }

            <ul class="lista-sessoes">
                @foreach (var sessao in sessoes)
                {
                    <li>
                        <div>
                            <strong>
                                @sessao.Dispositivo
                                @if (sessao.EstaAtual)
                                {
                                    <span class="atual">este dispositivo</span>
                                }
                            </strong>
                            <span>
                                Desde @sessao.CriadoEm.ToString("dd/MM 'às' HH:mm")
                                · expira @sessao.ExpiraEm.ToString("dd/MM 'às' HH:mm")
                                @if (!string.IsNullOrWhiteSpace(sessao.Ip))
                                {
                                    <text> · @sessao.Ip</text>
                                }
                            </span>
                        </div>

                        @if (!sessao.EstaAtual)
                        {
                            <button type="button" class="btn btn-outline-secondary"
                                    @onclick="() => Encerrar(sessao)">
                                Encerrar
                            </button>
                        }
                    </li>
                }
            </ul>

            @if (sessoes.Count(s => !s.EstaAtual) > 0)
            {
                <button type="button" class="btn btn-outline-danger"
                        @onclick="EncerrarOutras">
                    Sair de todos os outros dispositivos
                </button>
            }
        </section>
    </div>
}

@code {
    private Usuario? membro;
    private List<Sessao> sessoes = new();
    private string tema = "claro";
    private string? erro;

    protected override async Task OnInitializedAsync()
    {
        await auth.PrepararAsync();

        var id = auth.GetUsuarioId();
        if (id == null) return;

        membro = equipeDAO.BuscarPorId(id.Value);

        CarregarSessoes();
    }

    protected override async Task OnAfterRenderAsync(bool primeiraVez)
    {
        if (!primeiraVez) return;

        var salvo = await JS.InvokeAsync<string>("tema.ler");
        if (salvo != tema)
        {
            tema = salvo;
            StateHasChanged();
        }
    }

    private void CarregarSessoes()
    {
        var id = auth.GetUsuarioId();
        if (id == null) return;

        try
        {
            sessoes = sessaoDAO.ListarDoUsuario(id.Value, auth.GetToken());
            erro = null;
        }
        catch (Exception ex)
        {
            erro = ex.Message;
            sessoes = new();
        }
    }

    private void Encerrar(Sessao sessao)
    {
        var id = auth.GetUsuarioId();
        if (id == null) return;

        try
        {
            // So encerra sessao do proprio usuario: o DAO confere o dono.
            sessaoDAO.EncerrarPorId(sessao.IdSessao, id.Value);

            logs.Registrar(new Evento
            {
                Acao = Acoes.SessoesEncerradas,
                Descricao = "Encerrou um acesso aberto em outro dispositivo.",
                IdUsuario = id.Value,
                NomeGravado = auth.GetUsuarioNome()
            });

            CarregarSessoes();
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }

    private void EncerrarOutras()
    {
        var id = auth.GetUsuarioId();
        if (id == null) return;

        try
        {
            var quantas = sessaoDAO.EncerrarTodasDoUsuario(id.Value, auth.GetToken());

            logs.Registrar(new Evento
            {
                Acao = Acoes.SessoesEncerradas,
                Descricao = $"Encerrou {quantas} acesso(s) em outros dispositivos.",
                IdUsuario = id.Value,
                NomeGravado = auth.GetUsuarioNome()
            });

            CarregarSessoes();
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }

    private async Task TrocarTema(string novo)
    {
        if (novo == tema) return;

        tema = novo;
        await JS.InvokeVoidAsync("tema.aplicar", novo);
    }

    private static string Texto(string? valor) =>
        string.IsNullOrWhiteSpace(valor) ? "—" : valor;
}
