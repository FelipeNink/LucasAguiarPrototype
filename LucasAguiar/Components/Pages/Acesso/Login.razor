@page "/login"

@using LucasAguiar.Models
@inject UsuarioDAO usuarioDAO
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Entrar — Lucas Aguiar</PageTitle>

<div class="tela-login">
    <div class="cartao">
        <img src="logo-escura.png" alt="Lucas Aguiar" class="marca marca-clara" />
        <img src="logo-branca.png" alt="Lucas Aguiar" class="marca marca-escura" />

        <h1>Lucas Aguiar</h1>
        <p class="legenda">Sistema de Gerenciamento Empresarial</p>

        <EditForm Model="login" OnValidSubmit="Logar" FormName="formLogin">
            @if (!string.IsNullOrEmpty(erro))
            {
                <div class="erro">@erro</div>
            }

            <label for="usuario">Usuário</label>
            <InputText id="usuario" @bind-Value="login.NomeUsuario" autocomplete="username" />

            <label for="senha">Senha</label>
            @* A troca e feita em JS: a tela de login e renderizacao
               estatica, sem circuito Blazor para um @onclick responder. *@
            <div class="campo-senha">
                <InputText id="senha" @bind-Value="login.Senha" type="password" autocomplete="current-password" />
                <button type="button" class="ver-senha" data-ver-senha="senha"
                        aria-label="Mostrar senha" aria-pressed="false">
                    <svg viewBox="0 0 16 16" aria-hidden="true" class="olho-aberto">
                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z" />
                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0" />
                    </svg>
                    <svg viewBox="0 0 16 16" aria-hidden="true" class="olho-fechado">
                        <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755q-.247.248-.517.486z" />
                        <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829" />
                        <path d="M3.35 5.47q-.27.24-.518.487A13 13 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7 7 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12z" />
                    </svg>
                </button>
            </div>

            <button type="submit">Entrar</button>
        </EditForm>

        <p class="creditos">&copy; Garotos de Programa</p>
    </div>
</div>


@code {
    [SupplyParameterFromForm(FormName = "formLogin")]
    private LoginModel login { get; set; } = new();

    private string? erro;

    private void Logar()
    {
        erro = null;

        if (string.IsNullOrWhiteSpace(login.NomeUsuario) || string.IsNullOrWhiteSpace(login.Senha))
        {
            erro = "Informe usuário e senha.";
            return;
        }

        Usuario? usuario;
        try
        {
            usuario = usuarioDAO.ValidarLogin(login.NomeUsuario, login.Senha);
        }
        catch (Exception ex)
        {
            erro = "Erro ao entrar: " + ex.Message;
            return;
        }

        if (usuario == null)
        {
            erro = "Usuário ou senha inválidos.";
            return;
        }

        var httpContext = HttpContextAccessor?.HttpContext;
        if (httpContext == null)
        {
            erro = "Não foi possível iniciar a sessão. Recarregue a página.";
            return;
        }

        httpContext.Session.SetString("UsuarioId", usuario.IdUsr.ToString());
        httpContext.Session.SetString("UsuarioNome", usuario.NomeUsr ?? "");

        // Fora do try: NavigateTo lanca NavigationException internamente para
        // sinalizar o redirecionamento no render estatico do servidor.
        Navigation.NavigateTo("/", forceLoad: true);
    }

    public class LoginModel
    {
        public string NomeUsuario { get; set; } = "";
        public string Senha { get; set; } = "";
    }
}
