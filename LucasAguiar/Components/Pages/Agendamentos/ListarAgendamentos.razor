@page "/agendamentos"
@rendermode InteractiveServer

@inject AgendamentoDAO agendamentoDAO
@inject NavigationManager Navigation

<h1>Agendamentos</h1>

<div class="barra-acoes">
    <a href="/agendamento/novo" class="btn-novo">Novo agendamento</a>
</div>

@if (Novo.HasValue)
{
    <div class="alert alert-success">Agendamento #@Novo registrado com sucesso.</div>
}
@if (!string.IsNullOrEmpty(erro))
{
    <div class="alert alert-danger">@erro</div>
}

<div class="filtros-agenda">
    <div class="atalhos-periodo">
        <button type="button" class="@(periodo == Periodo.Hoje ? "ativo" : "")" @onclick="() => Filtrar(Periodo.Hoje)">Hoje</button>
        <button type="button" class="@(periodo == Periodo.Amanha ? "ativo" : "")" @onclick="() => Filtrar(Periodo.Amanha)">Amanhã</button>
        <button type="button" class="@(periodo == Periodo.Semana ? "ativo" : "")" @onclick="() => Filtrar(Periodo.Semana)">Próximos 7 dias</button>
        <button type="button" class="@(periodo == Periodo.Todos ? "ativo" : "")" @onclick="() => Filtrar(Periodo.Todos)">Todos</button>
    </div>

    <Seletor TItem="Opcao" TValor="string" Itens="OpcoesFiltroStatus"
             Valor="filtroStatus" ValorChanged="FiltrarStatus"
             Rotulo="Status:" TextoDe="o => o.Rotulo" ValorDe="o => o.Valor"
             PontoDe="o => o.Cor" Class="filtro-status" />
</div>

<div class="resumo-linha">
    <div class="item aberto">
        <span class="numero">@agendamentos.Count(a => a.Status == StatusAgendamento.Agendado)</span>
        <span class="rotulo">agendado(s)</span>
    </div>
    <div class="item">
        <span class="numero">@agendamentos.Count(a => a.Status == StatusAgendamento.Concluido)</span>
        <span class="rotulo">concluído(s)</span>
    </div>
    <div class="item">
        <span class="numero">@agendamentos.Count(a => a.Status == StatusAgendamento.Cancelado)</span>
        <span class="rotulo">cancelado(s)</span>
    </div>
</div>

<div class="tabela fixa">
    <table class="table">
        <thead>
            <tr>
                <th class="col-horario">Horário</th>
                <th>Cliente</th>
                <th class="opcional">Serviço</th>
                <th class="opcional">Profissional</th>
                <th class="col-status">Status</th>
                <th class="col-acoes quatro"></th>
            </tr>
        </thead>
        <tbody>
            @if (agendamentos.Count > 0)
            {
                @foreach (var dia in agendamentos.GroupBy(a => a.DataHora.Date))
                {
                    <tr class="grupo-dia">
                        <td colspan="6">
                            <span class="grupo-dia-titulo">@RotuloDoDia(dia.Key)</span>
                            <span class="grupo-dia-resumo">@dia.Count() horário(s)</span>
                        </td>
                    </tr>

                    @foreach (var a in dia)
                    {
                        <tr class="@(a.Status == StatusAgendamento.Cancelado ? "cancelada" : "")">
                            <td><span class="hora">@a.DataHora.ToString("HH:mm")–@a.Fim.ToString("HH:mm")</span></td>
                            <td>
                                <span class="nome-cliente">@(a.NomeCliente ?? "—")</span>
                            </td>
                            <td class="opcional"><span class="descritivo">@(a.NomeServico ?? "—")</span></td>
                            <td class="opcional"><span class="descritivo">@(a.NomeFuncionario ?? "—")</span></td>
                            <td>
                                <span class="status @ClasseStatus(a.Status)">
                                    <i></i>@StatusAgendamento.Rotulo(a.Status)
                                </span>
                            </td>
                            <td class="col-acoes">
                                <AcoesLinha OnVisualizar="() => Visualizar(a)" OnEditar="() => Editar(a)"
                                            HrefExcluir="@($"/agendamento/{a.IdAgendamento}/excluir")">
                                    @if (a.Aberto)
                                    {
                                        <a href="@UrlGerarVenda(a)" class="btn-acao" title="Gerar venda" aria-label="Gerar venda">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6" />
                                            </svg>
                                        </a>
                                    }
                                </AcoesLinha>
                            </td>
                        </tr>
                    }
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="vazio">Nenhum agendamento neste período.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* ---------- visualizar ---------- *@
<Janela Visivel="@(visualizando != null)" Titulo="@($"Agendamento #{visualizando?.IdAgendamento}")"
        OnFechar="Fechar">
    <ChildContent>
        @if (visualizando != null)
        {
            <dl class="ficha">
                <div>
                    <dt>Data</dt>
                    <dd>@visualizando.DataHora.ToString("dd/MM/yyyy")</dd>
                </div>
                <div>
                    <dt>Horário</dt>
                    <dd>@visualizando.DataHora.ToString("HH:mm") às @visualizando.Fim.ToString("HH:mm") (@visualizando.DuracaoMin min)</dd>
                </div>
                <div>
                    <dt>Cliente</dt>
                    <dd>@(visualizando.NomeCliente ?? "—")</dd>
                </div>
                <div>
                    <dt>Telefone</dt>
                    <dd class="@(string.IsNullOrWhiteSpace(visualizando.TelefoneCliente) ? "vazio-campo" : "")">
                        @(string.IsNullOrWhiteSpace(visualizando.TelefoneCliente) ? "Não informado" : visualizando.TelefoneCliente)
                    </dd>
                </div>
                <div>
                    <dt>Serviço</dt>
                    <dd>@(visualizando.NomeServico ?? "—") · @visualizando.PrecoServico.ToString("C")</dd>
                </div>
                <div>
                    <dt>Profissional</dt>
                    <dd>@(visualizando.NomeFuncionario ?? "—")</dd>
                </div>
                <div>
                    <dt>Status</dt>
                    <dd>
                        <span class="status @ClasseStatus(visualizando.Status)">
                            <i></i>@StatusAgendamento.Rotulo(visualizando.Status)
                        </span>
                    </dd>
                </div>
                <div>
                    <dt>Venda</dt>
                    <dd class="@(visualizando.IdVenda.HasValue ? "" : "vazio-campo")">
                        @(visualizando.IdVenda.HasValue ? $"#{visualizando.IdVenda}" : "Nenhuma gerada")
                    </dd>
                </div>
                <div class="largo">
                    <dt>Observação</dt>
                    <dd class="@(string.IsNullOrWhiteSpace(visualizando.Observacao) ? "vazio-campo" : "")">
                        @(string.IsNullOrWhiteSpace(visualizando.Observacao) ? "Sem observação" : visualizando.Observacao)
                    </dd>
                </div>
            </dl>
        }
    </ChildContent>
    <Rodape>
        <button type="button" class="btn btn-outline-secondary" @onclick="Fechar">Fechar</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => Editar(visualizando!)">Editar</button>
        @if (visualizando?.Aberto == true)
        {
            <a href="@UrlGerarVenda(visualizando)" class="btn btn-primary">Gerar venda</a>
        }
    </Rodape>
</Janela>

@* ---------- editar ---------- *@
<Janela Visivel="@(editando != null)" Titulo="@($"Editar agendamento #{editando?.IdAgendamento}")"
        Largura="640" Erro="@erroModal" OnFechar="Fechar">
    <ChildContent>
        @if (editando != null)
        {
            <CamposAgendamento Agendamento="editando" MostrarStatus="true" OnErro="m => erroModal = m" />
        }
    </ChildContent>
    <Rodape>
        <button type="button" class="btn btn-outline-secondary" @onclick="Fechar">Cancelar</button>
        <button type="button" class="btn btn-primary" @onclick="Salvar">Salvar</button>
    </Rodape>
</Janela>

@code {
    private enum Periodo { Hoje, Amanha, Semana, Todos }

    [SupplyParameterFromQuery(Name = "novo")]
    private int? Novo { get; set; }

    private List<Agendamento> agendamentos = new();
    private Periodo periodo = Periodo.Hoje;
    private string filtroStatus = "";
    private string? erro;
    private string? erroModal;

    private Agendamento? visualizando;
    private Agendamento? editando;

    private static readonly List<Opcao> OpcoesFiltroStatus = new()
    {
        new("", "Todos"),
        new(StatusAgendamento.Agendado, "Agendado", "var(--alerta)"),
        new(StatusAgendamento.Concluido, "Concluído", "var(--ok)"),
        new(StatusAgendamento.Cancelado, "Cancelado", "var(--texto-fraco)")
    };

    protected override void OnInitialized() => Carregar();

    private void Filtrar(Periodo novo)
    {
        periodo = novo;
        Carregar();
    }

    private void FiltrarStatus(string? status)
    {
        filtroStatus = status ?? "";
        Carregar();
    }

    private void Carregar()
    {
        try
        {
            erro = null;

            var hoje = DateTime.Today;
            (DateTime? de, DateTime? ate) = periodo switch
            {
                Periodo.Hoje => (hoje, hoje.AddDays(1)),
                Periodo.Amanha => (hoje.AddDays(1), hoje.AddDays(2)),
                Periodo.Semana => (hoje, hoje.AddDays(7)),
                _ => ((DateTime?)null, (DateTime?)null)
            };

            agendamentos = agendamentoDAO.Listar(de, ate, filtroStatus);
        }
        catch (Exception ex)
        {
            erro = "Erro ao carregar os agendamentos: " + ex.Message;
        }
    }

    private void Visualizar(Agendamento a)
    {
        editando = null;
        visualizando = a;
    }

    /// <summary>Edita uma copia: cancelar o modal nao pode alterar a linha da tabela.</summary>
    private void Editar(Agendamento a)
    {
        visualizando = null;
        erroModal = null;
        editando = new Agendamento
        {
            IdAgendamento = a.IdAgendamento,
            DataHora = a.DataHora,
            DuracaoMin = a.DuracaoMin,
            IdCliente = a.IdCliente,
            IdFuncionario = a.IdFuncionario,
            IdServico = a.IdServico,
            Observacao = a.Observacao,
            Status = a.Status,
            IdVenda = a.IdVenda
        };
    }

    private void Fechar()
    {
        visualizando = null;
        editando = null;
        erroModal = null;
    }

    private void Salvar()
    {
        if (editando == null) return;

        try
        {
            agendamentoDAO.Atualizar(editando);
            Fechar();
            Carregar();
        }
        catch (Exception ex)
        {
            erroModal = ex.Message;
        }
    }

    private static string UrlGerarVenda(Agendamento a) => $"/venda/nova?agendamento={a.IdAgendamento}";

    private static string ClasseStatus(string status) => status switch
    {
        StatusAgendamento.Agendado => "pendente",
        StatusAgendamento.Concluido => "pago",
        _ => "cancelada"
    };

    private static string RotuloDoDia(DateTime dia)
    {
        var cultura = new System.Globalization.CultureInfo("pt-BR");
        var semana = cultura.DateTimeFormat.GetDayName(dia.DayOfWeek);
        var corpo = $"{semana}, {dia:dd/MM}".ToUpper(cultura);

        if (dia == DateTime.Today) return $"HOJE · {corpo}";
        if (dia == DateTime.Today.AddDays(1)) return $"AMANHÃ · {corpo}";
        return corpo;
    }
}
