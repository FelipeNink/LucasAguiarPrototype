@page "/funcoes"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Politicas.Funcoes)]

@using LucasAguiar.Configs
@using LucasAguiar.Models
@using LucasAguiar.Services
@inject FuncaoDAO funcaoDAO
@inject EquipeDAO equipeDAO
@inject Autorizacao permissao
@inject AuthenticationService auth

<PageTitle>Funções</PageTitle>

<h1>Funções</h1>

<p class="explica-funcoes">
    O cargo de cada membro da equipe. Renomear vale na hora para todo mundo
    que estiver na função, porque o vínculo é por referência e não por texto
    copiado.
</p>

<div class="barra-acoes">
    @if (permissao.Pode("funcoes", Acao.Criar))
    {
        <button type="button" class="btn-novo" @onclick="AbrirNova">Nova função</button>
    }
</div>

@if (!string.IsNullOrEmpty(erro))
{
    <div class="alert alert-danger" role="alert">@erro</div>
}

<div class="tabela fixa">
    <table class="table table-striped">
        <thead>
            <tr>
                <th class="col-id">#</th>
                <th>Nome</th>
                <th>Membros</th>
                <th class="col-acoes">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (funcoes.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        Nenhuma função cadastrada.
                    </td>
                </tr>
            }
            else
            {
                var contador = 1;

                @foreach (var funcao in funcoes)
                {
                    <tr>
                        <td>@(contador++)</td>
                        <td><strong>@funcao.Nome</strong></td>
                        <td>
                            @if (funcao.EmUso)
                            {
                                <span class="membros">@funcao.Membros</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="col-acoes">
                            <span class="acoes">
                                @if (permissao.Pode("funcoes", Acao.Editar))
                                {
                                    <button type="button" class="btn-acao" title="Renomear"
                                            aria-label="Renomear @funcao.Nome"
                                            @onclick="() => AbrirRenomear(funcao)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />
                                        </svg>
                                    </button>
                                }

                                @if (permissao.Pode("funcoes", Acao.Excluir))
                                {
                                    <button type="button" class="btn-acao perigo" title="Excluir"
                                            aria-label="Excluir @funcao.Nome"
                                            @onclick="() => excluindo = funcao">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                        </svg>
                                    </button>
                                }
                            </span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<Janela Visivel="@editando" Titulo="@(idEditando == 0 ? "Nova função" : "Renomear função")"
        Erro="@erroModal" OnFechar="Fechar">
    <ChildContent>
        <div class="campo-janela">
            <label class="form-label">Nome</label>
            <input class="form-control" maxlength="60" placeholder="Barbeiro, Recepção…"
                   @bind="nome" />
        </div>
    </ChildContent>
    <Rodape>
        <button type="button" class="btn btn-outline-secondary" @onclick="Fechar">Cancelar</button>
        <button type="button" class="btn btn-primary" @onclick="Salvar">Salvar</button>
    </Rodape>
</Janela>

<ConfirmarModal Visivel="@(excluindo != null)" Titulo="Excluir função"
                TextoConfirmar="Excluir" Erro="@erroModal"
                OnConfirmar="ConfirmarExclusao" OnCancelar="Fechar">
    Excluir a função <strong>@excluindo?.Nome</strong>?<br />
    <span class="text-muted">Nenhum acesso é alterado por isso.</span>
</ConfirmarModal>

@code {
    private List<Funcao> funcoes = new();

    private bool editando;
    private int idEditando;
    private string nome = "";

    private Funcao? excluindo;

    private string? erro;
    private string? erroModal;

    protected override async Task OnInitializedAsync()
    {
        await auth.PrepararAsync();
        await permissao.CarregarAsync();

        Carregar();
    }

    private void Carregar()
    {
        try
        {
            funcoes = funcaoDAO.Listar();
            erro = null;
        }
        catch (Exception ex)
        {
            erro = ex.Message;
            funcoes = new();
        }
    }

    private void AbrirNova()
    {
        idEditando = 0;
        nome = "";
        erroModal = null;
        editando = true;
    }

    private void AbrirRenomear(Funcao funcao)
    {
        idEditando = funcao.IdFuncao;
        nome = funcao.Nome;
        erroModal = null;
        editando = true;
    }

    private void Fechar()
    {
        editando = false;
        excluindo = null;
        erroModal = null;
    }

    private void Salvar()
    {
        try
        {
            if (idEditando == 0)
                funcaoDAO.Criar(nome, Autor());
            else
                funcaoDAO.Renomear(idEditando, nome, Autor());

            Fechar();
            Carregar();
        }
        catch (Exception ex)
        {
            erroModal = ex.Message;
        }
    }

    private void ConfirmarExclusao()
    {
        if (excluindo == null) return;

        try
        {
            funcaoDAO.Excluir(excluindo.IdFuncao, Autor());

            Fechar();
            Carregar();
        }
        catch (Exception ex)
        {
            erroModal = ex.Message;
        }
    }

    private Autor Autor() => new(
        auth.GetUsuarioId() ?? 0, auth.GetUsuarioNome() ?? "",
        auth.EhAdmin(), auth.EhRaiz());
}
