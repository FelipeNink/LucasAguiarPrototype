@page "/equipe"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Politicas.Equipe)]

@using LucasAguiar.Configs
@using LucasAguiar.Models
@using LucasAguiar.Services
@inject EquipeDAO equipeDAO
@inject Autorizacao permissao
@inject AuthenticationService auth
@inject NavigationManager Navigation

<PageTitle>Equipe</PageTitle>

<AbasGrupo Abas="AbasGrupo.Configuracoes" />

<h1 class="titulo-listagem">Gestão de Equipe</h1>

<div class="barra-acoes barra-listagem">
    @if (permissao.Pode("equipe", Acao.Exportar))
    {
        <BotaoExportar Href="/relatorio/equipe" />
        <BotaoExportar Tipo="BotaoExportar.Formato.Excel" Href="/excel/equipe" />
    }

    @if (permissao.Pode("equipe", Acao.Criar))
    {
        <NavLink href="/equipe/novo" class="btn-novo btn-cadastrar">Cadastrar membro</NavLink>
    }
</div>

@* ---------- filtros ---------- *@
<section class="filtros">
    <div class="campo campo-largo">
        <label>Nome, usuário ou função</label>
        <input class="form-control" type="search" placeholder="Buscar membro"
               aria-label="Buscar membro" value="@busca"
               @oninput="AoBuscar" />
    </div>
</section>

@if (!string.IsNullOrEmpty(aviso))
{
    <div class="alert alert-success" role="status">@aviso</div>
}
@if (!string.IsNullOrEmpty(erro))
{
    <div class="alert alert-danger" role="alert">@erro</div>
}

<div class="tabela fixa">
    <table class="table table-striped">
        <thead>
            <tr>
                <th class="col-avatar"></th>
                <th>@Cabecalho("Nome", Coluna.Nome)</th>
                <th class="opcional">@Cabecalho("Usuário", Coluna.Usuario)</th>
                <th class="opcional">@Cabecalho("Função", Coluna.Funcao)</th>
                <th>@Cabecalho("Status", Coluna.Status)</th>
                <th class="col-acoes quatro">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (carregando)
            {
                <tr><td colspan="6" class="text-center text-muted">Carregando…</td></tr>
            }
            else if (Visiveis.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">
                        @(string.IsNullOrWhiteSpace(busca)
                            ? "Nenhum membro cadastrado."
                            : "Nenhum membro encontrado.")
                    </td>
                </tr>
            }
            else
            {
                @foreach (var membro in Visiveis)
                {
                    <tr class="@(membro.AtivoUsr ? "" : "linha-inativa")">
                        <td class="col-avatar">
                            <span class="avatar-membro" style="@Cor(membro)" aria-hidden="true">
                                @membro.Iniciais
                            </span>
                        </td>
                        <td>
                            <strong>@membro.NomeVisivel</strong>
                            @if (membro.RaizUsr)
                            {
                                <span class="etiqueta raiz" title="Super-administrador">raiz</span>
                            }
                            else if (membro.EhAdmin)
                            {
                                <span class="etiqueta admin">admin</span>
                            }
                            @if (membro.IdUsr == IdProprio)
                            {
                                <span class="etiqueta voce">você</span>
                            }
                        </td>
                        <td class="opcional"><code class="login">@membro.NomeUsr</code></td>
                        <td class="opcional">@Texto(membro.NomeFuncao)</td>
                        <td>
                            <span class="status @(membro.AtivoUsr ? "ok" : "off")">
                                <i aria-hidden="true"></i>@(membro.AtivoUsr ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td class="col-acoes">
                            <span class="acoes">
                                @if (permissao.Pode("equipe", Acao.Editar))
                                {
                                    <button type="button" class="btn-acao" title="Editar"
                                            aria-label="Editar @membro.NomeVisivel"
                                            @onclick="() => Editar(membro)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />
                                        </svg>
                                    </button>

                                    @* A propria linha nao mostra ativar/desativar: desligar
                                       o proprio acesso e barrado no servidor, e oferecer o
                                       botao so para recusar depois seria enganoso. *@
                                    @if (PodeMexer(membro))
                                    {
                                        <button type="button" class="btn-acao"
                                                title="@(membro.AtivoUsr ? "Desativar" : "Ativar")"
                                                aria-label="@(membro.AtivoUsr ? "Desativar" : "Ativar") @membro.NomeVisivel"
                                                @onclick="() => alternando = membro">
                                            @if (membro.AtivoUsr)
                                            {
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M18.4 6.6a9 9 0 1 1-12.8 0M12 2v10" />
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M20 6 9 17l-5-5" />
                                                </svg>
                                            }
                                        </button>
                                    }
                                }

                                @if (permissao.Pode("equipe", Acao.Excluir) && PodeMexer(membro))
                                {
                                    <button type="button" class="btn-acao perigo" title="Excluir"
                                            aria-label="Excluir @membro.NomeVisivel"
                                            @onclick="() => excluindo = membro">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6M10 11v6M14 11v6" />
                                        </svg>
                                    </button>
                                }
                            </span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (!carregando && Visiveis.Count > 0)
{
    <p class="contagem-equipe">
        @Visiveis.Count de @membros.Count @(membros.Count == 1 ? "membro" : "membros")
    </p>
}

<ConfirmarModal Visivel="@(alternando != null)"
                Titulo="@(alternando?.AtivoUsr == true ? "Desativar acesso" : "Ativar acesso")"
                TextoConfirmar="@(alternando?.AtivoUsr == true ? "Desativar" : "Ativar")"
                Erro="@erroModal"
                OnConfirmar="ConfirmarAlternancia" OnCancelar="Fechar">
    @if (alternando?.AtivoUsr == true)
    {
        <text>
            Desativar <strong>@alternando?.NomeVisivel</strong>?<br />
            <span class="text-muted">
                As sessões abertas são encerradas na hora. O histórico de vendas e
                comissões é preservado, e o acesso pode ser reativado depois.
            </span>
        </text>
    }
    else
    {
        <text>
            Reativar <strong>@alternando?.NomeVisivel</strong>?<br />
            <span class="text-muted">A pessoa volta a entrar com a senha que já tinha.</span>
        </text>
    }
</ConfirmarModal>

<ConfirmarModal Visivel="@(excluindo != null)" Titulo="Excluir acesso"
                TextoConfirmar="Excluir" Erro="@erroModal"
                OnConfirmar="ConfirmarExclusao" OnCancelar="Fechar">
    Excluir o acesso de <strong>@excluindo?.NomeVisivel</strong>?<br />
    <span class="text-muted">
        O acesso será revogado permanentemente e esta ação não pode ser desfeita.
        O histórico de vendas, comissões e caixa continua no sistema.
        Para apenas bloquear a entrada, use <strong>Desativar</strong>.
    </span>
</ConfirmarModal>

@code {
    private List<Usuario> membros = new();
    private string busca = "";
    private bool carregando = true;

    private Usuario? alternando;
    private Usuario? excluindo;

    private string? erro;
    private string? erroModal;
    private string? aviso;

    private int? IdProprio => auth.GetUsuarioId();

    private enum Coluna { Nome, Usuario, Funcao, Status }

    private Coluna ordenarPor = Coluna.Nome;
    private bool crescente = true;

    protected override async Task OnInitializedAsync()
    {
        await auth.PrepararAsync();
        await permissao.CarregarAsync();

        Carregar();
    }

    private void Carregar()
    {
        carregando = true;
        erro = null;

        try
        {
            membros = equipeDAO.Listar();
        }
        catch (Exception ex)
        {
            erro = "Não foi possível carregar a equipe: " + ex.Message;
            membros = new();
        }
        finally
        {
            carregando = false;
        }
    }

    /// <summary>
    /// Busca e ordenacao em memoria: a equipe de uma barbearia cabe numa
    /// tela, e ir ao banco a cada tecla digitada seria desperdicio.
    /// </summary>
    private List<Usuario> Visiveis
    {
        get
        {
            var termo = Normalizar(busca);

            var filtrados = string.IsNullOrWhiteSpace(termo)
                ? membros
                : membros.Where(m =>
                    Normalizar(m.NomeVisivel).Contains(termo)
                    || Normalizar(m.NomeUsr).Contains(termo)
                    || Normalizar(m.NomeFuncao).Contains(termo)
                    || Normalizar(m.EmailUsr).Contains(termo)).ToList();

            IEnumerable<Usuario> ordenados = ordenarPor switch
            {
                Coluna.Usuario => filtrados.OrderBy(m => m.NomeUsr),
                Coluna.Funcao => filtrados.OrderBy(m => m.NomeFuncao ?? "￿"),
                Coluna.Status => filtrados.OrderByDescending(m => m.AtivoUsr)
                                          .ThenBy(m => m.NomeVisivel),
                _ => filtrados.OrderBy(m => m.NomeVisivel)
            };

            if (!crescente) ordenados = ordenados.Reverse();

            return ordenados.ToList();
        }
    }

    private void AoBuscar(ChangeEventArgs e)
    {
        busca = e.Value?.ToString() ?? "";
    }

    private void Ordenar(Coluna coluna)
    {
        if (ordenarPor == coluna)
        {
            crescente = !crescente;
            return;
        }

        ordenarPor = coluna;
        crescente = true;
    }

    private RenderFragment Cabecalho(string texto, Coluna coluna) => @<button
        type="button" class="ordenar @(ordenarPor == coluna ? "ativo" : "")"
        @onclick="() => Ordenar(coluna)"
        aria-label="Ordenar por @texto">
        @texto
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
             class="@(ordenarPor == coluna && !crescente ? "invertida" : "")">
            <path d="m6 9 6 6 6-6" />
        </svg>
    </button>;

    private void Editar(Usuario membro) =>
        Navigation.NavigateTo($"/equipe/{membro.IdUsr}");

    /// <summary>
    /// A propria linha e a da raiz nao recebem ativar/desativar/excluir:
    /// o servidor recusaria, e botao que so serve para dar erro confunde.
    /// </summary>
    private bool PodeMexer(Usuario membro) =>
        membro.IdUsr != IdProprio && !membro.RaizUsr;

    private void Fechar()
    {
        alternando = null;
        excluindo = null;
        erroModal = null;
    }

    private void ConfirmarAlternancia()
    {
        if (alternando == null) return;

        var alvo = alternando;
        var ativar = !alvo.AtivoUsr;

        try
        {
            equipeDAO.AlterarStatus(alvo.IdUsr, ativar, Autor());

            Fechar();
            aviso = ativar
                ? $"{alvo.NomeVisivel} foi reativado."
                : $"{alvo.NomeVisivel} foi desativado e as sessões dele foram encerradas.";

            Carregar();
        }
        catch (Exception ex)
        {
            erroModal = ex.Message;
        }
    }

    private void ConfirmarExclusao()
    {
        if (excluindo == null) return;

        var alvo = excluindo;

        try
        {
            equipeDAO.Excluir(alvo.IdUsr, Autor());

            Fechar();
            aviso = $"O acesso de {alvo.NomeVisivel} foi excluído.";

            Carregar();
        }
        catch (Exception ex)
        {
            erroModal = ex.Message;
        }
    }

    private Autor Autor() => new(
        IdProprio ?? 0, auth.GetUsuarioNome() ?? "", auth.EhAdmin(), auth.EhRaiz());

    /// <summary>
    /// Cor do avatar a partir do nome: a mesma pessoa tem sempre a mesma
    /// cor, sem precisar guardar nada.
    /// </summary>
    private static string Cor(Usuario membro)
    {
        var soma = membro.NomeVisivel.Sum(c => (int)c);
        var matiz = soma * 47 % 360;

        // So o matiz vai inline; a saturacao e a luminosidade ficam no CSS,
        // que as ajusta por tema -- um fundo claro fixo brilharia demais
        // sobre a superficie escura.
        return $"--matiz: {matiz}";
    }

    private static string Texto(string? valor) =>
        string.IsNullOrWhiteSpace(valor) ? "—" : valor;

    /// <summary>Busca sem diferenciar maiusculas nem acentos.</summary>
    private static string Normalizar(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return "";

        var decomposto = texto.Trim().ToLowerInvariant()
            .Normalize(System.Text.NormalizationForm.FormD);

        return new string(decomposto
            .Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c)
                != System.Globalization.UnicodeCategory.NonSpacingMark)
            .ToArray());
    }
}
