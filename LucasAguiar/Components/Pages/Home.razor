@page "/"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Politicas.Painel)]
@implements IDisposable

@using LucasAguiar.Configs
@using LucasAguiar.Models
@using LucasAguiar.Services
@using System.Text.Json
@inject PainelDAO painelDAO
@inject CaixaDAO caixaDAO
@inject Autorizacao permissao


<div class="cabecalho-painel">
    <div>
        @* Data e base de comparacao aparecem uma vez so, aqui. Antes cada
           indicador repetia "vs. periodo anterior". *@
        <span class="linha-titulo">@DataPorExtenso · @RotuloPeriodo</span>
        <h1 class="titulo-painel">Painel</h1>
    </div>

    @* ---------- filtro de periodo ---------- *@
    <div class="atalhos-periodo">
        <button type="button" class="@(periodo == 0 ? "ativo" : "")" @onclick="() => TrocarPeriodo(0)">Hoje</button>
        <button type="button" class="@(periodo == 7 ? "ativo" : "")" @onclick="() => TrocarPeriodo(7)">7 dias</button>
        <button type="button" class="@(periodo == 30 ? "ativo" : "")" @onclick="() => TrocarPeriodo(30)">30 dias</button>
        <button type="button" class="@(periodo == -1 ? "ativo" : "")" @onclick="() => TrocarPeriodo(-1)">Este mês</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(erro))
{
    <div class="alert alert-danger">@erro</div>
}

@* ---------- situação do caixa ---------- *@
<div class="faixa-caixa comanda @(caixaAberto != null ? "aberto" : "fechado")">
    @if (caixaAberto != null)
    {
        <div>
            <strong class="status aberto-caixa">
                <i></i>Caixa #@caixaAberto.IdCaixa aberto
            </strong>
            <span>desde @caixaAberto.DataAbertura.ToString("dd/MM 'às' HH:mm")</span>
        </div>

        @* O que tem na gaveta e valor, e so quem pode ver valores ve. *@
        @if (podeVerValores)
        {
            <div class="gaveta-agora">
                <span>Na gaveta</span>
                <strong>@caixaAberto.Resumo.SaldoEsperadoGaveta(caixaAberto.ValorAbertura).ToString("C")</strong>
            </div>
        }

        @if (podeVerCaixa)
        {
            <a href="/caixa" class="link-caixa">Ver caixa</a>
        }
    }
    else
    {
        <div>
            <strong>Nenhum caixa aberto</strong>
            <span>Abra o caixa para registrar vendas.</span>
        </div>

        @if (podeVerCaixa)
        {
            <a href="/caixa" class="link-caixa">Abrir caixa</a>
        }
    }
</div>


@* ---------- indicadores ----------
   Faturamento, despesa, comissao e lucro so para quem tem "Ver valores".
   Esconder apenas o menu nao bastaria: o painel e justamente onde os
   numeros do negocio aparecem todos juntos. *@
@if (podeVerValores)
{
    <div class="indicadores">
        <div class="indicador receita">
            <span class="rotulo">Receita</span>
            <strong class="valor">@resumo.Receita.ToString("C")</strong>
            <span class="detalhe">@resumo.QuantidadeVendas venda(s) · ticket @resumo.TicketMedio.ToString("C")</span>
        </div>
        <div class="indicador despesa">
            <span class="rotulo">Despesas</span>
            <strong class="valor">@resumo.Despesas.ToString("C")</strong>
            <span class="detalhe">
                @if (permissao.PodeVer("despesas"))
                {
                    <a href="/despesas">ver lançamentos</a>
                }
            </span>
        </div>
        <div class="indicador comissao">
            <span class="rotulo">Comissões</span>
            <strong class="valor">@resumo.Comissoes.ToString("C")</strong>
            <span class="detalhe">a pagar aos profissionais</span>
        </div>
        <div class="indicador @(resumo.Lucro >= 0 ? "lucro" : "prejuizo")">
            <span class="rotulo">@(resumo.Lucro >= 0 ? "Lucro" : "Prejuízo")</span>
            <strong class="valor">@resumo.Lucro.ToString("C")</strong>
            <span class="detalhe">receita − despesas − comissões</span>
        </div>
    </div>
}
else
{
    <div class="indicadores-ocultos">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9.9 5.2A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7a18 18 0 0 1-3.2 4.2M6.6 6.6A18 18 0 0 0 2 12s3.6 7 10 7a10.5 10.5 0 0 0 5.4-1.4" />
            <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2M3 3l18 18" />
        </svg>
        Os valores do período ficam visíveis para quem tem a permissão
        <strong>Ver valores</strong> no Painel.
    </div>
}

@* ---------- gráficos ---------- *@
@if (podeVerValores)
{
    <div class="painel">
        <section class="cartao cartao-barras">
            <header class="cartao-topo">
                <h2>Receita e despesas por mês</h2>
                <span class="cartao-sub">Últimos 12 meses</span>
            </header>
            <div class="area-grafico">
                <canvas id="barChart"></canvas>
            </div>
        </section>

        <section class="cartao cartao-pizza">
            <header class="cartao-topo">
                <h2>Formas de pagamento</h2>
            </header>
            <div class="area-grafico">
                <canvas id="pieChart"></canvas>
            </div>
        </section>
    </div>
}

@if (permissao.PodeVer("agendamentos"))
{
    <CalendarioAgenda />
}

@* Os dados vão para o JS por um elemento oculto, lido pelo dashboard.js.
   Sem permissao de ver valores o elemento nem existe: esconder o grafico
   e deixar os numeros no HTML nao esconderia nada. *@
@if (podeVerValores)
{
    <script id="dados-painel" type="application/json">@((MarkupString)dadosJson)</script>
}

@code {
    private PainelDAO.ResumoPainel resumo = new();
    private Caixa? caixaAberto;
    private string dadosJson = "{}";
    private string? erro;

    /// <summary>0 = hoje, 7/30 = últimos dias, -1 = mês corrente.</summary>
    private int periodo = 30;

    private (DateTime De, DateTime Ate) Intervalo
    {
        get
        {
            var hoje = DateTime.Today;
            return periodo switch
            {
                0 => (hoje, hoje.AddDays(1)),
                -1 => (new DateTime(hoje.Year, hoje.Month, 1), hoje.AddDays(1)),
                _ => (hoje.AddDays(-periodo), hoje.AddDays(1))
            };
        }
    }

    private string RotuloPeriodo => periodo switch
    {
        0 => "Hoje",
        -1 => "Este mês",
        _ => $"Últimos {periodo} dias"
    };

    /// <summary>
    /// "Quinta-feira, 15 de outubro". Fica na linha acima do titulo, que
    /// e o unico lugar onde data e periodo aparecem.
    /// </summary>
    private static string DataPorExtenso
    {
        get
        {
            var cultura = new System.Globalization.CultureInfo("pt-BR");
            var hoje = DateTime.Today;
            var dia = cultura.DateTimeFormat.GetDayName(hoje.DayOfWeek);

            return char.ToUpper(dia[0], cultura) + dia[1..]
                 + hoje.ToString(", d 'de' MMMM", cultura);
        }
    }

    private bool podeVerValores;
    private bool podeVerCaixa;

    protected override async Task OnInitializedAsync()
    {
        await permissao.CarregarAsync();

        podeVerValores = permissao.Pode("painel", Acao.VerValores);
        podeVerCaixa = permissao.PodeVer("caixa");

        Carregar();
    }

    /// <summary>
    /// Relogio que repoe os numeros enquanto a tela fica aberta.
    ///
    /// Carregar() so rodava no OnInitialized: com o painel aberto numa TV
    /// do salao, ou em outra aba enquanto alguem lanca uma venda, os
    /// valores congelavam ate recarregar a pagina.
    /// </summary>
    private PeriodicTimer? relogio;

    protected override async Task OnAfterRenderAsync(bool primeiraVez)
    {
        if (!primeiraVez) return;

        relogio = new PeriodicTimer(TimeSpan.FromSeconds(60));

        // Sem await no laco: ele vive enquanto a tela existir e termina
        // quando o Dispose descarta o relogio.
        while (await relogio.WaitForNextTickAsync())
        {
            Carregar();
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => relogio?.Dispose();

    private void TrocarPeriodo(int novo)
    {
        periodo = novo;
        Carregar();
    }

    private void Carregar()
    {
        try
        {
            erro = null;

            var (de, ate) = Intervalo;
            resumo = painelDAO.Resumo(de, ate);
            caixaAberto = caixaDAO.BuscarAberto();

            var serie = painelDAO.SerieMensal();
            var formas = painelDAO.PorFormaPagamento(de, ate);

            dadosJson = JsonSerializer.Serialize(new
            {
                meses = serie.Select(s => s.Mes).ToArray(),
                receitas = serie.Select(s => s.Receita).ToArray(),
                despesas = serie.Select(s => s.Despesa).ToArray(),
                formasRotulos = formas.Keys.Select(FormaPagamento.Rotulo).ToArray(),
                formasValores = formas.Values.ToArray()
            });
        }
        catch (Exception ex)
        {
            erro = "Erro ao carregar o painel: " + ex.Message;
            dadosJson = "{}";
        }
    }
}
