@page "/produto/{Id:int}/editar"
@rendermode InteractiveServer

@using LucasAguiar.Models;
@inject ProdutoDAO produtoDAO;
@inject NavigationManager Navigation;

<PageTitle>Produtos</PageTitle>

<h1>Atualização Produto - @produto.NomeProduto</h1>

@if (erro != string.Empty)
{
  <div class="alert alert-danger" role="alert">
    <strong>Erro!</strong>
    <span>@erro</span>
  </div>
}

<EditForm Model="produto" OnSubmit="Salvar">
  <div class="mb-4">
    <label for="nome" class="form-label">Nome</label>
    <input @bind-value="produto.NomeProduto" type="text" id="nome"
      class="form-control" />
  </div>
  <div class="mb-4">
    <label for="quantidade" class="form-label">Quantidade</label>
    <input @bind-value="produto.Quantidade" type="number" id="quantidade"
      class="form-control" />
  </div>
  <div class="mb-4">
    <label for="valor" class="form-label">Valor</label>
    <input @bind-value="produto.Valor" type="text" id="valor"
      class="form-control" />
  </div>
  <div class="mb-4">
    <label for="descricao" class="form-label">Descrição</label>
    <textarea @bind="produto.Descricao" id="descricao" rows="3"
      class="form-control"></textarea>
  </div>


  <button type="submit" class="btn btn-primary">Salvar</button>
  <a href="/produto" class="btn btn-outline-secondary ms-2">Cancelar</a>
</EditForm>

@code {

  private string erro = string.Empty;

  [Parameter]
  public int Id { get; set; }

  [SupplyParameterFromForm]
  private Produto produto { get; set; } = new();

  protected override void OnInitialized()
  {
    var _produto = produtoDAO.BuscarPorId(Id);

    if (_produto != null)
    {
      produto = _produto;
    }
    else
    {
      erro = "Produto não encontrado.";
    }
  }

  private void Salvar()
  {
    try
    {
      produtoDAO.Atualizar(produto);

      Navigation.NavigateTo("/produto");
    }
    catch (Exception ex)
    {
      erro = $"Erro ao salvar o produto: {ex.Message}";
    }

  }
}
