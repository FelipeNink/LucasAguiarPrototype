@page "/produto"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Politicas.Produtos)]

@using LucasAguiar.Models
@using LucasAguiar.Configs
@inject ProdutoDAO produtoDAO
@inject FornecedorDAO fornecedorDAO


<h1>Lista de Produtos</h1>

<div class="barra-acoes">
    <NavLink href="/produto/novo" class="btn-novo">Novo Produto</NavLink>
    <a href="/relatorio/produtos" class="btn-pdf" data-enhance-nav="false">Relatório PDF</a>
    <a href="/excel/produtos" class="btn-pdf" data-enhance-nav="false">Excel</a>
</div>

@* ---------- filtros ---------- *@
<section class="filtros">
    <div class="campo campo-largo">
        <label>Nome ou código</label>
        <input class="form-control" placeholder="Buscar produto" @bind="busca" @bind:event="oninput" />
    </div>
    <div class="campo">
        <label>Marca</label>
        <Seletor TItem="Opcao" TValor="string" Itens="OpcoesMarca"
                 @bind-Valor="marca" TextoDe="o => o.Rotulo" ValorDe="o => o.Valor" />
    </div>
    <div class="campo">
        <label>Fornecedor</label>
        <Seletor TItem="OpcaoId" TValor="int" Itens="OpcoesFiltroFornecedor"
                 @bind-Valor="idFornecedor" TextoDe="o => o.Rotulo" ValorDe="o => o.Id" />
    </div>
    <div class="campo">
        <label>Estoque</label>
        <Seletor TItem="Opcao" TValor="string" Itens="OpcoesEstoque"
                 @bind-Valor="estoque" TextoDe="o => o.Rotulo" ValorDe="o => o.Valor"
                 PontoDe="o => o.Cor" />
    </div>
    <div class="campo-acoes">
        <button type="button" class="btn btn-outline-secondary" @onclick="Limpar">Limpar</button>
    </div>
</section>

@* ---------- resumo ---------- *@
<div class="resumo">
    <div class="cartao-resumo">
        <span class="rotulo">Itens</span>
        <strong class="valor">@Filtrados.Count</strong>
    </div>
    <div class="cartao-resumo prejuizo">
        <span class="rotulo">Zerados</span>
        <strong class="valor">@Filtrados.Count(p => p.Quantidade <= 0)</strong>
    </div>
    @* Sem custo cadastrado ainda: o estoque sai a preço de venda. *@
    <div class="cartao-resumo">
        <span class="rotulo">Estoque a preço de venda</span>
        <strong class="valor">@Filtrados.Sum(p => (decimal)p.Valor * Math.Max(p.Quantidade, 0)).ToString("C")</strong>
    </div>
</div>

<div class="tabela fixa">
    <table class="table table-striped">
    <thead>
        <tr>
            <th class="col-id">Código</th>
            <th>Nome</th>
            <th class="opcional">Marca</th>
            <th class="al-dir">Estoque</th>
            <th class="al-dir">Preço de venda</th>
            <th class="col-acoes">Ações</th>
        </tr>
    </thead>
    <tbody>
        @if (Filtrados.Any())
        {
            foreach (var produto in Filtrados)
            {
                <tr>
                    <td>@produto.IdProduto</td>
                    <td>@produto.NomeProduto</td>
                    <td class="opcional">@Valor(produto.Marca)</td>
                    <td class="al-dir">
                        @if (produto.Quantidade <= 0)
                        {
                            <span class="status erro"><i></i>@produto.Quantidade</span>
                        }
                        else
                        {
                            @produto.Quantidade
                        }
                    </td>
                    <td class="al-dir">@produto.Valor.ToString("C")</td>

                    <td class="col-acoes">
                        <AcoesLinha OnVisualizar="() => visualizando = produto"
                                    OnEditar="() => Editar(produto)"
                                    OnExcluir="() => excluindo = produto" />
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Nenhum produto encontrado.</td>
            </tr>
        }
    </tbody>
    </table>
</div>

<ConfirmarModal Visivel="@(excluindo != null)" Titulo="Excluir produto" Erro="@erroExclusao"
                OnConfirmar="ConfirmarExclusao" OnCancelar="CancelarExclusao">
    Tem certeza que deseja excluir <strong>@excluindo?.NomeProduto</strong>?<br />
    <span class="text-muted">Esta ação não pode ser desfeita.</span>
</ConfirmarModal>

<Janela Visivel="@(visualizando != null)" Titulo="@(visualizando?.NomeProduto ?? "Produto")"
        OnFechar="Fechar">
    <ChildContent>
        @if (visualizando != null)
        {
            <dl class="ficha">
                <div><dt>Valor</dt><dd>@visualizando.Valor.ToString("C")</dd></div>
                <div><dt>Estoque</dt><dd>@visualizando.Quantidade</dd></div>
                <div><dt>Marca</dt><dd>@Valor(visualizando.Marca)</dd></div>
                <div><dt>Fornecedor</dt><dd>@Valor(visualizando.NomeFornecedor)</dd></div>
                <div class="largo"><dt>Descrição</dt><dd>@Valor(visualizando.Descricao)</dd></div>
            </dl>
        }
    </ChildContent>
    <Rodape>
        <button type="button" class="btn btn-outline-secondary" @onclick="Fechar">Fechar</button>
        <button type="button" class="btn btn-primary" @onclick="() => Editar(visualizando!)">Editar</button>
    </Rodape>
</Janela>

<Janela Visivel="@(editando != null)" Titulo="Editar produto" Erro="@erroModal" OnFechar="Fechar">
    <ChildContent>
        @if (editando != null)
        {
            <div class="grade-campos">
                <div class="largo">
                    <label class="form-label">Nome</label>
                    <input class="form-control" @bind="editando.NomeProduto" />
                </div>
                <div>
                    <label class="form-label">Quantidade</label>
                    <input type="number" class="form-control" @bind="editando.Quantidade" />
                </div>
                <div>
                    <label class="form-label">Valor</label>
                    <input type="number" step="0.01" min="0" class="form-control" @bind="editando.Valor" />
                </div>
                <div>
                    <label class="form-label">Marca</label>
                    <input class="form-control" @bind="editando.Marca" />
                </div>
                <div>
                    <label class="form-label">Fornecedor</label>
                    <Seletor TItem="OpcaoId" TValor="int" Itens="OpcoesFornecedor"
                             @bind-Valor="editando.IdFornecedor" TextoDe="o => o.Rotulo"
                             ValorDe="o => o.Id" Placeholder="Selecione" Class="mb-3" />
                </div>
                <div class="largo">
                    <label class="form-label">Descrição</label>
                    <textarea class="form-control" rows="3" @bind="editando.Descricao"></textarea>
                </div>
            </div>
        }
    </ChildContent>
    <Rodape>
        <button type="button" class="btn btn-outline-secondary" @onclick="Fechar">Cancelar</button>
        <button type="button" class="btn btn-primary" @onclick="Salvar">Salvar</button>
    </Rodape>
</Janela>

@code {
    private Produto? excluindo;
    private string? erroExclusao;

    private void ConfirmarExclusao()
    {
        if (excluindo == null) return;

        try
        {
            produtoDAO.Excluir(excluindo.IdProduto);
            excluindo = null;
            erroExclusao = null;
            listaProdutos = produtoDAO.ListarTodos();
        }
        catch (Exception ex)
        {
            erroExclusao = ex.Message;
        }
    }

    private void CancelarExclusao()
    {
        excluindo = null;
        erroExclusao = null;
    }

    private List<Produto> listaProdutos = new();
    private List<Fornecedor> fornecedores = new();

    private Produto? visualizando;
    private Produto? editando;
    private string? erroModal;

    private List<OpcaoId> OpcoesFornecedor =>
        fornecedores.Select(f => new OpcaoId(f.IdFornecedor, f.NomeFornecedor ?? "Sem nome")).ToList();

    // Filtros. A lista de cadastro e pequena: filtra em memoria, sem
    // voltar ao banco a cada tecla.
    private string busca = "";
    private string marca = "";
    private int idFornecedor;
    private string estoque = "";

    private List<Produto> Filtrados =>
        listaProdutos
            .Where(p => string.IsNullOrWhiteSpace(busca)
                        || (p.NomeProduto ?? "").Contains(busca.Trim(), StringComparison.OrdinalIgnoreCase)
                        || p.IdProduto.ToString() == busca.Trim())
            .Where(p => marca == "" || string.Equals(p.Marca, marca, StringComparison.OrdinalIgnoreCase))
            .Where(p => idFornecedor == 0 || p.IdFornecedor == idFornecedor)
            .Where(p => estoque switch
            {
                "ZERADO" => p.Quantidade <= 0,
                "COM" => p.Quantidade > 0,
                _ => true
            })
            .ToList();

    private List<Opcao> OpcoesMarca =>
        new List<Opcao> { new("", "Todas") }
            .Concat(listaProdutos
                .Select(p => p.Marca?.Trim())
                .Where(m => !string.IsNullOrWhiteSpace(m))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(m => m)
                .Select(m => new Opcao(m!, m!)))
            .ToList();

    private List<OpcaoId> OpcoesFiltroFornecedor =>
        new List<OpcaoId> { new(0, "Todos") }.Concat(OpcoesFornecedor).ToList();

    private static readonly List<Opcao> OpcoesEstoque = new()
    {
        new("", "Todos"),
        new("COM", "Com estoque", "var(--ok)"),
        new("ZERADO", "Zerado", "var(--perigo)")
    };

    private void Limpar()
    {
        busca = "";
        marca = "";
        idFornecedor = 0;
        estoque = "";
    }

    protected override void OnInitialized()
    {
        listaProdutos = produtoDAO.ListarTodos();

        try { fornecedores = fornecedorDAO.ListarTodos(); }
        catch { /* o filtro fica so com "Todos"; o Editar tenta de novo */ }
    }

    private static string Valor(string? texto) =>
        string.IsNullOrWhiteSpace(texto) ? "—" : texto;

    /// <summary>Edita uma copia: cancelar o modal nao pode alterar a linha da tabela.</summary>
    private void Editar(Produto p)
    {
        visualizando = null;
        erroModal = null;

        try { if (fornecedores.Count == 0) fornecedores = fornecedorDAO.ListarTodos(); }
        catch (Exception ex) { erroModal = ex.Message; }

        editando = new Produto
        {
            IdProduto = p.IdProduto,
            NomeProduto = p.NomeProduto,
            Quantidade = p.Quantidade,
            Valor = p.Valor,
            Descricao = p.Descricao,
            Marca = p.Marca,
            IdFornecedor = p.IdFornecedor
        };
    }

    private void Fechar()
    {
        visualizando = null;
        editando = null;
        erroModal = null;
    }

    private void Salvar()
    {
        if (editando == null) return;

        try
        {
            if (string.IsNullOrWhiteSpace(editando.NomeProduto))
                throw new Exception("O nome do produto é obrigatório.");

            produtoDAO.Atualizar(editando);
            Fechar();
            listaProdutos = produtoDAO.ListarTodos();
        }
        catch (Exception ex)
        {
            erroModal = $"Erro ao salvar o produto: {ex.Message}";
        }
    }
}
