@page "/produto/{Id:int}/excluir"
@rendermode InteractiveServer

@using LucasAguiar.Models;
@inject ProdutoDAO produtoDAO;
@inject NavigationManager Navigation;

<TelaExclusao Entidade="produto" Nome="@produto?.NomeProduto" Voltar="/produto"
              Aviso="Planos que incluem este produto passam a mostrá-lo como item removido."
              Encontrado="@(produto != null)" Erro="@erro" OnConfirmar="Excluir" />

@code {

  private string? erro;

  [Parameter]
  public int Id { get; set; }

  private Produto? produto;

  protected override void OnInitialized()
  {
    produto = produtoDAO.BuscarPorId(Id);

    if (produto == null)
    {
      erro = "Produto não encontrado.";
    }
  }

  private void Excluir()
  {
    try
    {
      produtoDAO.Excluir(Id);

      Navigation.NavigateTo("/produto");
    }
    catch (Exception ex)
    {
      erro = $"Erro ao excluir o produto: {ex.Message}";
    }

  }
}
