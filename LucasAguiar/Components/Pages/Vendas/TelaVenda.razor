@* Tela da venda, a mesma para registrar e editar (IdVendaEdicao). Na
   edicao, so venda de caixa aberto e comissao nao paga chega aqui
   (VendaDAO.SituacaoParaEditar); a listagem resolve os outros casos. *@

@using LucasAguiar.Models
@inject ClienteDAO clienteDAO
@inject PlanoDAO planoDAO
@inject ServicoDAO servicoDAO
@inject ProdutoDAO produtoDAO
@inject FuncionarioDAO funcionarioDAO
@inject VendaDAO vendaDAO
@inject AssinaturaDAO assinaturaDAO
@inject CaixaDAO caixaDAO
@inject AgendamentoDAO agendamentoDAO
@inject LucasAguiar.Services.AuthenticationService auth
@inject NavigationManager Navigation


<TopoForm Titulo="@(Editando ? $"Editar venda #{IdVendaEdicao}" : "Nova venda")" Voltar="/vendas" RotuloVoltar="Vendas" />

@if (!string.IsNullOrEmpty(erro))
{
    <div class="alert alert-danger">@erro</div>
}

@if (bloqueada)
{
    <p><a href="/vendas">Voltar para as vendas</a></p>
}
else
{
@if (caixaAberto == null && !Editando)
{
    <div class="sem-caixa">
        <div>
            <strong>Nenhum caixa aberto</strong>
            <span>A venda precisa de um caixa aberto para o dinheiro ser conferido no fechamento.</span>
        </div>
        <div class="abrir-aqui">
            <input type="number" step="0.01" min="0" class="form-control"
                   placeholder="Saldo inicial" @bind="valorAberturaCaixa" />
            <button type="button" class="btn btn-primary" @onclick="AbrirCaixa">Abrir caixa</button>
        </div>
    </div>
}

<div class="venda">

    <div class="coluna-esquerda">

        @* ================= CLIENTE E AGENDAMENTO ================= *@
        <section class="bloco">
            <div class="bloco-topo">
                <h2 class="bloco-titulo">
                    <svg class="icone-titulo" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" /></svg>
                    Cliente e agendamento
                </h2>
                @if (clienteSelecionado == null && !semCliente)
                {
                    <div class="acoes-cliente">
                        <button type="button" class="chip-acao" @onclick="UsarSemCliente">Venda sem cliente</button>
                        <button type="button" class="chip-acao destaque"
                                @onclick="() => modalAberto = CadastroRapido.TipoCadastro.Cliente">+ Novo cliente</button>
                    </div>
                }
            </div>

            @if (clienteSelecionado == null && !semCliente)
            {
                <div class="busca-cliente">
                    <svg class="icone-busca" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>
                    <input class="form-control busca" placeholder="Buscar por nome, telefone, CPF ou escolher um agendamento de hoje…"
                           @bind="termoBusca" @bind:event="oninput" @bind:after="BuscarClientes"
                           @onfocus="() => buscaAberta = true" @onblur="() => buscaAberta = false" />

                    @if (buscaAberta || termoBusca.Trim().Length >= 2)
                    {
                        <div class="lista-busca">
                            @if (!Editando && AgendamentosDaBusca.Count > 0)
                            {
                                <div class="lista-busca-titulo">
                                    <span>Agendamentos de hoje</span>
                                    <span class="destaque">Clique para trazer para a venda</span>
                                </div>
                                @foreach (var a in AgendamentosDaBusca)
                                {
                                    <button type="button" class="resultado"
                                            @onmousedown="() => ImportarAgendamento(a)" @onmousedown:preventDefault="true">
                                        <span>
                                            <span class="resultado-nome">@(a.NomeCliente ?? "Sem cliente")</span>
                                            <span class="resultado-info">@(a.NomeServico ?? "—") · @(a.NomeFuncionario ?? "—")</span>
                                        </span>
                                        <span class="hora-agendada">@a.DataHora.ToString("HH:mm")</span>
                                    </button>
                                }
                            }

                            @if (resultados.Count > 0)
                            {
                                <div class="lista-busca-titulo"><span>Clientes</span></div>
                                @foreach (var c in resultados)
                                {
                                    <button type="button" class="resultado"
                                            @onmousedown="() => SelecionarCliente(c.IdCliente)" @onmousedown:preventDefault="true">
                                        <span>
                                            <span class="resultado-nome">@c.NomeCliente</span>
                                            <span class="resultado-info">
                                                @(string.IsNullOrWhiteSpace(c.Telefone) ? "sem telefone" : c.Telefone)
                                                @if (c.TemPlano)
                                                {
                                                    <span class="etiqueta-plano">@c.NomePlano</span>
                                                }
                                            </span>
                                        </span>
                                        <span class="selecionar">Selecionar</span>
                                    </button>
                                }
                            }
                            else if (termoBusca.Trim().Length >= 2)
                            {
                                <div class="sem-resultado">
                                    Nenhum cliente com "@termoBusca".
                                    <button type="button" class="btn btn-primary btn-sm"
                                            @onmousedown="CadastrarComTermo" @onmousedown:preventDefault="true">
                                        Cadastrar "@termoBusca"
                                    </button>
                                </div>
                            }
                            else if (Editando || AgendamentosDaBusca.Count == 0)
                            {
                                <div class="lista-busca-vazia">Digite ao menos 2 letras para buscar o cliente.</div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="cliente-escolhido">
                    <span class="avatar-cliente">@Iniciais(clienteSelecionado?.NomeCliente)</span>
                    <div class="cliente-dados">
                        <div class="cliente-linha">
                            <strong>@(clienteSelecionado?.NomeCliente ?? "Venda sem cliente")</strong>
                            @if (agendamentoImportado != null)
                            {
                                <span class="selo-agendado">Agendado @agendamentoImportado.DataHora.ToString("HH:mm")</span>
                            }
                        </div>
                        <span class="cliente-detalhe">
                            @if (clienteSelecionado == null)
                            {
                                <text>Venda rápida no balcão</text>
                            }
                            else
                            {
                                @(string.IsNullOrWhiteSpace(clienteSelecionado.Telefone) ? "sem telefone" : clienteSelecionado.Telefone)
                                @if (AssinaturasComCredito.Count > 0)
                                {
                                    <text> · @TotalCreditos crédito(s) de plano</text>
                                }
                            }
                        </span>
                    </div>
                    <button type="button" class="remover" title="Trocar cliente" @onclick="TrocarCliente">×</button>
                </div>

                @* --- planos do cliente: varios podem conviver --- *@
                @if (AssinaturasComCredito.Count > 0)
                {
                    <div class="planos-ativos">
                        <div class="planos-cabecalho">
                            <strong>
                                @AssinaturasComCredito.Count
                                @(AssinaturasComCredito.Count == 1 ? "plano ativo" : "planos ativos")
                            </strong>
                            <span>@TotalCreditos crédito(s) disponíveis</span>
                        </div>

                        @foreach (var a in AssinaturasComCredito)
                        {
                            <div class="plano-cartao">
                                <div class="plano-cabecalho">
                                    <strong>@a.NomePlano</strong>
                                    <span class="validade">@a.ValidadeTexto</span>
                                </div>

                                <ul class="lista-creditos">
                                    @foreach (var saldo in a.Saldos)
                                    {
                                        <li class="@(saldo.Restante == 0 ? "esgotado" : "")">
                                            <div class="credito-info">
                                                <span class="credito-nome">@saldo.Descricao</span>
                                                @{
                                                    var naVenda = JaUsados(saldo);
                                                }
                                                <span class="credito-saldo">
                                                    <strong>@saldo.Restante</strong> de @saldo.QuantidadeTotal restantes
                                                    @if (naVenda > 0)
                                                    {
                                                        <span class="credito-usando">
                                                            −@naVenda nesta venda → fica @(saldo.Restante - naVenda)
                                                        </span>
                                                    }
                                                </span>
                                            </div>

                                            @if (saldo.Restante > 0)
                                            {
                                                <button type="button" class="btn-baixa"
                                                        disabled="@(JaUsados(saldo) >= saldo.Restante)"
                                                        title="Usar 1 @saldo.Descricao nesta venda"
                                                        @onclick="() => UsarCredito(saldo)">
                                                    <svg viewBox="0 0 16 16" aria-hidden="true">
                                                        <path d="M3.5 8a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 0 1H4a.5.5 0 0 1-.5-.5" />
                                                    </svg>
                                                    <span class="sr">Usar crédito</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="etiqueta-esgotado">esgotado</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                }

                @* --- assinaturas sem credito, para renovar --- *@
                @if (AssinaturasEsgotadas.Count > 0 && !Editando)
                {
                    @foreach (var a in AssinaturasEsgotadas)
                    {
                        <div class="plano-esgotado">
                            <div>
                                <strong>@a.NomePlano</strong>
                                <span>
                                    @(a.Vencida
                                        ? $"venceu em {a.DataFim!.Value:dd/MM/yyyy}"
                                        : "créditos esgotados")
                                </span>
                            </div>
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    disabled="@PlanoJaNaVenda"
                                    @onclick="() => RenovarPlano(a.IdPlano)">
                                Renovar
                            </button>
                        </div>
                    }
                }

                @* --- venda de plano --- *@
                @if (planos.Count > 0 && !Editando && clienteSelecionado != null)
                {
                    <div class="vender-plano">
                        <span class="vender-plano-titulo">
                            @(AssinaturasComCredito.Count > 0 ? "Vender outro plano" : "Vender plano")
                        </span>

                        <div class="grade-planos">
                            @foreach (var p in planos.Where(p => p.Ativo))
                            {
                                <button type="button" class="cartao-plano"
                                        disabled="@PlanoJaNaVenda"
                                        @onclick="() => VenderPlano(p)">
                                    <span class="plano-nome">@p.NomePlano</span>
                                    <span class="plano-valor">@(((decimal)(p.Valor ?? 0)).ToString("C"))</span>
                                    @if (p.TotalItens > 0)
                                    {
                                        <span class="plano-creditos">@p.TotalItens crédito(s)</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                }
            }
        </section>

        @* ================= ADICIONAR ITENS ================= *@
        <section class="bloco">
            <div class="bloco-topo">
                <h2 class="bloco-titulo">
                    Adicionar itens
                    <span class="bloco-dica">clique para pôr na venda</span>
                </h2>
                <div class="filtro">
                    <svg class="icone-busca" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>
                    <input class="form-control" placeholder="Filtrar serviço ou produto…"
                           @bind="filtroCatalogo" @bind:event="oninput" />
                </div>
            </div>

            <div class="categorias">
                @foreach (var c in Categorias)
                {
                    <button type="button" class="categoria @(categoria == c.Valor ? "ativa" : "")"
                            @onclick="() => categoria = c.Valor">
                        @c.Rotulo
                    </button>
                }
            </div>

            @if (ServicosFiltrados.Count > 0 || ProdutosFiltrados.Count > 0)
            {
                <div class="pilulas">
                    @foreach (var s in ServicosFiltrados)
                    {
                        <button type="button" class="pilula" @onclick="() => AdicionarServico(s)">
                            <svg class="icone-pilula" viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="6" r="3" /><circle cx="6" cy="18" r="3" /><path d="M20 4L8.1 15.9M14.5 14.5L20 20M8.1 8.1L12 12" /></svg>
                            <span>@s.NomeServico</span>
                            <strong>@PrecoDe(s, idFuncionario).ToString("C")</strong>
                            @if (QuantidadeNaNota(TipoItem.Servico, s.IdServico) > 0)
                            {
                                <span class="item-badge">@QuantidadeNaNota(TipoItem.Servico, s.IdServico)</span>
                            }
                        </button>
                    }
                    @foreach (var p in ProdutosFiltrados)
                    {
                        <button type="button" class="pilula" @onclick="() => AdicionarProduto(p)"
                                title="@p.Quantidade em estoque">
                            <svg class="icone-pilula" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10" /></svg>
                            <span>@p.NomeProduto</span>
                            <strong>@p.Valor.ToString("C")</strong>
                            <span class="item-estoque @(p.Quantidade <= 0 ? "zerado" : "")">@p.Quantidade un</span>
                            @if (QuantidadeNaNota(TipoItem.Produto, p.IdProduto) > 0)
                            {
                                <span class="item-badge">@QuantidadeNaNota(TipoItem.Produto, p.IdProduto)</span>
                            }
                        </button>
                    }
                </div>
            }
            else
            {
                <p class="vazio-catalogo">
                    @(servicos.Count + produtos.Count == 0
                        ? "Nenhum serviço ou produto cadastrado."
                        : string.IsNullOrWhiteSpace(filtroCatalogo) ? "Nenhum item nesta categoria." : $"Nenhum item com \"{filtroCatalogo}\".")
                </p>
            }

            <div class="cadastrar-itens">
                <button type="button" class="acao-campo" @onclick="() => modalAberto = CadastroRapido.TipoCadastro.Servico">
                    + Cadastrar serviço
                </button>
                <button type="button" class="acao-campo" @onclick="() => modalAberto = CadastroRapido.TipoCadastro.Produto">
                    + Cadastrar produto
                </button>
            </div>
        </section>

        @* ================= ITENS DA VENDA ================= *@
        <section class="bloco itens-venda">
            <div class="itens-topo">
                <h2>
                    <svg class="icone-titulo" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11M4 6l1 1 2-2M4 12l1 1 2-2M4 18l1 1 2-2" /></svg>
                    Itens da venda
                </h2>
                <span class="contagem-itens">@itens.Sum(i => i.Quantidade) @(itens.Sum(i => i.Quantidade) == 1 ? "item" : "itens")</span>
            </div>

            @if (itens.Count == 0)
            {
                <div class="itens-vazio">
                    <strong>A comanda está vazia</strong>
                    <span>Clique num serviço ou produto acima para começar a venda.</span>
                </div>
            }
            else
            {
                <div class="tabela-itens">
                    <table>
                        <thead>
                            <tr>
                                <th>Item / serviço</th>
                                <th>Profissional</th>
                                <th class="centro">Qtd</th>
                                <th class="dir">Unitário</th>
                                <th class="dir">Desconto</th>
                                <th class="dir">Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in itens)
                            {
                                <tr>
                                    <td>
                                        <span class="item-nome">@item.Descricao</span>
                                        <span class="item-tipo">
                                            @item.RotuloTipo
                                            @if (item.CobertoPlano)
                                            {
                                                <span class="selo-plano">plano</span>
                                            }
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.TipoItem != TipoItem.Plano)
                                        {
                                            <select class="form-select form-select-sm" aria-label="Profissional do item"
                                                    @onchange="e => TrocarProfissionalDoItem(item, e)">
                                                <option value="0" selected="@(item.IdFuncionario is not > 0)">Profissional da venda</option>
                                                @foreach (var f in ProfissionaisDisponiveis)
                                                {
                                                    <option value="@f.IdFuncionario" selected="@(item.IdFuncionario == f.IdFuncionario)">@f.NomeFuncionario</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <span class="suave">—</span>
                                        }
                                    </td>
                                    <td class="centro">
                                        <div class="contador pequeno">
                                            <button type="button" @onclick="() => AjustarQuantidade(item, -1)">−</button>
                                            <span>@item.Quantidade</span>
                                            <button type="button" @onclick="() => AjustarQuantidade(item, 1)">+</button>
                                        </div>
                                    </td>
                                    <td class="dir">
                                        @if (item.CobertoPlano)
                                        {
                                            <span class="riscado">@item.ValorReferencia.ToString("C")</span>
                                        }
                                        else if (item.TipoItem == TipoItem.Plano)
                                        {
                                            @item.ValorUnitario.ToString("C")
                                        }
                                        else
                                        {
                                            <div class="campo-valor">
                                                <InputMoeda Valor="item.ValorUnitario" ValorChanged="v => AlterarPreco(item, v)" />
                                            </div>
                                        }
                                    </td>
                                    <td class="dir">
                                        @if (item.CobertoPlano || item.TipoItem == TipoItem.Plano)
                                        {
                                            <span class="suave">—</span>
                                        }
                                        else
                                        {
                                            <div class="campo-valor">
                                                <InputMoeda Valor="item.Desconto" ValorChanged="v => AlterarDesconto(item, v)" />
                                            </div>
                                        }
                                    </td>
                                    <td class="dir subtotal-item">
                                        @(item.CobertoPlano ? "grátis" : item.ValorTotal.ToString("C"))
                                    </td>
                                    <td class="centro">
                                        <button type="button" class="remover" title="Remover"
                                                @onclick="() => RemoverItem(item)">×</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="itens-rodape">
                @if (itens.Count > 0)
                {
                    @if (confirmandoLimpeza)
                    {
                        <span class="limpar-confirmar">
                            Tirar todos os itens?
                            <button type="button" class="limpar" @onclick="LimparItens">Sim, limpar</button>
                            <button type="button" class="acao-campo" @onclick="() => confirmandoLimpeza = false">Não</button>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="limpar" @onclick="() => confirmandoLimpeza = true">Limpar lista</button>
                    }
                }
                else
                {
                    <span></span>
                }
                <div class="somas">
                    <span>Soma dos serviços: <strong>@SomaDo(TipoItem.Servico).ToString("C")</strong></span>
                    <span>Soma dos produtos: <strong>@SomaDo(TipoItem.Produto).ToString("C")</strong></span>
                    @if (PlanoJaNaVenda)
                    {
                        <span>Plano: <strong>@SomaDo(TipoItem.Plano).ToString("C")</strong></span>
                    }
                </div>
            </div>
        </section>
    </div>

    @* ================= FECHAMENTO ================= *@
    <aside class="fechamento">
        <div class="fechamento-topo">
            <div>
                <span class="fechamento-marca">Comanda · @(Editando ? dataVenda : DateTime.Now).ToString("dd/MM/yyyy HH:mm")</span>
                <h2>@(Editando ? $"Venda #{IdVendaEdicao}" : "Fechamento da venda")</h2>
            </div>
            <svg class="icone-caixa" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="10" width="18" height="10" rx="2" /><path d="M7 10V5h10v5M7 14h2M11 14h2M15 14h2M7 17h10" /></svg>
        </div>

        <div class="fechamento-corpo">
            <div class="resumo-valores">
                <div class="linha"><span>Subtotal</span><strong>@Subtotal.ToString("C")</strong></div>
                @if (EconomiaPlano > 0)
                {
                    <div class="linha economia"><span>Crédito do plano</span><span>− @EconomiaPlano.ToString("C")</span></div>
                }
                <div class="linha linha-desconto">
                    <label for="venda-desconto">Desconto na venda <span class="suave">(R$)</span></label>
                    <span class="campo-desconto">
                        <span class="suave">− R$</span>
                        <input id="venda-desconto" type="number" step="0.01" min="0" max="@Subtotal" class="form-control"
                               disabled="@(itens.Count == 0)"
                               @bind="desconto" @bind:event="oninput" />
                    </span>
                </div>
                @if (desconto > Subtotal && itens.Count > 0)
                {
                    <span class="aviso-desconto">Limitado ao subtotal de @Subtotal.ToString("C")</span>
                }
                <div class="linha comissao">
                    <span>Comissão estimada dos profissionais</span>
                    <span>@ComissaoTotal.ToString("C")</span>
                </div>
                <div class="linha total">
                    <span>Total a pagar</span>
                    <strong>@Total.ToString("C")</strong>
                </div>
            </div>

            <div>
                <label class="rotulo">Profissional da venda <span class="obrigatorio">*</span></label>
                <Seletor TItem="Funcionario" TValor="int"
                         Itens="ProfissionaisDisponiveis"
                         Valor="idFuncionario" ValorChanged="EscolherProfissional"
                         TextoDe="@(f => f.NomeFuncionario ?? "Sem nome")"
                         ValorDe="@(f => f.IdFuncionario)"
                         ComAvatar="true"
                         Placeholder="Selecione…"
                         Class="seletor-profissional" />
                <button type="button" class="acao-campo"
                        @onclick="() => modalAberto = CadastroRapido.TipoCadastro.Funcionario">
                    + Cadastrar profissional
                </button>
            </div>

            @if (TudoPeloPlano)
            {
                <div class="pago-plano">
                    <strong>Pago com crédito do plano</strong>
                    <span>Nada a cobrar — o valor entrou na compra do plano.</span>
                </div>
            }
            else
            {
                <div>
                    <label class="rotulo">@(dividido ? "Adicionar forma de pagamento" : "Forma de pagamento")</label>
                    <div class="formas">
                        @foreach (var f in FormaPagamento.Todas)
                        {
                            <button type="button" class="forma forma-@f.Valor.ToLowerInvariant() @(pagamentos.Any(p => p.Forma == f.Valor) ? "ativa" : "")"
                                    @onclick="() => EscolherForma(f.Valor)">
                                <span class="forma-icone">@SiglaDaForma(f.Valor)</span>
                                <span class="forma-texto">
                                    <strong>@f.Rotulo</strong>
                                    <small>@DicaDaForma(f.Valor)</small>
                                </span>
                            </button>
                        }
                        <button type="button" class="forma forma-multiplo @(dividido ? "ativa" : "")"
                                disabled="@(itens.Count == 0)" @onclick="AlternarDivisao">
                            <span class="forma-icone">½</span>
                            <span class="forma-texto">
                                <strong>Múltiplo</strong>
                                <small>Dividir em mais de uma forma</small>
                            </span>
                        </button>
                    </div>
                </div>

                @if (dividido)
                {
                    <div class="detalhe-pagamento">
                        <ul class="pagamentos">
