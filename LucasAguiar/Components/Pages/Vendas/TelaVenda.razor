@code {
    private string? erro;

    /// <summary>Agendamento que originou a venda: ao confirmar, ele fica concluído.</summary>
    [Parameter] public int? IdAgendamento { get; set; }

    /// <summary>Venda aberta para edicao; nulo e venda nova.</summary>
    [Parameter] public int? IdVendaEdicao { get; set; }

    private bool Editando => IdVendaEdicao is > 0;

    /// <summary>Na edicao, a venda nao pode mais mudar por aqui (ver o erro).</summary>
    private bool bloqueada;
    private DateTime dataVenda;
    private CadastroRapido.TipoCadastro? modalAberto;
    private Caixa? caixaAberto;
    private decimal valorAberturaCaixa;

    // Cliente
    private string termoBusca = "";
    private List<Cliente> resultados = new();
    private Cliente? clienteSelecionado;
    private bool semCliente;
    private string nomeRapido = "";

    /// <summary>Lista suspensa da busca aberta enquanto o campo tem o foco.</summary>
    private bool buscaAberta;

    /// <summary>Agendamentos em aberto de hoje, oferecidos na busca do cliente.</summary>
    private List<Agendamento> agendamentosHoje = new();

    /// <summary>Agendamento que trouxe o cliente, para o selo "Agendado HH:mm".</summary>
    private Agendamento? agendamentoImportado;

    private List<Agendamento> AgendamentosDaBusca
    {
        get
        {
            var termo = termoBusca.Trim();
            return agendamentosHoje
                .Where(a => termo == ""
                            || (a.NomeCliente ?? "").Contains(termo, StringComparison.OrdinalIgnoreCase)
                            || (a.TelefoneCliente ?? "").Contains(termo))
                .Take(8)
                .ToList();
        }
    }
    /// <summary>
    /// Um cliente pode manter vários planos ao mesmo tempo, com serviços
    /// diferentes, então aqui vem a lista inteira.
    /// </summary>
    private List<Assinatura> assinaturas = new();

    /// <summary>Catálogo de planos, para vender qualquer um ao cliente.</summary>
    private List<Plano> planos = new();

    /// <summary>Um plano por venda: a assinatura é criada no fechamento.</summary>
    private bool PlanoJaNaVenda => itens.Any(i => i.TipoItem == TipoItem.Plano);

    private List<Assinatura> AssinaturasComCredito =>
        assinaturas.Where(a => a.Utilizavel).ToList();

    private List<Assinatura> AssinaturasEsgotadas =>
        assinaturas.Where(a => !a.Utilizavel).ToList();

    private int TotalCreditos =>
        AssinaturasComCredito.Sum(a => a.TotalRestante);

    // Catalogo
    private List<Servico> servicos = new();
    private List<Produto> produtos = new();
    private List<Funcionario> funcionarios = new();
    /// <summary>"" todos, "S"/"P" so servicos ou produtos, "S:id"/"P:id" uma categoria.</summary>
    private string categoria = "";
    private string filtroCatalogo = "";

    /// <summary>Chips de filtro: tipos e as categorias que tem item ativo.</summary>
    private List<Opcao> Categorias =>
        new List<Opcao> { new("", "Todos"), new("S", "Serviços"), new("P", "Produtos") }
            .Concat(servicos.Where(s => s.Ativo && s.IdCategoria.HasValue)
                .GroupBy(s => (Id: s.IdCategoria!.Value, Nome: s.NomeCategoria ?? "Sem nome"))
                .OrderBy(g => g.Key.Nome)
                .Select(g => new Opcao($"S:{g.Key.Id}", g.Key.Nome)))
            .Concat(produtos.Where(p => p.Ativo && p.IdCategoria.HasValue)
                .GroupBy(p => (Id: p.IdCategoria!.Value, Nome: p.NomeCategoria ?? "Sem nome"))
                .OrderBy(g => g.Key.Nome)
                .Select(g => new Opcao($"P:{g.Key.Id}", g.Key.Nome)))
            .ToList();

    private bool confirmandoLimpeza;

    /// <summary>Quanto o cliente entregou em dinheiro; só para o troco na tela.</summary>
    private decimal valorRecebido;

    // Venda
    private List<VendaItem> itens = new();
    private decimal desconto;
    private int idFuncionario;

    /// <summary>Formas e valores. Com uma linha so, ela vale o total da venda.</summary>
    private List<VendaPagamento> pagamentos = new();

    /// <summary>Mais de uma forma: cada linha tem o seu valor e precisa fechar o total.</summary>
    private bool dividido;

    /// <summary>Preco e comissao proprios de cada profissional por servico.</summary>
    private Dictionary<(int IdFuncionario, int IdServico), FuncionarioServico> precosProprios = new();

    /// <summary>Itens cujo preco o operador digitou: trocar o profissional nao o sobrescreve.</summary>
    private readonly HashSet<VendaItem> precoEditado = new();

    // Inativos somem do catalogo; o que ja esta na nota continua resolvendo.
    private List<Servico> ServicosFiltrados =>
        servicos.Where(s => s.Ativo)
            .Where(s => categoria is "" or "S" || categoria == $"S:{s.IdCategoria}")
            .Where(s => string.IsNullOrWhiteSpace(filtroCatalogo)
                        || (s.NomeServico ?? "").Contains(filtroCatalogo.Trim(), StringComparison.OrdinalIgnoreCase))
            .ToList();

    private List<Produto> ProdutosFiltrados =>
        produtos.Where(p => p.Ativo)
            .Where(p => categoria is "" or "P" || categoria == $"P:{p.IdCategoria}")
            .Where(p => string.IsNullOrWhiteSpace(filtroCatalogo)
                        || (p.NomeProduto ?? "").Contains(filtroCatalogo.Trim(), StringComparison.OrdinalIgnoreCase))
            .ToList();

    private List<Funcionario> ProfissionaisDisponiveis =>
        funcionarios.Where(f => f.Ativo
                                || f.IdFuncionario == idFuncionario
                                || itens.Any(i => i.IdFuncionario == f.IdFuncionario))
            .ToList();

    private decimal Pago => dividido ? pagamentos.Sum(p => p.Valor) : (pagamentos.Count > 0 ? Total : 0);
    private decimal Falta => Total - Pago;

    private decimal Subtotal => itens.Sum(i => i.ValorTotal);
    private decimal DescontoAplicado => Math.Min(Math.Max(0, desconto), Subtotal);
    private decimal Total => Math.Round(Subtotal - DescontoAplicado, 2);
    private decimal ComissaoTotal => itens.Sum(i => i.ComissaoTotal);

    /// <summary>Quanto o cliente deixou de pagar por já ter o plano.</summary>
    private decimal EconomiaPlano =>
        itens.Where(i => i.CobertoPlano).Sum(i => i.ValorReferencia * i.Quantidade);

    private bool ClientePronto => clienteSelecionado != null || semCliente;
    /// <summary>
    /// Venda inteiramente coberta por crédito de plano: nenhum dinheiro
    /// circula, então não há forma de pagamento a escolher.
    /// </summary>
    private bool TudoPeloPlano => itens.Count > 0 && Total == 0 && itens.All(i => i.CobertoPlano);

    private bool TemPagamento => TudoPeloPlano || (pagamentos.Count > 0 && (!dividido || Falta == 0));

    private bool PagamentoPronto => TemPagamento && idFuncionario > 0;

    /// <summary>O que ainda falta, listado para o operador não ficar adivinhando.</summary>
    private List<string> Pendencias
    {
        get
        {
            var lista = new List<string>();
            // Na edicao a venda continua no caixa em que foi feita.
            if (caixaAberto == null && !Editando) lista.Add("Abrir o caixa");
            if (itens.Count == 0) lista.Add("Adicionar ao menos um item");
            if (!TudoPeloPlano && pagamentos.Count == 0) lista.Add("Escolher a forma de pagamento");
            else if (!TudoPeloPlano && dividido && Falta != 0) lista.Add("Fechar os pagamentos no total da venda");
            if (idFuncionario <= 0) lista.Add("Informar o profissional");
            return lista;
        }
    }

    private bool PodeConfirmar => Pendencias.Count == 0;

    protected override async Task OnInitializedAsync()
    {
        // O nome de quem esta logado fica gravado na abertura do caixa.
        await auth.PrepararAsync();

        try
        {
            servicos = servicoDAO.ListarTodos() ?? new();
            produtos = produtoDAO.ListarTodos() ?? new();
            funcionarios = funcionarioDAO.ListarTodos() ?? new();
            planos = planoDAO.ListarTodos() ?? new();
            precosProprios = funcionarioDAO.MapaServicos();
            caixaAberto = caixaDAO.BuscarAberto();

            if (!Editando)
                agendamentosHoje = agendamentoDAO.Listar(DateTime.Today, DateTime.Today.AddDays(1), StatusAgendamento.Agendado);
        }
        catch (Exception ex)
        {
            erro = "Erro ao carregar os cadastros: " + ex.Message;
        }

        if (Editando) CarregarParaEdicao();
        else PreencherPeloAgendamento();
    }

    /// <summary>
    /// Monta a tela com a venda gravada. Os creditos de plano que ela mesma
    /// consumiu voltam ao saldo mostrado, para o limite de cada credito
    /// valer igual ao da venda nova; o banco confere de novo ao salvar.
    /// </summary>
    private void CarregarParaEdicao()
    {
        try
        {
            var situacao = vendaDAO.SituacaoParaEditar(IdVendaEdicao!.Value);
            var venda = vendaDAO.BuscarPorId(IdVendaEdicao.Value);

            if (venda == null || situacao.Modo != VendaDAO.ModoEdicao.Completa)
            {
                erro = situacao.Motivo ?? "Venda não encontrada.";
                bloqueada = true;
                return;
            }

            dataVenda = venda.DataVenda;

            if (venda.IdCliente is > 0) SelecionarCliente(venda.IdCliente.Value);
            else semCliente = true;

            itens = venda.Itens;

            foreach (var item in itens.Where(i => i.CobertoPlano && i.IdSaldo.HasValue))
            {
                var saldo = assinaturas.SelectMany(a => a.Saldos).FirstOrDefault(x => x.IdSaldo == item.IdSaldo);
                if (saldo != null) saldo.QuantidadeUsada = Math.Max(0, saldo.QuantidadeUsada - item.Quantidade);
            }

            pagamentos = venda.Pagamentos.Where(p => p.Forma != FormaPagamento.Plano).ToList();
            dividido = pagamentos.Count > 1;
            desconto = venda.Desconto;
            idFuncionario = venda.IdFuncionario ?? 0;
        }
        catch (Exception ex)
        {
            erro = "Erro ao carregar a venda: " + ex.Message;
            bloqueada = true;
        }
    }

    /// <summary>Venda vinda da agenda: cliente, profissional e serviço já entram na nota.</summary>
    private void PreencherPeloAgendamento()
    {
        if (IdAgendamento is not > 0) return;

        try
        {
            var agendamento = agendamentoDAO.BuscarPorId(IdAgendamento.Value);
            if (agendamento == null || !agendamento.Aberto)
            {
                IdAgendamento = null;
                return;
            }

            if (agendamento.IdCliente > 0) SelecionarCliente(agendamento.IdCliente);
            idFuncionario = agendamento.IdFuncionario;
            agendamentoImportado = agendamento;

            foreach (var idServico in agendamento.IdsServicos)
            {
                var servico = servicos.FirstOrDefault(s => s.IdServico == idServico);
                if (servico != null) AdicionarServico(servico);
            }
        }
        catch (Exception ex)
        {
            erro = "Erro ao carregar o agendamento: " + ex.Message;
        }
    }

    /// <summary>Abre o caixa sem sair da venda que já está sendo montada.</summary>
    private void AbrirCaixa()
    {
        try
        {
            erro = null;
            caixaDAO.Abrir(valorAberturaCaixa, auth.GetUsuarioNome());
            caixaAberto = caixaDAO.BuscarAberto();
            valorAberturaCaixa = 0;
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }

    /// <summary>
    /// Recarrega a lista afetada e já deixa o novo registro pronto para uso,
    /// sem perder nada do que estava montado na venda.
    /// </summary>
    private void AoCriarRegistro(int id)
    {
        try
        {
            erro = null;

            switch (modalAberto)
            {
                case CadastroRapido.TipoCadastro.Servico:
                    servicos = servicoDAO.ListarTodos() ?? new();
                    categoria = "S";
                    filtroCatalogo = "";
                    var novoServico = servicos.FirstOrDefault(s => s.IdServico == id);
                    if (novoServico != null) AdicionarServico(novoServico);
                    break;

                case CadastroRapido.TipoCadastro.Produto:
                    produtos = produtoDAO.ListarTodos() ?? new();
                    categoria = "P";
                    filtroCatalogo = "";
                    var novoProduto = produtos.FirstOrDefault(p => p.IdProduto == id);
                    if (novoProduto != null) AdicionarProduto(novoProduto);
                    break;

                case CadastroRapido.TipoCadastro.Cliente:
                    SelecionarCliente(id);
                    break;

                case CadastroRapido.TipoCadastro.Funcionario:
                    funcionarios = funcionarioDAO.ListarTodos() ?? new();
                    EscolherProfissional(id);
                    break;
            }
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
        finally
        {
            modalAberto = null;
        }
    }

    // ---------- cliente ----------

    /// <summary>Filtra enquanto digita; abaixo de 2 letras não vale a consulta.</summary>
    private void BuscarClientes()
    {
        try
        {
            erro = null;

            if (termoBusca.Trim().Length < 2)
            {
                resultados.Clear();
                return;
            }

            resultados = clienteDAO.Buscar(termoBusca, 8);
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }

    private void SelecionarCliente(int id)
    {
        try
        {
            erro = null;
            clienteSelecionado = clienteDAO.BuscarPorId(id);
            semCliente = false;
            resultados.Clear();
            termoBusca = "";

            assinaturas = clienteSelecionado != null
                ? assinaturaDAO.ListarAtivasDoCliente(clienteSelecionado.IdCliente)
                : new();
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }

    /// <summary>Trocar o cliente desfaz também o vínculo com o agendamento.</summary>
    private void TrocarCliente()
    {
        clienteSelecionado = null;
        semCliente = false;
        assinaturas.Clear();
        IdAgendamento = null;
        agendamentoImportado = null;
    }

    /// <summary>
    /// Traz um agendamento de hoje para a venda: cliente, profissional e
    /// serviços, e ao confirmar ele fica concluído.
    /// </summary>
    private void ImportarAgendamento(Agendamento a)
    {
        buscaAberta = false;
        IdAgendamento = a.IdAgendamento;
        PreencherPeloAgendamento();
    }

    private static string Iniciais(string? nome)
    {
        var partes = (nome ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length switch
        {
            0 => "—",
            1 => partes[0][..Math.Min(2, partes[0].Length)].ToUpperInvariant(),
            _ => $"{partes[0][0]}{partes[^1][0]}".ToUpperInvariant()
        };
    }

    private void UsarSemCliente()
    {
        clienteSelecionado = null;
        semCliente = true;
        resultados.Clear();
        termoBusca = "";
    }

    private void CadastrarComTermo()
    {
        nomeRapido = termoBusca;
        SalvarCadastroRapido();
    }

    private void SalvarCadastroRapido()
    {
        try
        {
            erro = null;
            var id = clienteDAO.InserirSomenteNome(nomeRapido);
            nomeRapido = "";
            SelecionarCliente(id);
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }

    // ---------- catalogo ----------

    private int QuantidadeNaNota(string tipo, int idRef) =>
        itens.Where(i => i.TipoItem == tipo && i.IdReferencia == idRef && !i.CobertoPlano)
             .Sum(i => i.Quantidade);

    private void AdicionarServico(Servico s)
    {
        erro = null;
        var item = new VendaItem
        {
            TipoItem = TipoItem.Servico,
            IdReferencia = s.IdServico,
            Descricao = s.NomeServico ?? "Serviço",
            Quantidade = 1,
            ValorUnitario = PrecoDe(s, idFuncionario)
        };
        Recalcular(item);
        Somar(item);
    }

    private void AdicionarProduto(Produto p)
    {
        erro = null;
        var item = new VendaItem
        {
            TipoItem = TipoItem.Produto,
            IdReferencia = p.IdProduto,
            Descricao = p.NomeProduto ?? "Produto",
            Quantidade = 1,
            ValorUnitario = (decimal)p.Valor
        };
        Recalcular(item);
        Somar(item);
    }

    /// <summary>Soma na linha existente em vez de duplicar o item.</summary>
    private void Somar(VendaItem novo)
    {
        var existente = itens.FirstOrDefault(i =>
            i.TipoItem == novo.TipoItem &&
            i.IdReferencia == novo.IdReferencia &&
            i.CobertoPlano == novo.CobertoPlano &&
            i.IdSaldo == novo.IdSaldo &&
            i.ValorUnitario == novo.ValorUnitario &&
            i.IdFuncionario == novo.IdFuncionario &&
            i.Desconto == 0);

        if (existente != null) existente.Quantidade += novo.Quantidade;
        else itens.Add(novo);
    }

    // ---------- profissional, preco e comissao por item ----------

    private int ProfissionalDo(VendaItem item) => item.IdFuncionario is > 0 ? item.IdFuncionario.Value : idFuncionario;

    /// <summary>Preco proprio do profissional para o servico, ou o do cadastro.</summary>
    private decimal PrecoDe(Servico s, int idProfissional) =>
        precosProprios.TryGetValue((idProfissional, s.IdServico), out var proprio) && proprio.Preco is decimal preco
            ? preco
            : (decimal)s.PrecoServico;

    /// <summary>
    /// Congela no item a comissao pela regra atual (RegraComissao). O
    /// credito de plano paga a comissao sobre o preco de referencia, a nao
    /// ser que o plano diga que o assinante nao gera comissao.
    /// </summary>
    private void Recalcular(VendaItem item)
    {
        var idProfissional = ProfissionalDo(item);
        var profissional = funcionarios.FirstOrDefault(f => f.IdFuncionario == idProfissional);

        if (item.TipoItem == TipoItem.Servico)
        {
            var servico = servicos.FirstOrDefault(s => s.IdServico == item.IdReferencia);
            if (servico == null) return;

            if (item.CobertoPlano && PlanoSemComissao(item))
            {
                item.ComissaoUnitaria = 0;
                return;
            }

            precosProprios.TryGetValue((idProfissional, servico.IdServico), out var proprio);
            var baseUnitaria = item.CobertoPlano ? item.ValorReferencia : item.ValorUnitarioLiquido;
            item.ComissaoUnitaria = RegraComissao.Servico(servico, profissional, proprio, baseUnitaria);
        }
        else if (item.TipoItem == TipoItem.Produto)
        {
            var produto = produtos.FirstOrDefault(p => p.IdProduto == item.IdReferencia);
            if (produto == null) return;

            item.ComissaoUnitaria = item.CobertoPlano
                ? 0
                : RegraComissao.Produto(produto, profissional, item.ValorUnitarioLiquido);
        }
    }

    private bool PlanoSemComissao(VendaItem item)
    {
        var assinatura = assinaturas.FirstOrDefault(a => a.Saldos.Any(s => s.IdSaldo == item.IdSaldo));
        var plano = planos.FirstOrDefault(p => p.IdPlano == assinatura?.IdPlano);
        return plano?.RegraComissaoAssinante == RegraComissaoAssinante.SemComissao;
    }

    /// <summary>
    /// Troca o profissional da venda. Os itens que seguem a venda passam a
    /// ser dele: preco proprio (se o operador nao digitou outro) e comissao.
    /// </summary>
    private void EscolherProfissional(int id)
    {
        idFuncionario = id;

        foreach (var item in itens.Where(i => i.IdFuncionario is not > 0))
            AplicarProfissional(item);
    }

    private void TrocarProfissionalDoItem(VendaItem item, ChangeEventArgs e)
    {
        item.IdFuncionario = int.TryParse(e.Value?.ToString(), out var id) && id > 0 ? id : null;
        AplicarProfissional(item);
    }

    private void AplicarProfissional(VendaItem item)
    {
        if (item.TipoItem == TipoItem.Servico && !item.CobertoPlano && !precoEditado.Contains(item))
        {
            var servico = servicos.FirstOrDefault(s => s.IdServico == item.IdReferencia);
            if (servico != null) item.ValorUnitario = PrecoDe(servico, ProfissionalDo(item));
        }

        Recalcular(item);
    }

    private void AlterarPreco(VendaItem item, decimal valor)
    {
        precoEditado.Add(item);
        item.ValorUnitario = Math.Max(0, valor);
        item.Desconto = Math.Min(item.Desconto, Math.Round(item.ValorUnitario * item.Quantidade, 2));
        Recalcular(item);
    }

    private void AlterarDesconto(VendaItem item, decimal valor)
    {
        item.Desconto = Math.Clamp(valor, 0, Math.Round(item.ValorUnitario * item.Quantidade, 2));
        Recalcular(item);
    }

    /// <summary>Ajusta a quantidade direto na nota; zero remove a linha.</summary>
    private void AjustarQuantidade(VendaItem item, int delta)
    {
        erro = null;
        var nova = item.Quantidade + delta;

        if (nova <= 0)
        {
            itens.Remove(item);
            return;
        }

        // Item do plano nao pode passar do credito disponivel.
        if (item.CobertoPlano && item.IdSaldo.HasValue && delta > 0)
        {
            var saldo = assinaturas
                .SelectMany(a => a.Saldos)
                .FirstOrDefault(s => s.IdSaldo == item.IdSaldo);
            if (saldo != null && nova > saldo.Restante)
            {
                erro = $"O plano tem apenas {saldo.Restante} crédito(s) de {saldo.Descricao}.";
                return;
            }
        }

        item.Quantidade = nova;

        // Com desconto em R$ na linha, o unitario liquido muda com a quantidade.
        if (item.Desconto > 0)
        {
            item.Desconto = Math.Min(item.Desconto, Math.Round(item.ValorUnitario * item.Quantidade, 2));
            Recalcular(item);
        }
    }

    private void RemoverItem(VendaItem item)
    {
        itens.Remove(item);
        precoEditado.Remove(item);
    }

    private void LimparItens()
    {
        itens.Clear();
        precoEditado.Clear();
        confirmandoLimpeza = false;
    }

    private decimal SomaDo(string tipo) =>
        itens.Where(i => i.TipoItem == tipo).Sum(i => i.ValorTotal);

    // ---------- pagamento ----------

    /// <summary>
    /// Sem dividir, escolher a forma troca a unica linha (que vale o total).
    /// Dividido, cada forma nova entra com o que ainda falta.
    /// </summary>
    private void EscolherForma(string forma)
    {
        if (!dividido)
        {
            pagamentos = new()
            {
                new VendaPagamento { Forma = forma, Valor = Total, Parcelas = forma == FormaPagamento.Credito ? 1 : null }
            };
            return;
        }

        if (pagamentos.Any(p => p.Forma == forma)) return;

        pagamentos.Add(new VendaPagamento
        {
            Forma = forma,
            Valor = Math.Max(0, Falta),
            Parcelas = forma == FormaPagamento.Credito ? 1 : null
        });
    }

    private void Dividir()
    {
        dividido = true;
        if (pagamentos.Count == 1) pagamentos[0].Valor = Total;
    }

    /// <summary>Liga e desliga o "Múltiplo"; desligar só com uma forma ou nenhuma.</summary>
    private void AlternarDivisao()
    {
        if (!dividido)
        {
            Dividir();
            return;
        }

        if (pagamentos.Count <= 1) dividido = false;
    }

    private static string SiglaDaForma(string forma) => forma switch
    {
        FormaPagamento.Dinheiro => "R$",
        FormaPagamento.Pix => "PIX",
        FormaPagamento.Debito => "DB",
        FormaPagamento.Credito => "CR",
        _ => "·"
    };

    private static string DicaDaForma(string forma) => forma switch
    {
        FormaPagamento.Dinheiro => "Com cálculo de troco",
        FormaPagamento.Pix => "Transferência na hora",
        FormaPagamento.Debito => "Na maquininha",
        FormaPagamento.Credito => "À vista ou parcelado",
        _ => ""
    };

    private void RemoverPagamento(VendaPagamento pagamento)
    {
        pagamentos.Remove(pagamento);
        if (pagamentos.Count <= 1) dividido = false;
    }

    /// <summary>Joga o que falta (ou sobra) na ultima linha.</summary>
    private void Completar()
    {
        var ultima = pagamentos.LastOrDefault();
        if (ultima != null) ultima.Valor = Math.Max(0, ultima.Valor + Falta);
    }

    private void AjustarParcelas(VendaPagamento pagamento, int delta) =>
        pagamento.Parcelas = Math.Clamp((pagamento.Parcelas ?? 1) + delta, 1, 12);

    // ---------- credito do plano ----------

    /// <summary>
    /// Quantos créditos deste saldo já estão reservados nesta venda. A baixa
    /// aparece na nota na hora, mas o banco só é tocado na confirmação.
    /// </summary>
    private int JaUsados(AssinaturaSaldo saldo) =>
        itens.Where(i => i.CobertoPlano && i.IdSaldo == saldo.IdSaldo)
             .Sum(i => i.Quantidade);

    /// <summary>
    /// Reserva um crédito do plano para esta venda: entra na nota por
    /// R$ 0,00 e o abate do saldo acontece junto com o INSERT da venda.
    /// </summary>
    private void UsarCredito(AssinaturaSaldo saldo)
    {
        erro = null;

        if (JaUsados(saldo) >= saldo.Restante)
        {
            erro = $"O plano tem apenas {saldo.Restante} crédito(s) de {saldo.Descricao}.";
            return;
        }

        // O plano zera o preco, nao a comissao: o profissional executou o
        // servico (Recalcular aplica a regra do plano).
        var item = new VendaItem
        {
            TipoItem = saldo.TipoItem,
            IdReferencia = saldo.IdReferencia,
            Descricao = saldo.Descricao,
            Quantidade = 1,
            ValorUnitario = 0,
            CobertoPlano = true,
            IdSaldo = saldo.IdSaldo,
            ValorReferencia = saldo.ValorReferencia
        };
        Recalcular(item);
        Somar(item);
    }

    // ---------- plano ----------

    /// <summary>Componentes do plano que está sendo vendido nesta venda.</summary>
    private List<PlanoItem> itensDoPlanoVendido = new();

    private void RenovarPlano(int idPlano)
    {
        var plano = planos.FirstOrDefault(p => p.IdPlano == idPlano);
        if (plano != null) VenderPlano(plano);
    }

    /// <summary>
    /// Põe o plano escolhido na venda. Ele é cobrado uma vez e, ao confirmar,
    /// vira uma assinatura nova — que soma aos planos que o cliente já tenha.
    /// </summary>
    private void VenderPlano(Plano plano)
    {
        erro = null;

        if (clienteSelecionado == null)
        {
            erro = "Selecione o cliente antes de vender um plano.";
            return;
        }

        if (PlanoJaNaVenda)
        {
            erro = "Já há um plano nesta venda. Finalize e faça outra para vender um segundo.";
            return;
        }

        itensDoPlanoVendido = planoDAO.ListarItens(plano.IdPlano);
        if (itensDoPlanoVendido.Count == 0)
        {
            erro = $"O plano {plano.NomePlano} não tem componentes configurados, então não geraria créditos.";
            return;
        }

        itens.Add(new VendaItem
        {
            TipoItem = TipoItem.Plano,
            IdReferencia = plano.IdPlano,
            Descricao = $"Plano {plano.NomePlano}",
            Quantidade = 1,
            ValorUnitario = (decimal)(plano.Valor ?? 0)
        });
    }


    // ---------- confirmacao ----------

    private void Confirmar()
    {
        try
        {
            erro = null;

            if (!PodeConfirmar)
            {
                erro = "Falta: " + string.Join(", ", Pendencias).ToLowerInvariant() + ".";
                return;
            }

            // Copia: o DAO completa a lista, e um erro nao pode deixar a tela
            // com linhas que o operador nao pos.
            var pagos = TudoPeloPlano
                ? new List<VendaPagamento> { new() { Forma = FormaPagamento.Plano, Valor = 0 } }
                : pagamentos.Select(p => new VendaPagamento
                  {
                      Forma = p.Forma,
                      Valor = dividido ? p.Valor : Total,
                      Parcelas = p.Parcelas
                  }).ToList();

            if (Editando)
            {
                vendaDAO.Atualizar(new Venda
                {
                    IdVenda = IdVendaEdicao!.Value,
                    IdCliente = clienteSelecionado?.IdCliente,
                    IdFuncionario = idFuncionario,
                    Pagamentos = pagos,
                    Desconto = DescontoAplicado,
                    Itens = itens,
                    // Vai gravado no movimento de estoque dos produtos.
                    Usuario = auth.GetUsuarioNome()
                });

                Navigation.NavigateTo($"/vendas?editada={IdVendaEdicao}");
                return;
            }

            var venda = new Venda
            {
                DataVenda = DateTime.Now,
                IdCliente = clienteSelecionado?.IdCliente,
                IdFuncionario = idFuncionario,
                IdCaixa = caixaAberto?.IdCaixa,
                Pagamentos = pagos,
                Desconto = DescontoAplicado,
                Status = StatusVenda.Confirmada,
                Itens = itens,
                Usuario = auth.GetUsuarioNome()
            };

            // Se um plano foi vendido, a confirmação cria a assinatura
            // com os créditos, na mesma transação.
            var itemPlano = itens.FirstOrDefault(i => i.TipoItem == TipoItem.Plano);
            if (itemPlano != null && clienteSelecionado != null)
            {
                var plano = planos.FirstOrDefault(p => p.IdPlano == itemPlano.IdReferencia);
                venda.PlanoVendido = new Venda.PlanoParaAssinar
                {
                    IdPlano = itemPlano.IdReferencia!.Value,
                    ValorPago = itemPlano.ValorTotal,
                    Componentes = itensDoPlanoVendido,
                    ValidadeDias = Periodicidade.Dias(plano?.Periodicidade)
                };
            }

            var id = vendaDAO.Inserir(venda);

            // A venda ja foi gravada: se marcar o agendamento falhar, nao
            // desfaz a venda. Ele so continua aberto na agenda.
            if (IdAgendamento is > 0)
            {
                try { agendamentoDAO.Concluir(IdAgendamento.Value, id); }
                catch { }
            }

            Navigation.NavigateTo($"/vendas?nova={id}");
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }
}
