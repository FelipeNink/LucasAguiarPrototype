                                    @if (p.Forma == FormaPagamento.Credito)
                                    {
                                        <div class="contador pequeno">
                                            <button type="button" @onclick="() => AjustarParcelas(p, -1)" disabled="@(p.Parcelas <= 1)">−</button>
                                            <span>@(p.Parcelas ?? 1)×</span>
                                            <button type="button" @onclick="() => AjustarParcelas(p, 1)" disabled="@(p.Parcelas >= 12)">+</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span></span>
                                    }
                                    <button type="button" class="remover" title="Remover" @onclick="() => RemoverPagamento(p)">×</button>
                                </li>
                            }
                        </ul>
                        @if (pagamentos.Count == 0)
                        {
                            <span class="suave">Escolha as formas acima; cada uma entra com o que falta.</span>
                        }

                        <div class="pagamentos-resumo @(Falta == 0 ? "fechado" : "aberto")">
                            @if (Falta > 0)
                            {
                                <span>Falta @Falta.ToString("C")</span>
                                @if (pagamentos.Count > 0)
                                {
                                    <button type="button" class="acao-campo" @onclick="Completar">Completar na última forma</button>
                                }
                            }
                            else if (Falta < 0)
                            {
                                <span>Passou @Math.Abs(Falta).ToString("C") do total</span>
                            }
                            else
                            {
                                <span>Pagamento fechado</span>
                            }
                        </div>
                    </div>
                }
                else if (pagamentos.Count == 1 && pagamentos[0].Forma == FormaPagamento.Credito)
                {
                    var credito = pagamentos[0];
                    <div class="detalhe-pagamento campo-parcelas">
                        <label class="rotulo">Parcelas</label>
                        <div class="contador">
                            <button type="button" @onclick="() => AjustarParcelas(credito, -1)" disabled="@(credito.Parcelas <= 1)">−</button>
                            <span>@(credito.Parcelas ?? 1)×</span>
                            <button type="button" @onclick="() => AjustarParcelas(credito, 1)" disabled="@(credito.Parcelas >= 12)">+</button>
                        </div>
                        @if (itens.Count > 0 && credito.Parcelas > 1)
                        {
                            <span class="valor-parcela">@((Total / credito.Parcelas.Value).ToString("C")) cada</span>
                        }
                    </div>
                }
                else if (pagamentos.Count == 1 && pagamentos[0].Forma == FormaPagamento.Dinheiro && Total > 0)
                {
                    @* So conta na tela: o troco nao e gravado. *@
                    <div class="detalhe-pagamento troco">
                        <div>
                            <label class="rotulo">Valor recebido</label>
                            <InputMoeda Valor="valorRecebido" ValorChanged="v => valorRecebido = v" />
                        </div>
                        <div>
                            <label class="rotulo">Troco</label>
                            <div class="valor-troco @(valorRecebido > 0 && valorRecebido < Total ? "falta" : "")">
                                @(valorRecebido > 0 && valorRecebido < Total
                                    ? $"Faltam {(Total - valorRecebido):C}"
                                    : Math.Max(0, valorRecebido - Total).ToString("C"))
                            </div>
                        </div>
                        <div class="notas-rapidas">
                            @foreach (var nota in new[] { 50m, 100m, 200m })
                            {
                                <button type="button" @onclick="() => valorRecebido = nota">@nota.ToString("C0")</button>
                            }
                            <button type="button" @onclick="() => valorRecebido = Total">Exato</button>
                        </div>
                    </div>
                }
            }

            @if (Pendencias.Count > 0)
            {
                <ul class="pendencias">
                    @foreach (var p in Pendencias)
                    {
                        <li>@p</li>
                    }
                </ul>
