@page "/servico"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Politicas.Servicos)]

@using LucasAguiar.Configs
@using LucasAguiar.Models
@inject ServicoDAO servicoDAO
@inject NavigationManager Navigation


<h1 class="titulo-listagem">Gestão de Serviços</h1>

<div class="barra-acoes barra-listagem">
    <BotaoExportar Href="/relatorio/servicos" />
    <NavLink href="/servico/novo" class="btn-novo btn-cadastrar">Cadastrar serviço</NavLink>
</div>

@* ---------- filtros ---------- *@
<section class="filtros">
    <div class="campo campo-largo">
        <label>Nome</label>
        <input class="form-control" placeholder="Buscar serviço" @bind="busca" @bind:event="oninput" />
    </div>
    <div class="campo-acoes">
        <button type="button" class="btn btn-outline-secondary" @onclick="() => busca = string.Empty">Limpar</button>
    </div>
</section>

<div class="tabela fixa">
    <table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th class="al-dir opcional">Duração</th>
            <th class="al-dir">Preço</th>
            <th class="al-dir opcional">Comissão</th>
            <th class="al-dir opcional">Comissão %</th>
            <th class="col-acoes">Ações</th>
        </tr>
    </thead>
    <tbody>
        @if (Filtrados.Any())
        {
            foreach (var servico in Filtrados)
            {
                <tr>
                    <td>@servico.NomeServico</td>
                    <td class="al-dir opcional">@servico.DuracaoServico min</td>
                    <td class="al-dir">@servico.PrecoServico.ToString("C")</td>  @* mostra como moeda *@
                    <td class="al-dir opcional">@servico.ComissaoServico.ToString("C")</td>
                    <td class="al-dir opcional">@PercentualComissao(servico)</td>
                    <td class="col-acoes">
                        <AcoesLinha OnVisualizar="() => visualizando = servico"
                                    OnEditar="() => Editar(servico)"
                                    OnExcluir="() => excluindo = servico" />
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Nenhum serviço encontrado.</td>
            </tr>
        }
    </tbody>
    </table>
</div>

<ConfirmarModal Visivel="@(excluindo != null)" Titulo="Excluir serviço" Erro="@erroExclusao"
                OnConfirmar="ConfirmarExclusao" OnCancelar="CancelarExclusao">
    Tem certeza que deseja excluir <strong>@excluindo?.NomeServico</strong>?<br />
    <span class="text-muted">Esta ação não pode ser desfeita.</span>
</ConfirmarModal>

<Janela Visivel="@(visualizando != null)" Titulo="@(visualizando?.NomeServico ?? "Serviço")"
        OnFechar="Fechar">
    <ChildContent>
        @if (visualizando != null)
        {
            <dl class="ficha">
                <div><dt>Preço</dt><dd>@visualizando.PrecoServico.ToString("C")</dd></div>
                <div><dt>Duração</dt><dd>@visualizando.DuracaoServico min</dd></div>
                <div><dt>Comissão</dt><dd>@visualizando.ComissaoServico.ToString("C")</dd></div>
            </dl>
        }
    </ChildContent>
    <Rodape>
        <button type="button" class="btn btn-outline-secondary" @onclick="Fechar">Fechar</button>
        <button type="button" class="btn btn-primary" @onclick="() => Editar(visualizando!)">Editar</button>
    </Rodape>
</Janela>

@code {
    private Servico? excluindo;
    private string? erroExclusao;

    private void ConfirmarExclusao()
    {
        if (excluindo == null) return;

        try
        {
            servicoDAO.Excluir(excluindo.IdServico);
            excluindo = null;
            erroExclusao = null;
            CarregarServico();
        }
        catch (Exception ex)
        {
            erroExclusao = ex.Message;
        }
    }

    private void CancelarExclusao()
    {
        excluindo = null;
        erroExclusao = null;
    }

    private List<Servico> listaServico = new(); // 🔹 nome minúsculo (padrão)

    private Servico? visualizando;

    private string busca = "";

    private List<Servico> Filtrados =>
        listaServico
            .Where(s => string.IsNullOrWhiteSpace(busca)
                        || (s.NomeServico ?? "").Contains(busca.Trim(), StringComparison.OrdinalIgnoreCase))
            .OrderBy(s => s.NomeServico)
            .ToList();

    /// <summary>A comissão é gravada em R$; o % sai sobre o preço do serviço.</summary>
    private static string PercentualComissao(Servico s) =>
        s.PrecoServico > 0 ? (s.ComissaoServico / s.PrecoServico).ToString("P1") : "—";

    protected override void OnInitialized()
    {
        CarregarServico();
    }

    private void CarregarServico()
    {
        try
        {
            listaServico = servicoDAO.ListarTodos();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erro ao carregar serviços: " + ex.Message);
        }
    }

    /// <summary>A edicao e uma pagina propria, com o mesmo formulario do cadastro.</summary>
    private void Editar(Servico s) => Navigation.NavigateTo($"/servico/{s.IdServico}");

    private void Fechar() => visualizando = null;

}
