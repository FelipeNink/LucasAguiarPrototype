@page "/servico/{Id:int}/excluir"
@rendermode InteractiveServer

@inject ServicoDAO servicoDAO
@inject NavigationManager Navigation

<TelaExclusao Entidade="serviço" Nome="@servico?.NomeServico" Voltar="/servico"
              Aviso="Planos que incluem este serviço passam a mostrá-lo como item removido."
              Encontrado="@(servico != null)" Erro="@erro" OnConfirmar="Excluir" />

@code {
    [Parameter] public int Id { get; set; }

    private Servico? servico;
    private string? erro;

    protected override void OnInitialized()
    {
        try
        {
            servico = servicoDAO.BuscarPorId(Id);
            if (servico == null) erro = "Serviço não encontrado.";
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }

    private void Excluir()
    {
        try
        {
            servicoDAO.Excluir(Id);
            Navigation.NavigateTo("/servico");
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }
}
