@page "/cliente/{Id:int}/excluir"
@rendermode InteractiveServer

@inject ClienteDAO clienteDAO
@inject NavigationManager Navigation

<TelaExclusao Entidade="cliente" Nome="@cliente?.NomeCliente" Voltar="/cliente"
              Encontrado="@(cliente != null)" Erro="@erro" OnConfirmar="Excluir" />

@code {
    [Parameter] public int Id { get; set; }

    private Cliente? cliente;
    private string? erro;

    protected override void OnInitialized()
    {
        try
        {
            cliente = clienteDAO.BuscarPorId(Id);
            if (cliente == null) erro = "Cliente não encontrado.";
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }

    private void Excluir()
    {
        try
        {
            clienteDAO.Excluir(Id);
            Navigation.NavigateTo("/cliente");
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }
}
