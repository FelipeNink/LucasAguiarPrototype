@* Formulario de cliente, o mesmo para criar e editar. Quem decide qual
   e a pagina (CadastrarCliente / EditarCliente), pelo parametro Novo. *@

@using LucasAguiar.Configs
@using LucasAguiar.Models
@inject ClienteDAO clienteDAO
@inject PlanoDAO planoDAO
@inject BuscaCep buscaCep
@inject NavigationManager Navigation

<div class="form-pagina">
    <div class="topo-form">
        <a href="/cliente" class="voltar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m15 18-6-6 6-6" />
            </svg>
            Clientes
        </a>
        <h1>@(Novo ? "Novo cliente" : "Editar cliente")</h1>
    </div>

    @if (erro != null)
    {
        <div class="alert alert-danger" role="alert">@erro</div>
    }

    <form @onsubmit="Salvar" novalidate>
        <section class="cartao secao-form">
            <h2>Dados pessoais</h2>
            <div class="grade-12">
                <Campo Rotulo="Nome" Para="cli-nome" Colunas="8" Obrigatorio="true"
                       Erro="@(tentouSalvar && string.IsNullOrWhiteSpace(Modelo.NomeCliente) ? "Informe o nome." : null)">
                    <input id="cli-nome" class="form-control" maxlength="100" autocomplete="off"
                           @bind="Modelo.NomeCliente" />
                </Campo>
                <Campo Rotulo="Data de nascimento" Para="cli-nasc" Colunas="4">
                    <input id="cli-nasc" type="date" class="form-control" @bind="Modelo.DataNascimento" />
                </Campo>

                <Campo Rotulo="Telefone" Para="cli-tel" Colunas="4" Erro="@Documentos.ErroTelefone(Modelo.Telefone)">
                    <input id="cli-tel" class="form-control" inputmode="tel" data-mascara="telefone"
                           placeholder="(69) 99999-9999" @bind="Modelo.Telefone" />
                </Campo>
                <Campo Rotulo="CPF" Para="cli-cpf" Colunas="4" Erro="@Documentos.ErroCpf(Modelo.CPF)">
                    <input id="cli-cpf" class="form-control" inputmode="numeric" data-mascara="cpf"
                           placeholder="000.000.000-00" @bind="Modelo.CPF" />
                </Campo>
                <Campo Rotulo="RG" Para="cli-rg" Colunas="4">
                    <input id="cli-rg" class="form-control" maxlength="7" @bind="Modelo.RG" />
                </Campo>
            </div>
        </section>

        <section class="cartao secao-form">
            <h2>Endereço</h2>
            <div class="grade-12">
                <Campo Rotulo="CEP" Para="cli-cep" Colunas="3" Erro="@ErroCep" Dica="@dicaCep">
                    <input id="cli-cep" class="form-control" inputmode="numeric" data-mascara="cep"
                           placeholder="00000-000" @bind="Modelo.Cep" @bind:after="AoMudarCep" />
                </Campo>
                <Campo Rotulo="Rua" Para="cli-rua" Colunas="7">
                    <input id="cli-rua" class="form-control" maxlength="200" @bind="Modelo.Rua" />
                </Campo>
                <Campo Rotulo="Número" Para="cli-num" Colunas="2">
                    <input id="cli-num" class="form-control" maxlength="20" @bind="Modelo.Numero" />
                </Campo>

                <Campo Rotulo="Bairro" Para="cli-bairro" Colunas="5">
                    <input id="cli-bairro" class="form-control" maxlength="200" @bind="Modelo.Bairro" />
                </Campo>
                <Campo Rotulo="Cidade" Para="cli-cidade" Colunas="5">
                    <input id="cli-cidade" class="form-control" maxlength="200" @bind="Modelo.Cidade" />
                </Campo>
                <Campo Rotulo="UF" Colunas="2">
                    <Seletor TItem="Opcao" TValor="string" Itens="OpcoesUf"
                             @bind-Valor="Modelo.Estado" TextoDe="o => o.Rotulo" ValorDe="o => o.Valor"
                             Placeholder="—" />
                </Campo>
            </div>
        </section>

        <section class="cartao secao-form">
            <h2>Plano</h2>
            <div class="grade-12">
                <Campo Rotulo="Plano" Colunas="4"
                       Dica="@(planos.Count == 0 ? "Nenhum plano cadastrado ainda." : null)">
                    <ChildContent>
                        <Seletor TItem="OpcaoId" TValor="int" Itens="OpcoesPlano"
                                 Valor="Modelo.IdPlano ?? 0"
                                 ValorChanged="v => Modelo.IdPlano = v == 0 ? null : v"
                                 TextoDe="o => o.Rotulo" ValorDe="o => o.Id" />
                    </ChildContent>
                    <Acao>
                        <button type="button" class="acao-campo" @onclick="() => modalPlano = true">
                            + Cadastrar plano
                        </button>
                    </Acao>
                </Campo>
            </div>
        </section>

        <div class="rodape-form">
            <a href="/cliente" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary" disabled="@salvando">Salvar</button>
        </div>
    </form>
</div>

<CadastroRapido Visivel="modalPlano"
                Tipo="CadastroRapido.TipoCadastro.Plano"
                OnCriado="AoCriarPlano"
                OnCancelado="() => modalPlano = false" />

@code {
    [Parameter, EditorRequired] public Cliente Modelo { get; set; } = new();
    [Parameter] public bool Novo { get; set; }

    private List<Plano> planos = new();
    private string? erro;
    private string? dicaCep;
    private bool tentouSalvar;
    private bool salvando;
    private bool modalPlano;

    private string? ErroCep => Documentos.ErroCep(Modelo.Cep);

    /// <summary>Sem plano e uma escolha valida, entao entra como item zero.</summary>
    private List<OpcaoId> OpcoesPlano =>
        new List<OpcaoId> { new(0, "Nenhum") }
            .Concat(planos.Select(p => new OpcaoId(p.IdPlano, p.NomePlano ?? "Sem nome")))
            .ToList();

    /// <summary>
    /// As 27 UFs. Cadastro antigo com o estado por extenso ("Rondônia")
    /// entra como opcao extra, para nao sumir ao abrir a edicao.
    /// </summary>
    private List<Opcao> OpcoesUf
    {
        get
        {
            var lista = Documentos.Ufs.Select(u => new Opcao(u, u)).ToList();
            if (!string.IsNullOrWhiteSpace(Modelo.Estado) && !Documentos.Ufs.Contains(Modelo.Estado))
                lista.Insert(0, new Opcao(Modelo.Estado, Modelo.Estado));
            return lista;
        }
    }

    protected override void OnInitialized()
    {
        try
        {
            planos = planoDAO.ListarTodos();
        }
        catch (Exception ex)
        {
            erro = "Erro ao carregar os planos: " + ex.Message;
        }
    }

    /// <summary>CEP completo e valido: busca e preenche rua, bairro, cidade e UF.</summary>
    private async Task AoMudarCep()
    {
        dicaCep = null;
        if (!Documentos.CepValido(Modelo.Cep)) return;

        dicaCep = "Buscando endereço…";
        StateHasChanged();

        var endereco = await buscaCep.BuscarAsync(Modelo.Cep);
        if (endereco == null)
        {
            dicaCep = "CEP não encontrado. Preencha o endereço.";
            return;
        }

        Modelo.Cep = Documentos.FormatarCep(Modelo.Cep);
        if (!string.IsNullOrWhiteSpace(endereco.Rua)) Modelo.Rua = endereco.Rua;
        if (!string.IsNullOrWhiteSpace(endereco.Bairro)) Modelo.Bairro = endereco.Bairro;
        Modelo.Cidade = endereco.Cidade;
        Modelo.Estado = endereco.Uf;
        dicaCep = null;
    }

    private void AoCriarPlano(int id)
    {
        try
        {
            erro = null;
            planos = planoDAO.ListarTodos() ?? new();
            Modelo.IdPlano = id;
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
        finally
        {
            modalPlano = false;
        }
    }

    private void Salvar()
    {
        tentouSalvar = true;
        erro = null;

        var temErro =
            string.IsNullOrWhiteSpace(Modelo.NomeCliente)
            || Documentos.ErroTelefone(Modelo.Telefone) != null
            || Documentos.ErroCpf(Modelo.CPF) != null
            || ErroCep != null;

        if (temErro)
        {
            erro = "Confira os campos destacados.";
            return;
        }

        try
        {
            salvando = true;

            // Grava sempre no mesmo formato, digitado com ou sem mascara.
            Modelo.NomeCliente = Modelo.NomeCliente!.Trim();
            Modelo.Telefone = Vazio(Documentos.FormatarTelefone(Modelo.Telefone));
            Modelo.CPF = Vazio(Documentos.FormatarCpf(Modelo.CPF));
            Modelo.Cep = Vazio(Documentos.FormatarCep(Modelo.Cep));
            Modelo.RG = Vazio(Modelo.RG);

            if (Novo) clienteDAO.Inserir(Modelo);
            else clienteDAO.Atualizar(Modelo);

            Navigation.NavigateTo("/cliente");
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
        finally
        {
            salvando = false;
        }
    }

    private static string? Vazio(string? texto) =>
        string.IsNullOrWhiteSpace(texto) ? null : texto.Trim();
}
