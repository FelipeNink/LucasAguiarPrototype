@page "/cliente"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Politicas.Clientes)]

@using LucasAguiar.Configs
@using LucasAguiar.Models
@inject ClienteDAO clienteDAO
@inject PlanoDAO planoDAO


<h1>Lista de Clientes</h1>

<div class="barra-acoes">
    <NavLink href="/cliente/novo" class="btn-novo">Novo Cliente</NavLink>
    <a href="/relatorio/clientes" class="btn-pdf" data-enhance-nav="false">Relatório PDF</a>
    <a href="/excel/clientes" class="btn-pdf" data-enhance-nav="false">Excel</a>
</div>

<div class="tabela fixa">
    <table class="table table-striped">
    <thead>
        <tr>
            <th class="col-id">#</th>
            <th>Nome</th>
            <th>Telefone</th>
            <th class="opcional">CPF</th>
            <th class="opcional">Cidade</th>
            <th class="col-acoes">Ações</th>
        </tr>
    </thead>
    <tbody>
        @if (listaCliente != null && listaCliente.Any())
        {
            int contador = 1;
            foreach (var cliente in listaCliente)
            {
                <tr>
                    <td>@contador</td>
                    <td>@cliente.NomeCliente</td>
                    <td>@cliente.Telefone</td>
                    <td class="opcional">@cliente.CPF</td>
                    <td class="opcional">@cliente.Cidade</td>
                    <td class="col-acoes">
                        <AcoesLinha OnVisualizar="() => visualizando = cliente"
                                    OnEditar="() => Editar(cliente)"
                                    OnExcluir="() => excluindo = cliente" />
                    </td>
                </tr>
                contador++;
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Nenhum cliente encontrado.</td>
            </tr>
        }
    </tbody>
    </table>
</div>

<ConfirmarModal Visivel="@(excluindo != null)" Titulo="Excluir cliente" Erro="@erroExclusao"
                OnConfirmar="ConfirmarExclusao" OnCancelar="CancelarExclusao">
    Tem certeza que deseja excluir <strong>@excluindo?.NomeCliente</strong>?<br />
    <span class="text-muted">Esta ação não pode ser desfeita.</span>
</ConfirmarModal>

<Janela Visivel="@(visualizando != null)" Titulo="@(visualizando?.NomeCliente ?? "Cliente")"
        OnFechar="Fechar">
    <ChildContent>
        @if (visualizando != null)
        {
            <dl class="ficha">
                <div><dt>Telefone</dt><dd>@Valor(visualizando.Telefone)</dd></div>
                <div><dt>CPF</dt><dd>@Valor(visualizando.CPF)</dd></div>
                <div><dt>RG</dt><dd>@Valor(visualizando.RG)</dd></div>
                <div><dt>Nascimento</dt><dd>@Valor(visualizando.DataNascimento?.ToString("dd/MM/yyyy"))</dd></div>
                <div class="largo"><dt>Plano</dt><dd>@Valor(visualizando.NomePlano)</dd></div>
                <div class="largo">
                    <dt>Endereço</dt>
                    <dd>@Valor(string.Join(", ", new[] { visualizando.Rua, visualizando.Numero, visualizando.Bairro, visualizando.Cidade, visualizando.Estado }.Where(p => !string.IsNullOrWhiteSpace(p))))</dd>
                </div>
            </dl>
        }
    </ChildContent>
    <Rodape>
        <button type="button" class="btn btn-outline-secondary" @onclick="Fechar">Fechar</button>
        <button type="button" class="btn btn-primary" @onclick="() => Editar(visualizando!)">Editar</button>
    </Rodape>
</Janela>

<Janela Visivel="@(editando != null)" Titulo="Editar cliente" Largura="640" Erro="@erroModal"
        OnFechar="Fechar">
    <ChildContent>
        @if (editando != null)
        {
            <div class="grade-campos">
                <div class="largo">
                    <label class="form-label">Nome</label>
                    <input class="form-control" @bind="editando.NomeCliente" />
                </div>
                <div>
                    <label class="form-label">Telefone</label>
                    <input class="form-control" @bind="editando.Telefone" />
                </div>
                <div>
                    <label class="form-label">CPF</label>
                    <input class="form-control" @bind="editando.CPF" />
                </div>
                <div>
                    <label class="form-label">RG</label>
                    <input class="form-control" @bind="editando.RG" />
                </div>
                <div>
                    <label class="form-label">Nascimento</label>
                    <input type="date" class="form-control" @bind="editando.DataNascimento" />
                </div>
                <div class="largo">
                    <label class="form-label">Plano</label>
                    <Seletor TItem="OpcaoId" TValor="int" Itens="OpcoesPlano"
                             Valor="editando.IdPlano ?? 0"
                             ValorChanged="v => editando.IdPlano = v == 0 ? null : v"
                             TextoDe="o => o.Rotulo" ValorDe="o => o.Id" Class="mb-3" />
                </div>
                <div>
                    <label class="form-label">Estado</label>
                    <input class="form-control" @bind="editando.Estado" />
                </div>
                <div>
                    <label class="form-label">Cidade</label>
                    <input class="form-control" @bind="editando.Cidade" />
                </div>
                <div>
                    <label class="form-label">Bairro</label>
                    <input class="form-control" @bind="editando.Bairro" />
                </div>
                <div>
                    <label class="form-label">Rua</label>
                    <input class="form-control" @bind="editando.Rua" />
                </div>
                <div>
                    <label class="form-label">Número</label>
                    <input class="form-control" @bind="editando.Numero" />
                </div>
            </div>
        }
    </ChildContent>
    <Rodape>
        <button type="button" class="btn btn-outline-secondary" @onclick="Fechar">Cancelar</button>
        <button type="button" class="btn btn-primary" @onclick="Salvar">Salvar</button>
    </Rodape>
</Janela>

@code {
    private Cliente? excluindo;
    private string? erroExclusao;

    private void ConfirmarExclusao()
    {
        if (excluindo == null) return;

        try
        {
            clienteDAO.Excluir(excluindo.IdCliente);
            excluindo = null;
            erroExclusao = null;
            CarregarClientes();
        }
        catch (Exception ex)
        {
            erroExclusao = ex.Message;
        }
    }

    private void CancelarExclusao()
    {
        excluindo = null;
        erroExclusao = null;
    }

    private List<Cliente> listaCliente = new();
    private List<Plano> planos = new();

    private Cliente? visualizando;
    private Cliente? editando;
    private string? erroModal;

    private List<OpcaoId> OpcoesPlano =>
        new List<OpcaoId> { new(0, "Nenhum") }
            .Concat(planos.Select(p => new OpcaoId(p.IdPlano, p.NomePlano ?? "Sem nome")))
            .ToList();

    protected override void OnInitialized()
    {
        CarregarClientes();
    }

    private void CarregarClientes()
    {
        try
        {
            listaCliente = clienteDAO.ListarTodos();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erro ao carregar clientes: " + ex.Message);
        }
    }

    private static string Valor(string? texto) =>
        string.IsNullOrWhiteSpace(texto) ? "—" : texto;

    /// <summary>Edita uma copia: cancelar o modal nao pode alterar a linha da tabela.</summary>
    private void Editar(Cliente c)
    {
        visualizando = null;
        erroModal = null;

        try { if (planos.Count == 0) planos = planoDAO.ListarTodos(); }
        catch (Exception ex) { erroModal = ex.Message; }

        editando = new Cliente
        {
            IdCliente = c.IdCliente,
            NomeCliente = c.NomeCliente,
            Telefone = c.Telefone,
            CPF = c.CPF,
            DataNascimento = c.DataNascimento,
            RG = c.RG,
            Estado = c.Estado,
            Cidade = c.Cidade,
            Bairro = c.Bairro,
            Rua = c.Rua,
            Numero = c.Numero,
            IdPlano = c.IdPlano
        };
    }

    private void Fechar()
    {
        visualizando = null;
        editando = null;
        erroModal = null;
    }

    private void Salvar()
    {
        if (editando == null) return;

        try
        {
            if (string.IsNullOrWhiteSpace(editando.NomeCliente))
                throw new Exception("O nome é obrigatório.");

            clienteDAO.Atualizar(editando);
            Fechar();
            CarregarClientes();
        }
        catch (Exception ex)
        {
            erroModal = ex.Message;
        }
    }
}
