@page "/comissoes"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Politicas.Comissoes)]

@using LucasAguiar.Models
@using LucasAguiar.Services
@using Microsoft.AspNetCore.WebUtilities
@inject ComissaoDAO comissaoDAO
@inject FuncionarioDAO funcionarioDAO


<h1 class="titulo-listagem">Gestão de Comissões</h1>

<div class="barra-acoes barra-listagem">
    <BotaoExportar Href="@UrlRelatorio" />
    <BotaoExportar Tipo="BotaoExportar.Formato.Excel" Href="@UrlRelatorio.Replace("/relatorio/", "/excel/")" />
</div>

@if (!string.IsNullOrEmpty(erro))
{
    <div class="alert alert-danger">@erro</div>
}

@* ---------- filtros ---------- *@
<section class="filtros">
    <div class="campo">
        <label>De</label>
        <input type="date" class="form-control" @bind="de" />
    </div>
    <div class="campo">
        <label>Até</label>
        <input type="date" class="form-control" @bind="ate" />
    </div>
    <div class="campo">
        <label>Profissional</label>
        <Seletor TItem="OpcaoId" TValor="int" Itens="OpcoesFuncionario"
                 @bind-Valor="idFuncionario" TextoDe="o => o.Rotulo" ValorDe="o => o.Id"
                 ComAvatar="true" />
    </div>
    <div class="campo">
        <label>Tipo</label>
        <Seletor TItem="Opcao" TValor="string" Itens="OpcoesTipo"
                 @bind-Valor="tipo" TextoDe="o => o.Rotulo" ValorDe="o => o.Valor" />
    </div>
    <div class="campo">
        <label>Situação</label>
        <Seletor TItem="Opcao" TValor="string" Itens="OpcoesSituacao"
                 @bind-Valor="situacao" TextoDe="o => o.Rotulo" ValorDe="o => o.Valor"
                 PontoDe="o => o.Cor" />
    </div>
    <div class="campo-acoes">
        <button type="button" class="btn btn-primary" @onclick="Aplicar">Filtrar</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="Limpar">Limpar</button>
    </div>
</section>

<div class="atalhos-periodo">
    <button type="button" class="@(atalho == 0 ? "ativo" : "")" @onclick="() => Mes(0)">Este mês</button>
    <button type="button" class="@(atalho == -1 ? "ativo" : "")" @onclick="() => Mes(-1)">Mês anterior</button>
    <span class="periodo-texto">@de.ToString("dd/MM/yyyy") a @ate.ToString("dd/MM/yyyy")</span>
</div>

@* ---------- resumo ---------- *@
<div class="resumo">
    <div class="cartao-resumo comissao">
        <span class="rotulo">Total</span>
        <strong class="valor">@Filtradas.Sum(l => l.Comissao).ToString("C")</strong>
    </div>
    <div class="cartao-resumo">
        <span class="rotulo">De serviços</span>
        <strong class="valor">@Filtradas.Where(l => !l.EProduto).Sum(l => l.Comissao).ToString("C")</strong>
    </div>
    <div class="cartao-resumo">
        <span class="rotulo">De produtos</span>
        <strong class="valor">@Filtradas.Where(l => l.EProduto).Sum(l => l.Comissao).ToString("C")</strong>
    </div>
    <div class="cartao-resumo pendente">
        <span class="rotulo">Pendente</span>
        <strong class="valor">@Filtradas.Where(l => !l.Paga).Sum(l => l.Comissao).ToString("C")</strong>
    </div>
</div>

<p class="nota-topo">
    Esta tela é um relatório. O pagamento acontece na
    <a href="/folha" class="link-texto">Folha de Pagamento</a>, onde a comissão é somada ao salário fixo.
    A comissão conta como paga quando a folha do profissional naquele mês já foi liquidada.
</p>

<div class="tabela">
<table class="table table-striped">
    <thead>
        <tr>
            <th>Data</th>
            <th>Venda</th>
            <th>Cliente</th>
            <th>Item</th>
            <th>Profissional</th>
            <th class="dir">Valor base</th>
            <th class="dir">%</th>
            <th class="dir">Comissão</th>
        </tr>
    </thead>
    <tbody>
        @if (Filtradas.Count > 0)
        {
            @foreach (var l in Filtradas)
            {
                <tr>
                    <td class="suave">@l.DataVenda.ToString("dd/MM/yyyy")</td>
                    <td>#@l.IdVenda</td>
                    <td>@(l.NomeCliente ?? "—")</td>
                    <td>
                        @l.Descricao
                        @if (l.Quantidade > 1)
                        {
                            <span class="suave"> ×@l.Quantidade</span>
                        }
                        @if (l.CobertoPlano)
                        {
                            <span class="etiqueta-plano">plano</span>
                        }
                    </td>
                    <td>@l.NomeFuncionario</td>
                    <td class="dir">@l.ValorItem.ToString("C")</td>
                    <td class="dir suave">@(l.Percentual?.ToString("P1") ?? "—")</td>
                    <td class="dir destaque">
                        <span class="status @(l.Paga ? "pago" : "pendente")" title="@(l.Paga ? "Paga" : "Pendente")">
                            <i></i>@l.Comissao.ToString("C")
                        </span>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center text-muted">
                    Nenhuma comissão gerada neste período.
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    private List<ComissaoDAO.LinhaComissao> linhas = new();
    private List<OpcaoId> OpcoesFuncionario = new() { new(0, "Todos") };

    private string? erro;

    private DateTime de;
    private DateTime ate;
    private int idFuncionario;
    private string tipo = "";
    private string situacao = "";

    /// <summary>0 = este mês, -1 = mês anterior, nulo = datas digitadas.</summary>
    private int? atalho;

    private static readonly List<Opcao> OpcoesTipo = new()
    {
        new("", "Todos"),
        new(TipoItem.Servico, "Serviço"),
        new(TipoItem.Produto, "Produto")
    };

    private static readonly List<Opcao> OpcoesSituacao = new()
    {
        new("", "Todas"),
        new("PENDENTE", "Pendente", "var(--alerta)"),
        new("PAGA", "Paga", "var(--ok)")
    };

    private List<ComissaoDAO.LinhaComissao> Filtradas =>
        linhas
            .Where(l => tipo == ""
                        || (tipo == TipoItem.Produto ? l.EProduto : !l.EProduto))
            .Where(l => situacao == "" || (situacao == "PAGA" ? l.Paga : !l.Paga))
            .ToList();

    private string UrlRelatorio =>
        QueryHelpers.AddQueryString("/relatorio/comissoes", new Dictionary<string, string?>
        {
            ["de"] = de.ToString("yyyy-MM-dd"),
            ["ate"] = ate.ToString("yyyy-MM-dd")
        });

    protected override void OnInitialized()
    {
        try
        {
            OpcoesFuncionario.AddRange(funcionarioDAO.ListarTodos()
                .Select(f => new OpcaoId(f.IdFuncionario, f.NomeFuncionario ?? "Sem nome")));
        }
        catch (Exception ex)
        {
            erro = "Erro ao carregar os profissionais: " + ex.Message;
        }

        Mes(0);
    }

    private void Mes(int deslocamento)
    {
        var inicio = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(deslocamento);
        de = inicio;
        ate = deslocamento == 0 ? DateTime.Today : inicio.AddMonths(1).AddDays(-1);
        atalho = deslocamento;
        Carregar();
    }

    private void Aplicar()
    {
        atalho = null;
        Carregar();
    }

    private void Limpar()
    {
        idFuncionario = 0;
        tipo = "";
        situacao = "";
        Mes(0);
    }

    private void Carregar()
    {
        try
        {
            erro = null;
            // 'ate' e exclusivo no SQL: soma um dia para incluir o dia escolhido.
            linhas = comissaoDAO.ListarItens(de, ate.AddDays(1),
                idFuncionario > 0 ? idFuncionario : null);
        }
        catch (Exception ex)
        {
            erro = "Erro ao carregar as comissões: " + ex.Message;
            linhas = new();
        }
    }
}
