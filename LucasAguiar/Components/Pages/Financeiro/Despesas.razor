@page "/despesas"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Politicas.Despesas)]

@using LucasAguiar.Models
@using Microsoft.AspNetCore.WebUtilities
@inject DespesaDAO despesaDAO
@inject FornecedorDAO fornecedorDAO
@inject CaixaDAO caixaDAO


<h1>Despesas</h1>

@if (!string.IsNullOrEmpty(erro))
{
    <div class="alert alert-danger">@erro</div>
}
@if (!string.IsNullOrEmpty(aviso))
{
    <div class="alert alert-success">@aviso</div>
}

@* ---------- lançamento ---------- *@
<section class="cartao lancamento">
    <h2>Lançar despesa</h2>

    <div class="grade">
        <div class="campo campo-largo">
            <label>Descrição <span class="obrigatorio">*</span></label>
            <input class="form-control" placeholder="Ex.: Compra de toalhas"
                   @bind="nova.Descricao" @bind:event="oninput" />
        </div>

        <div class="campo">
            <label>Valor <span class="obrigatorio">*</span></label>
            <input type="number" step="0.01" min="0" class="form-control" @bind="nova.Valor" />
        </div>

        <div class="campo">
            <label>Data</label>
            <input type="date" class="form-control" @bind="nova.DataDespesa" />
        </div>

        <div class="campo">
            <label>Categoria</label>
            <Seletor TItem="Opcao" TValor="string" Itens="OpcoesCategoria"
                     @bind-Valor="nova.Categoria" TextoDe="o => o.Rotulo" ValorDe="o => o.Valor" />
        </div>

        <div class="campo">
            <label>Forma de pagamento</label>
            <Seletor TItem="Opcao" TValor="string" Itens="OpcoesForma"
                     @bind-Valor="nova.FormaPagamentoDespesa" TextoDe="o => o.Rotulo"
                     ValorDe="o => o.Valor" PontoDe="o => o.Cor" />
        </div>

        <div class="campo">
            <label>Fornecedor</label>
            <Seletor TItem="OpcaoId" TValor="int" Itens="OpcoesFornecedor"
                     @bind-Valor="idFornecedor" TextoDe="o => o.Rotulo" ValorDe="o => o.Id" />
        </div>
    </div>

    <div class="linha-criar">
        <button type="button" class="btn-criar" @onclick="() => modalAberto = true">
            + Cadastrar novo fornecedor aqui
        </button>

        <label class="marcador">
            <input type="checkbox" @bind="nova.Pago" />
            Já foi paga
        </label>
    </div>

    @if (nova.AfetaGaveta && caixaAberto != null)
    {
        <p class="aviso-caixa">
            Esta despesa sai da gaveta do caixa #@caixaAberto.IdCaixa e entra no fechamento.
        </p>
    }
    else if (nova.AfetaGaveta && caixaAberto == null)
    {
        <p class="aviso-caixa alerta">
            Não há caixa aberto. A despesa será registrada, mas não entrará em nenhum fechamento.
            <a href="/caixa">Abrir caixa</a>.
        </p>
    }

    <button type="button" class="btn btn-primary mt-3" @onclick="Salvar">Lançar despesa</button>
</section>

@* ---------- filtros ---------- *@
<section class="filtros">
    <div class="campo">
        <label>Vencimento de</label>
        <input type="date" class="form-control" @bind="de" />
    </div>
    <div class="campo">
        <label>Até</label>
        <input type="date" class="form-control" @bind="ate" />
    </div>
    <div class="campo campo-largo">
        <label>Descrição</label>
        <input class="form-control" placeholder="Buscar despesa" @bind="filtroDescricao" />
    </div>
    <div class="campo">
        <label>Fornecedor</label>
        <Seletor TItem="OpcaoId" TValor="int" Itens="OpcoesFornecedorFiltro"
                 @bind-Valor="filtroFornecedor" TextoDe="o => o.Rotulo" ValorDe="o => o.Id" />
    </div>
    <div class="campo">
        <label>Situação</label>
        <Seletor TItem="Opcao" TValor="string" Itens="OpcoesSituacao"
                 @bind-Valor="filtroSituacao" TextoDe="o => o.Rotulo" ValorDe="o => o.Valor"
                 PontoDe="o => o.Cor" />
    </div>
    <div class="campo">
        <label>Categoria</label>
        <Seletor TItem="Opcao" TValor="string" Itens="OpcoesCategoriaFiltro"
                 @bind-Valor="filtroCategoria" TextoDe="o => o.Rotulo" ValorDe="o => o.Valor" />
    </div>
    <div class="campo">
        <label>Pagamento</label>
        <Seletor TItem="Opcao" TValor="string" Itens="OpcoesFormaFiltro"
                 @bind-Valor="filtroForma" TextoDe="o => o.Rotulo" ValorDe="o => o.Valor"
                 PontoDe="o => o.Cor" />
    </div>
    <div class="campo-acoes">
        <button type="button" class="btn btn-primary" @onclick="Carregar">Filtrar</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="Limpar">Limpar</button>
        <a href="@UrlRelatorio" class="btn-pdf" data-enhance-nav="false">Relatório PDF</a>
    <a href="@UrlRelatorio.Replace("/relatorio/", "/excel/")" class="btn-pdf" data-enhance-nav="false">Excel</a>
    </div>
</section>

<div class="atalhos-periodo">
    <button type="button" @onclick="AtalhoVencidas">Vencidas</button>
    <button type="button" @onclick="() => AtalhoAPagar(0)">Vence hoje</button>
    <button type="button" @onclick="() => AtalhoAPagar(7)">Próximos 7 dias</button>
    <button type="button" @onclick="PeriodoMes">Este mês</button>
</div>

@* ---------- resumo ---------- *@
<div class="resumo">
    <div class="cartao-resumo">
        <span class="rotulo">A pagar</span>
        <strong class="valor">@Filtradas.Where(d => !d.Pago).Sum(d => d.Valor).ToString("C")</strong>
    </div>
    <div class="cartao-resumo prejuizo">
        <span class="rotulo">Vencido</span>
        <strong class="valor">@Filtradas.Where(d => Vencida(d)).Sum(d => d.Valor).ToString("C")</strong>
    </div>
    <div class="cartao-resumo">
        <span class="rotulo">Pago no período</span>
        <strong class="valor">@Filtradas.Where(d => d.Pago).Sum(d => d.Valor).ToString("C")</strong>
    </div>
    <div class="cartao-resumo total">
        <span class="rotulo">Total</span>
        <strong class="valor">@Filtradas.Sum(d => d.Valor).ToString("C")</strong>
    </div>
</div>

<div class="tabela">
<table class="table table-striped">
    <thead>
        <tr>
            <th>Vencimento</th>
            <th>Descrição</th>
            <th>Categoria</th>
            <th>Favorecido</th>
            <th>Pagamento</th>
            <th class="dir">Valor</th>
            <th>Situação</th>
            <th class="col-acao">Ações</th>
        </tr>
    </thead>
    <tbody>
        @if (Filtradas.Count > 0)
        {
            @foreach (var d in Filtradas)
            {
                <tr>
                    <td>@d.DataDespesa.ToString("dd/MM/yyyy")</td>
                    <td>@d.Descricao</td>
                    <td>@d.RotuloCategoria</td>
                    <td>@(string.IsNullOrWhiteSpace(d.NomeFornecedor) ? "—" : d.NomeFornecedor)</td>
                    <td>@FormaPagamento.Rotulo(d.FormaPagamentoDespesa)</td>
                    <td class="dir">@d.Valor.ToString("C")</td>
                    <td>
                        <span class="status @ClasseSituacao(d)"><i></i>@RotuloSituacao(d)</span>
                    </td>
                    <td class="col-acao">
                        <AcoesLinha OnVisualizar="() => visualizando = d"
                                    OnEditar="() => Editar(d)"
                                    OnExcluir="() => excluindo = d" />
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center text-muted">Nenhuma despesa encontrada.</td>
            </tr>
        }
    </tbody>
</table>
</div>

<ConfirmarModal Visivel="@(excluindo != null)" Titulo="Excluir despesa" Erro="@erroExclusao"
                OnConfirmar="ConfirmarExclusao" OnCancelar="CancelarExclusao">
    Tem certeza que deseja excluir <strong>@excluindo?.Descricao</strong> (@excluindo?.Valor.ToString("C"))?<br />
    <span class="text-muted">Esta ação não pode ser desfeita.</span>
</ConfirmarModal>

<Janela Visivel="@(visualizando != null)" Titulo="@(visualizando?.Descricao ?? "Despesa")" OnFechar="FecharJanelas">
    <ChildContent>
        @if (visualizando != null)
        {
            <dl class="ficha">
                <div><dt>Data</dt><dd>@visualizando.DataDespesa.ToString("dd/MM/yyyy")</dd></div>
                <div><dt>Valor</dt><dd>@visualizando.Valor.ToString("C")</dd></div>
                <div><dt>Categoria</dt><dd>@visualizando.RotuloCategoria</dd></div>
                <div><dt>Pagamento</dt><dd>@FormaPagamento.Rotulo(visualizando.FormaPagamentoDespesa)@(visualizando.Pago ? "" : " (em aberto)")</dd></div>
                <div><dt>Fornecedor</dt><dd>@(visualizando.NomeFornecedor ?? "—")</dd></div>
                <div><dt>Caixa</dt><dd>@(visualizando.IdCaixa.HasValue ? $"#{visualizando.IdCaixa}" : "—")</dd></div>
                <div class="largo"><dt>Observação</dt><dd>@(string.IsNullOrWhiteSpace(visualizando.Observacao) ? "—" : visualizando.Observacao)</dd></div>
            </dl>
        }
    </ChildContent>
    <Rodape>
        <button type="button" class="btn btn-outline-secondary" @onclick="FecharJanelas">Fechar</button>
        <button type="button" class="btn btn-primary" @onclick="() => Editar(visualizando!)">Editar</button>
    </Rodape>
</Janela>

<Janela Visivel="@(editando != null)" Titulo="Editar despesa" Erro="@erroEdicao" OnFechar="FecharJanelas">
    <ChildContent>
        @if (editando != null)
        {
            <div class="grade-campos">
                <div>
                    <label class="form-label">Data</label>
                    <input type="date" class="form-control" @bind="editando.DataDespesa" />
                </div>
                <div>
                    <label class="form-label">Categoria</label>
                    <Seletor TItem="Opcao" TValor="string" Itens="OpcoesCategoria"
                             @bind-Valor="editando.Categoria" TextoDe="o => o.Rotulo" ValorDe="o => o.Valor" Class="mb-3" />
                </div>
                <div class="largo">
                    <label class="form-label">Descrição</label>
                    <input class="form-control" @bind="editando.Descricao" />
                </div>
                <div class="largo">
                    <label class="form-label">Fornecedor</label>
                    <Seletor TItem="OpcaoId" TValor="int" Itens="OpcoesFornecedor"
                             Valor="editando.IdFornecedor ?? 0"
                             ValorChanged="v => editando.IdFornecedor = v == 0 ? null : v"
                             TextoDe="o => o.Rotulo" ValorDe="o => o.Id" Placeholder="Nenhum" Class="mb-3" />
                </div>
                <div class="largo">
                    <label class="form-label">Observação</label>
                    <input class="form-control" @bind="editando.Observacao" />
                </div>
            </div>
            <p class="text-muted mb-0" style="font-size: 13px;">
                Valor e forma de pagamento já entram no caixa: para mudá-los, exclua e lance de novo.
            </p>
        }
    </ChildContent>
    <Rodape>
        <button type="button" class="btn btn-outline-secondary" @onclick="FecharJanelas">Cancelar</button>
        <button type="button" class="btn btn-primary" @onclick="SalvarEdicao">Salvar</button>
    </Rodape>
</Janela>

<CadastroRapido Visivel="modalAberto"
                Tipo="CadastroRapido.TipoCadastro.Fornecedor"
                OnCriado="AoCriarFornecedor"
                OnCancelado="() => modalAberto = false" />

@code {
    private Despesa nova = new();
    private List<Despesa> despesas = new();
    private List<Fornecedor> fornecedores = new();

    // Opcoes dos seletores. O "Todas"/"Nenhum" entra como item da lista,
    // porque o Seletor nao tem <option> solta como o select nativo.
    private List<Opcao> OpcoesCategoria =>
        CategoriaDespesa.Todas.Select(c => new Opcao(c.Valor, c.Rotulo)).ToList();

    private List<Opcao> OpcoesCategoriaFiltro =>
        new List<Opcao> { new("", "Todas") }.Concat(OpcoesCategoria).ToList();

    private List<Opcao> OpcoesForma =>
        FormaPagamento.Todas.Select(f => new Opcao(f.Valor, f.Rotulo, "var(--ok)")).ToList();

    private List<Opcao> OpcoesFormaFiltro =>
        new List<Opcao> { new("", "Todos") }.Concat(OpcoesForma).ToList();

    private List<OpcaoId> OpcoesFornecedor =>
        new List<OpcaoId> { new(0, "Nenhum") }
            .Concat(fornecedores.Select(f => new OpcaoId(f.IdFornecedor, f.NomeFornecedor ?? "Sem nome")))
            .ToList();
    private Caixa? caixaAberto;

    private int idFornecedor;
    private bool modalAberto;
    private string? erro;
    private string? aviso;

    private Despesa? excluindo;
    private string? erroExclusao;

    private void ConfirmarExclusao()
    {
        if (excluindo == null) return;

        var id = excluindo.IdDespesa;
        excluindo = null;
        Excluir(id); // o proprio Excluir mostra o erro, se houver
    }

    private void CancelarExclusao()
    {
        excluindo = null;
        erroExclusao = null;
    }

    private Despesa? visualizando;
    private Despesa? editando;
    private string? erroEdicao;

    private DateTime? de;
    private DateTime? ate;
    private string filtroCategoria = "";
    private string filtroForma = "";

    // Filtros aplicados em memoria sobre o que o DAO devolveu.
    private string filtroDescricao = "";
    private int filtroFornecedor;
    private string filtroSituacao = "";

    private const string SituacaoPaga = "PAGA";
    private const string SituacaoAberta = "ABERTA";
    private const string SituacaoVencida = "VENCIDA";

    /// <summary>
    /// Sem data de vencimento propria, a data da despesa faz as vezes dela:
    /// em aberto com data passada e vencida.
    /// </summary>
    private static bool Vencida(Despesa d) => !d.Pago && d.DataDespesa.Date < DateTime.Today;

    private static string Situacao(Despesa d) =>
        d.Pago ? SituacaoPaga : Vencida(d) ? SituacaoVencida : SituacaoAberta;

    private static string RotuloSituacao(Despesa d) => Situacao(d) switch
    {
        SituacaoPaga => "Paga",
        SituacaoVencida => "Vencida",
        _ => "Em aberto"
    };

    private static string ClasseSituacao(Despesa d) => Situacao(d) switch
    {
        SituacaoPaga => "pago",
        SituacaoVencida => "erro",
        _ => "pendente"
    };

    private List<Despesa> Filtradas =>
        despesas
            .Where(d => string.IsNullOrWhiteSpace(filtroDescricao)
                        || d.Descricao.Contains(filtroDescricao.Trim(), StringComparison.OrdinalIgnoreCase))
            .Where(d => filtroFornecedor == 0 || d.IdFornecedor == filtroFornecedor)
            .Where(d => filtroSituacao == ""
                        // "Em aberto" inclui as vencidas: as duas estao por pagar.
                        || (filtroSituacao == SituacaoAberta ? !d.Pago : Situacao(d) == filtroSituacao))
            .ToList();

    private List<OpcaoId> OpcoesFornecedorFiltro =>
        new List<OpcaoId> { new(0, "Todos") }
            .Concat(fornecedores.Select(f => new OpcaoId(f.IdFornecedor, f.NomeFornecedor ?? "Sem nome")))
            .ToList();

    private static readonly List<Opcao> OpcoesSituacao = new()
    {
        new("", "Todas"),
        new(SituacaoAberta, "Em aberto", "var(--alerta)"),
        new(SituacaoVencida, "Vencida", "var(--perigo)"),
        new(SituacaoPaga, "Paga", "var(--ok)")
    };

    private string UrlRelatorio
    {
        get
        {
            var p = new Dictionary<string, string?>();
            if (de.HasValue) p["de"] = de.Value.ToString("yyyy-MM-dd");
            if (ate.HasValue) p["ate"] = ate.Value.ToString("yyyy-MM-dd");
            if (!string.IsNullOrWhiteSpace(filtroCategoria)) p["categoria"] = filtroCategoria;
            if (!string.IsNullOrWhiteSpace(filtroForma)) p["forma"] = filtroForma;
            return QueryHelpers.AddQueryString("/relatorio/despesas", p);
        }
    }

    protected override void OnInitialized()
    {
        try
        {
            fornecedores = fornecedorDAO.ListarTodos() ?? new();
            caixaAberto = caixaDAO.BuscarAberto();
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }

        Carregar();
    }

    private void Carregar()
    {
        try
        {
            erro = null;
            despesas = despesaDAO.Listar(new DespesaDAO.Filtro
            {
                De = de,
                Ate = ate?.AddDays(1),
                Categoria = string.IsNullOrWhiteSpace(filtroCategoria) ? null : filtroCategoria,
                FormaPagamento = string.IsNullOrWhiteSpace(filtroForma) ? null : filtroForma
            });
        }
        catch (Exception ex)
        {
            erro = "Erro ao carregar as despesas: " + ex.Message;
            despesas = new();
        }
    }

    private void Salvar()
    {
        try
        {
            erro = null;
            aviso = null;

            nova.IdFornecedor = idFornecedor > 0 ? idFornecedor : null;

            // Só amarra ao caixa se o dinheiro realmente sair da gaveta.
            nova.IdCaixa = nova.AfetaGaveta ? caixaAberto?.IdCaixa : null;

            despesaDAO.Inserir(nova);
            aviso = $"Despesa de {nova.Valor:C} lançada.";

            nova = new Despesa { Categoria = nova.Categoria };
            idFornecedor = 0;

            caixaAberto = caixaDAO.BuscarAberto();
            Carregar();
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }

    private void Excluir(int id)
    {
        try
        {
            erro = null;
            despesaDAO.Excluir(id);
            aviso = "Despesa excluída.";
            Carregar();
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }

    private void AoCriarFornecedor(int id)
    {
        try
        {
            fornecedores = fornecedorDAO.ListarTodos() ?? new();
            idFornecedor = id;
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
        finally
        {
            modalAberto = false;
        }
    }

    /// <summary>Edita uma copia: cancelar o modal nao pode alterar a linha da tabela.</summary>
    private void Editar(Despesa d)
    {
        visualizando = null;
        erroEdicao = null;
        editando = new Despesa
        {
            IdDespesa = d.IdDespesa,
            DataDespesa = d.DataDespesa,
            Descricao = d.Descricao,
            Categoria = d.Categoria,
            IdFornecedor = d.IdFornecedor,
            Observacao = d.Observacao
        };
    }

    private void FecharJanelas()
    {
        visualizando = null;
        editando = null;
        erroEdicao = null;
    }

    private void SalvarEdicao()
    {
        if (editando == null) return;

        try
        {
            despesaDAO.AtualizarDados(editando);
            FecharJanelas();
            Carregar();
        }
        catch (Exception ex)
        {
            erroEdicao = ex.Message;
        }
    }

    private void Limpar()
    {
        de = ate = null;
        filtroCategoria = "";
        filtroForma = "";
        filtroDescricao = "";
        filtroFornecedor = 0;
        filtroSituacao = "";
        Carregar();
    }

    private void AtalhoVencidas()
    {
        de = null;
        ate = DateTime.Today.AddDays(-1);
        filtroSituacao = SituacaoVencida;
        Carregar();
    }

    /// <summary>Em aberto com vencimento de hoje ate daqui a 'dias'.</summary>
    private void AtalhoAPagar(int dias)
    {
        de = DateTime.Today;
        ate = DateTime.Today.AddDays(dias);
        filtroSituacao = SituacaoAberta;
        Carregar();
    }

    private void PeriodoMes()
    {
        var hoje = DateTime.Today;
        de = new DateTime(hoje.Year, hoje.Month, 1);
        ate = de.Value.AddMonths(1).AddDays(-1);
        filtroSituacao = "";
        Carregar();
    }
}
