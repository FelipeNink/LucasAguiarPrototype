@* Botao de exportacao do topo das listagens: icone do formato e
   "Exportar PDF" / "Exportar Excel". Link comum, sem navegacao do
   Blazor, para o navegador baixar o arquivo. *@

<a href="@Href" class="btn-pdf btn-exportar" data-enhance-nav="false">
    @if (Tipo == Formato.Excel)
    {
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <path d="M14 2v6h6" />
            <path d="M9.5 12.5l5 5M14.5 12.5l-5 5" />
        </svg>
        <span>Exportar Excel</span>
    }
    else
    {
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <path d="M14 2v6h6" />
            <path d="M9 18c1.5-2.5 3-5 3-7 0-1-1-1-1 0 0 2.5 2.5 5 5 6 1 .4 1-1 0-1-2.5 0-5.5 1-7 2z" />
        </svg>
        <span>Exportar PDF</span>
    }
</a>

@code {
    public enum Formato { Pdf, Excel }

    [Parameter, EditorRequired] public string Href { get; set; } = "";

    [Parameter] public Formato Tipo { get; set; } = Formato.Pdf;
}
