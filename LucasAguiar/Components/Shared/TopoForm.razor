@* Voltar acima do titulo, igual em toda tela de cadastro e edicao. *@

<div class="topo-form">
    <a href="@Voltar" class="voltar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 18-6-6 6-6" />
        </svg>
        @RotuloVoltar
    </a>
    <h1>@Titulo</h1>
</div>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";

    /// <summary>Endereco da listagem de onde a tela veio.</summary>
    [Parameter, EditorRequired] public string Voltar { get; set; } = "/";

    /// <summary>Nome da listagem ("Clientes"), mostrado no link.</summary>
    [Parameter, EditorRequired] public string RotuloVoltar { get; set; } = "";
}
