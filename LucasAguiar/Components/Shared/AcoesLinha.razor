@*
    Visualizar, editar e excluir de uma linha de listagem, so em icone.
    Acoes proprias da tela (componentes do plano, gerar venda) entram
    pelo ChildContent, antes do excluir, que fica sempre por ultimo.
*@

<span class="acoes">
    <button type="button" class="btn-acao" title="Visualizar" aria-label="Visualizar"
            @onclick="OnVisualizar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
        </svg>
    </button>

    <button type="button" class="btn-acao" title="Editar" aria-label="Editar"
            @onclick="OnEditar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />
        </svg>
    </button>

    @ChildContent

    @if (OnExcluir.HasDelegate)
    {
        <button type="button" class="btn-acao perigo" title="@RotuloExcluir" aria-label="@RotuloExcluir"
                @onclick="OnExcluir">
            @Lixeira
        </button>
    }
    else
    {
        <a href="@HrefExcluir" class="btn-acao perigo" title="Excluir" aria-label="Excluir">
            @Lixeira
        </a>
    }
</span>

@code {
    [Parameter] public EventCallback OnVisualizar { get; set; }
    [Parameter] public EventCallback OnEditar { get; set; }
    /// <summary>Excluir em pagina propria. Sem isso, usa o OnExcluir.</summary>
    [Parameter] public string HrefExcluir { get; set; } = "";
    [Parameter] public EventCallback OnExcluir { get; set; }
    [Parameter] public string RotuloExcluir { get; set; } = "Excluir";

    private static readonly RenderFragment Lixeira = @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6M10 11v6M14 11v6" />
    </svg>;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
