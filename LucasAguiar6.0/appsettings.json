  // Para rodar o projeto, crie o appsettings.Development.json (que o
  // .gitignore cobre) copiando o appsettings.Development.example.json
  // e preenchendo com os seus dados. Sem ele a aplicacao sobe, mas
  // falha ao consultar o banco.
  "ConnectionStrings": {
    "MySqlConnection": ""
  }
}
