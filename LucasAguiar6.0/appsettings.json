{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // A string de conexao fica vazia aqui de proposito: ela leva usuario e
  // senha do banco, e este arquivo vai para o repositorio.
